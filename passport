<main id="main" class="pass-page ref-page">
<div class="pass-wrap">
<nav class="ref-crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">My Passport</li></ol></nav>
<header class="ref-head">
  <span class="hero-ornament"></span>
  <h1 class="research-title">My Passport</h1>
  <p class="ref-lede">A record of your travels through the past: every page you read, every century you visit and every game you play adds to it. It is kept in this browser and nowhere else, with no account, and only you can see it.</p>
</header>

<section class="pass-summary" id="pass-summary" aria-label="In numbers"><noscript><p class="pass-note">The passport needs JavaScript.</p></noscript></section>

<section aria-labelledby="pass-stamps-t">
  <h2 class="ref-sec-title" id="pass-stamps-t">Stamps <span class="n" id="pass-stamps-n"></span></h2>
  <ul class="pass-stamps" id="pass-stamps"></ul>
</section>

<section aria-labelledby="pass-kinds-t">
  <h2 class="ref-sec-title" id="pass-kinds-t">What you have read</h2>
  <div class="pass-cols">
    <div><h3 class="pass-h3">By kind of page</h3><ul class="pass-bars" id="pass-kinds"></ul></div>
    <div><h3 class="pass-h3">Profiles by region</h3><ul class="pass-bars" id="pass-regions"></ul></div>
  </div>
</section>

<section class="pass-tl-sec" id="pass-tl-sec" aria-labelledby="pass-tl-t">
  <h2 class="ref-sec-title" id="pass-tl-t">My timeline <span class="n" id="pass-tl-n"></span></h2>
  <p class="pass-tl-lede" id="pass-tl-lede">Everything you have read, placed in time: profiles, entries, states, centuries, years and speeches, each where it belongs.</p>
  <ul class="pass-tl-key" id="pass-tl-key"></ul>
  <figure class="pass-tl"><svg id="pass-tl-svg" role="img" aria-label="Your reading on one line of years"></svg><div class="pass-tl-tip" id="pass-tl-tip" role="status" hidden></div></figure>
  <p class="pass-note" id="pass-tl-note"></p>
  <details class="pass-tl-list" id="pass-tl-list" hidden><summary>Show them as a list</summary><ol id="pass-tl-ol"></ol></details>
  <div class="pass-acts"><button type="button" class="gm-share" id="pass-tl-share" hidden>Share my timeline</button></div>
</section>

<section aria-labelledby="pass-cent-t">
  <h2 class="ref-sec-title" id="pass-cent-t">Centuries visited <span class="n" id="pass-cent-n"></span></h2>
  <ol class="pass-cents" id="pass-cents"></ol>
</section>

<section aria-labelledby="pass-play-t">
  <h2 class="ref-sec-title" id="pass-play-t">Paths, quizzes and games</h2>
  <ul class="pass-play" id="pass-play"></ul>
</section>

<section aria-labelledby="pass-recent-t" id="pass-recent-wrap" hidden>
  <h2 class="ref-sec-title" id="pass-recent-t">Lately</h2>
  <ul class="ref-cent-list" id="pass-recent"></ul>
</section>

<section class="pass-keep" aria-labelledby="pass-keep-t">
  <h2 class="ref-sec-title" id="pass-keep-t">Share, keep or start again</h2>
  <div class="pass-acts"><button type="button" class="gm-share" id="pass-share">Share my passport</button><button type="button" class="gm-again" id="pass-export">Make a backup code</button><button type="button" class="gm-again" id="pass-clear">Clear my passport</button></div>
  <div class="pass-code" id="pass-code-box" hidden>
    <label for="pass-code">Your backup code: keep it, or paste it into this page in another browser to carry your passport there.</label>
    <textarea id="pass-code" rows="4" readonly></textarea>
    <button type="button" class="gm-again" id="pass-copy">Copy the code</button>
  </div>
  <details class="pass-restore"><summary>Restore from a backup code</summary>
    <label for="pass-in">Paste a backup code. What it holds is added to what is here; nothing here is lost.</label>
    <textarea id="pass-in" rows="4"></textarea>
    <button type="button" class="gm-again" id="pass-restore">Restore</button>
  </details>
  <p class="pass-note" id="pass-msg" role="status" aria-live="polite"></p>
  <p class="pass-note">Opened the site inside Instagram, Facebook or another app? That browser keeps its own passport: make a backup code there and restore it in your usual browser.</p>
</section>
