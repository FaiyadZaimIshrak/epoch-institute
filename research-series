};

function openSeriesDetail(id) {
  var s = SERIES_DATA[id];
  if (!s) return;
  document.getElementById('series-detail-number').textContent   = s.number;
  document.getElementById('series-detail-title').textContent    = s.title;
  document.getElementById('series-detail-subtitle').textContent = s.subtitle;
  var existingHero = document.getElementById('series-detail-hero-wrap');
  if (existingHero) existingHero.remove();
  if (s.thumbnail) {
    var hw = document.createElement('div');
    hw.id = 'series-detail-hero-wrap';
    var heroImg = document.createElement('img');
    heroImg.className = 'series-detail-hero';
    heroImg.src = s.thumbnail;
    heroImg.alt = s.title + ' cover';
    hw.appendChild(heroImg);
    var bodyEl = document.getElementById('series-detail-body');
    bodyEl.parentNode.insertBefore(hw, bodyEl);
  }
  document.getElementById('series-detail-body').innerHTML = s.rawHtml
    ? s.body.join('')
    : s.body.map(function(p) { return '<p>' + escHtml(p) + '</p>'; }).join('');
  document.getElementById('research-series').style.display = 'none';
  var detailEl = document.getElementById('series-detail');
  detailEl.style.display = 'block';
  var shareUrl = 'https://the-epoch-institute.org/research-series';
  var rawDesc = s.description || '';
  var firstSent = rawDesc.replace(/^([^.!?]*[.!?])[\s\S]*$/, '$1').trim();
  var tweetBase = '"' + s.title + '" — ' + (firstSent || rawDesc) + '\n\n#History #EpochInstitute';
  var tweetText = tweetBase.length <= 240 ? tweetBase
    : '"' + s.title + '" — ' + (firstSent || rawDesc).substring(0, Math.max(10, 240 - ('"' + s.title + '" — \n\n#History #EpochInstitute').length)) + '…\n\n#History #EpochInstitute';
  // Inject share button in header
  var existingShare = detailEl.querySelector('.series-share-wrap');
  if (existingShare) existingShare.remove();
  if (!s.rawHtml === false || s.rawHtml) {
    var wrap = document.createElement('div');
    wrap.className = 'series-share-wrap';
    wrap.style.cssText = 'position:relative; display:inline-block; margin-top:16px;';
    wrap.innerHTML = buildShareButton('series-share-dd', shareUrl, tweetText);
    document.querySelector('.series-detail-header').appendChild(wrap);
    attachShareListeners(wrap, shareUrl);
  }
  // Inject end-of-article share dropdown
  var existingEndShare = document.getElementById('series-end-share');
  if (existingEndShare) existingEndShare.remove();
  var endShare = document.createElement('div');
  endShare.id = 'series-end-share';
  endShare.className = 'series-end-share';
  endShare.innerHTML = buildShareButton('series-end-share-dd', shareUrl, tweetText, s.title);
  var triggerBtn = endShare.querySelector('.tih-share-btn');
  if (triggerBtn) triggerBtn.innerHTML = 'Share';
  document.getElementById('series-detail-body').appendChild(endShare);
  attachShareListeners(endShare, shareUrl);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

document.getElementById('series-detail-back').addEventListener('click', function() {
  document.getElementById('series-detail').style.display   = 'none';
  document.getElementById('research-series').style.display = '';
  window.scrollTo({ top: 0, behavior: 'smooth' });
});

function copySeriesLink(btn) {
  navigator.clipboard.writeText('https://the-epoch-institute.org/research-series').then(function() {
    var orig = btn.textContent;
    btn.textContent = 'Copied ✓';
    btn.style.color = 'var(--gold)';
    setTimeout(function() { btn.textContent = orig; btn.style.color = ''; }, 1800);
  });
}

function seriesNotify(e, seriesName) {
  e.preventDefault();
  var email = e.target.querySelector('input[type="email"]').value.trim();
  if (!email) return;
  window.location.href = 'mailto:outreach@the-epoch-institute.org'
    + '?subject=' + encodeURIComponent('Notify me: ' + seriesName)
    + '&body=' + encodeURIComponent('Please notify ' + email + ' when ' + seriesName + ' is published.');
}

