  </section>

  <!-- Order the Ages -->
  <section class="gm-game" id="game-order" role="tabpanel" aria-labelledby="tab-order" hidden>
    <div class="gm-bar">
      <p class="gm-howto">Put these five into time order, oldest at the top. Tap two cards to swap them, then check.</p>
      <p class="gm-score"><span id="order-tries">0 checks</span><span class="gm-best" id="order-best"></span></p>
      <button type="button" class="gm-again" id="order-new">New round ↻</button>
