<main class="gm-page" id="main">
  <nav class="ref-crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">History Games</li></ol></nav>
  <header class="ref-head">
    <span class="hero-ornament"></span>
    <h1 class="research-title">History games</h1>
    <p class="ref-lede">Nine games built from the collection, with real pictures and real dates. No sign-up and nothing to install; your best scores stay in this browser. Younger players will find more in the <a href="/kids">Kids corner</a>, and there is a daily <a href="/quiz">History Quiz</a> too.</p>
    <button type="button" class="gm-sound" id="gm-sound" aria-pressed="false"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path class="gm-sound-on" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path class="gm-sound-off" d="M16.5 9.5l5 5m0-5l-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span>Sound off</span></button>
  </header>

  <div class="gm-tabs" role="tablist" aria-label="Choose a game">
    <span class="gm-tab-ink" aria-hidden="true"></span>
    <button class="gm-tab" id="tab-pairs" role="tab" aria-selected="true" aria-controls="game-pairs"><span class="gm-tab-ic" aria-hidden="true">&#10022;</span><span class="gm-tab-t">Emblem Pairs</span></button>
    <button class="gm-tab" id="tab-order" role="tab" aria-selected="false" aria-controls="game-order" tabindex="-1"><span class="gm-tab-ic" aria-hidden="true">&#8645;</span><span class="gm-tab-t">Order the Ages</span></button>
    <button class="gm-tab" id="tab-hunt" role="tab" aria-selected="false" aria-controls="game-hunt" tabindex="-1"><span class="gm-tab-ic" aria-hidden="true">&#9673;</span><span class="gm-tab-t">Globe Hunt</span></button>
    <button class="gm-tab" id="tab-first" role="tab" aria-selected="false" aria-controls="game-first" tabindex="-1"><span class="gm-tab-ic" aria-hidden="true">&#9878;</span><span class="gm-tab-t">Which Came First?</span></button>
    <button class="gm-tab" id="tab-puzzle" role="tab" aria-selected="false" aria-controls="game-puzzle" tabindex="-1"><span class="gm-tab-ic" aria-hidden="true">&#10070;</span><span class="gm-tab-t">Picture Puzzle</span></button>
    <button class="gm-tab" id="tab-words" role="tab" aria-selected="false" aria-controls="game-words" tabindex="-1"><span class="gm-tab-ic" aria-hidden="true">&#9998;</span><span class="gm-tab-t">Word Hunt</span></button>
    <button class="gm-tab" id="tab-year" role="tab" aria-selected="false" aria-controls="game-year" tabindex="-1"><span class="gm-tab-ic" aria-hidden="true">&#10710;</span><span class="gm-tab-t">Guess the Year</span></button>
    <button class="gm-tab" id="tab-conn" role="tab" aria-selected="false" aria-controls="game-conn" tabindex="-1"><span class="gm-tab-ic" aria-hidden="true">&#9638;</span><span class="gm-tab-t">Connections</span></button>
    <button class="gm-tab" id="tab-cross" role="tab" aria-selected="false" aria-controls="game-cross" tabindex="-1"><span class="gm-tab-ic" aria-hidden="true">&#9636;</span><span class="gm-tab-t">Crossword</span></button>
  </div>

  <!-- Emblem Pairs -->
  <section class="gm-game" id="game-pairs" role="tabpanel" aria-labelledby="tab-pairs">
    <div class="gm-head">
      <p class="gm-howto">Turn over two cards at a time and find every matching pair of flags and emblems. Fewer flips earn more stars.</p>
      <div class="gm-seg" data-for="pairs" role="group" aria-label="Difficulty"><button type="button" data-v="6">Easy</button><button type="button" data-v="8">Medium</button><button type="button" data-v="10">Hard</button></div>
    </div>
    <div class="gm-stats">
      <span class="gm-stat"><b id="pairs-flips">0</b> <span id="pairs-flips-l">flips</span></span>
      <span class="gm-stat gm-stat-time"><b id="pairs-time">0:00</b></span>
      <span class="gm-stat gm-stat-best" id="pairs-best"></span>
      <button type="button" class="gm-again" id="pairs-new">New round &#8635;</button>
    </div>
    <div class="gm-board"><div class="gm-pairs" id="pairs-grid"></div><div class="gm-done" id="pairs-done" hidden></div></div>
    <p class="gm-live" id="pairs-live" aria-live="polite"></p>
  </section>

  <!-- Order the Ages -->
  <section class="gm-game" id="game-order" role="tabpanel" aria-labelledby="tab-order" hidden>
    <div class="gm-head">
      <p class="gm-howto">Put these in time order, oldest at the top (a person by the year they were born). Drag a card by its handle, use the arrows, or tap two cards to swap them, then check.</p>
      <div class="gm-seg" data-for="order" role="group" aria-label="Number of cards"><button type="button" data-v="4">4 cards</button><button type="button" data-v="5">5 cards</button><button type="button" data-v="6">6 cards</button></div>
    </div>
    <div class="gm-stats">
      <span class="gm-stat"><b id="order-checks">0</b> checks</span>
      <span class="gm-stat gm-stat-best" id="order-best"></span>
      <button type="button" class="gm-again" id="order-new">New round &#8635;</button>
    </div>
    <div class="gm-board"><ol class="gm-order" id="order-list"></ol><div class="gm-done gm-done-inline" id="order-done" hidden></div></div>
    <div class="gm-actions"><button type="button" class="hero-cta" id="order-check">Check the order</button></div>
  </section>

  <!-- Globe Hunt -->
  <section class="gm-game" id="game-hunt" role="tabpanel" aria-labelledby="tab-hunt" hidden>
    <div class="gm-head">
      <p class="gm-howto">Find where each state lay. Drag to turn the globe, zoom with the wheel or the buttons, and tap to place your guess. Five rounds in five regions of the world, up to 100 points each.</p>
      <div class="gm-seg" data-for="hunt" role="group" aria-label="Which states"><button type="button" data-v="famous">Famous states</button><button type="button" data-v="all">All states</button></div>
    </div>
    <div class="gm-stats">
      <ol class="gm-rounds" id="hunt-rounds" aria-label="Rounds"><li></li><li></li><li></li><li></li><li></li></ol>
      <span class="gm-stat"><b id="hunt-score">0</b> points</span>
      <span class="gm-stat gm-stat-best" id="hunt-best"></span>
      <button type="button" class="gm-again" id="hunt-new">New game &#8635;</button>
    </div>
    <div class="gm-hunt-q"><p id="hunt-q">Loading the globe&hellip;</p><button type="button" class="gm-hint" id="hunt-hint" hidden>Hint <small>&minus;20</small></button></div>
    <div class="gm-hunt-wrap">
      <canvas id="hunt-globe" tabindex="0" role="application" aria-roledescription="globe" aria-label="A globe. Drag to turn it, then tap where you think the named state lay. With a keyboard: the arrow keys turn it, plus and minus zoom, and Enter drops your pin at the centre."></canvas>
      <span class="gm-hunt-cross" aria-hidden="true"></span>
      <div class="gm-hunt-zoom"><button type="button" id="hunt-zin" aria-label="Zoom in">+</button><button type="button" id="hunt-zout" aria-label="Zoom out">&minus;</button></div>
      <div class="gm-hunt-res" id="hunt-res" hidden></div>
      <div class="gm-done" id="hunt-done" hidden></div>
    </div>
  </section>

  <!-- Which Came First? -->
  <section class="gm-game" id="game-first" role="tabpanel" aria-labelledby="tab-first" hidden>
    <div class="gm-head">
      <p class="gm-howto" id="first-howto">Two moments from history: tap the one that came first (for a person, the year they were born). Every right answer grows your streak, and the gaps get closer as you go. You have three lives.</p>
      <div class="gm-seg" data-for="first" role="group" aria-label="Which game"><button type="button" data-v="daily">Daily Ten</button><button type="button" data-v="all">Everything</button><button type="button" data-v="people">People</button><button type="button" data-v="events">Events and works</button></div>
    </div>
    <div class="gm-stats">
      <span class="gm-lives" id="first-lives" aria-label="3 lives left"></span>
      <span class="gm-stat"><b id="first-streak">0</b> <span id="first-unit">in a row</span></span>
      <span class="gm-stat gm-stat-best" id="first-best"></span>
      <button type="button" class="gm-again" id="first-new">New game &#8635;</button>
    </div>
    <div class="gm-board">
      <div class="gm-duel" id="first-duel"></div>
      <div class="gm-fc-res" id="first-res" aria-live="polite"></div>
      <div class="gm-done" id="first-done" hidden></div>
    </div>
  </section>

  <!-- Picture Puzzle -->
  <section class="gm-game" id="game-puzzle" role="tabpanel" aria-labelledby="tab-puzzle" hidden>
    <div class="gm-head">
      <p class="gm-howto">Swap the pieces to put the picture back together: tap two pieces to swap them, or drag one onto another. A piece in the right place glows and stays.</p>
      <div class="gm-seg" data-for="puzzle" role="group" aria-label="Pieces"><button type="button" data-v="3">3 &times; 3</button><button type="button" data-v="4">4 &times; 4</button><button type="button" data-v="5">5 &times; 5</button></div>
    </div>
    <div class="gm-seg gm-seg-wide" data-for="pzset" role="group" aria-label="Set of pictures"></div>
    <div class="gm-stats">
      <span class="gm-stat"><b id="puzzle-moves">0</b> moves</span>
      <span class="gm-stat gm-stat-time"><b id="puzzle-time">0:00</b></span>
      <span class="gm-stat gm-stat-best" id="puzzle-prog"></span>
      <button type="button" class="gm-again" id="puzzle-peek">Peek</button>
      <button type="button" class="gm-again" id="puzzle-new">Shuffle &#8635;</button>
    </div>
    <div class="gm-board gm-pz-wrap"><div class="gm-pz" id="puzzle-board" role="group" aria-label="Picture puzzle"></div><div class="gm-done" id="puzzle-done" hidden></div></div>
    <p class="gm-credit" id="puzzle-credit"></p>
    <ol class="gm-pz-strip" id="puzzle-strip" aria-label="Pictures in this set"></ol>
  </section>

  <!-- Word Hunt -->
  <section class="gm-game" id="game-words" role="tabpanel" aria-labelledby="tab-words" hidden>
    <div class="gm-head">
      <p class="gm-howto">Find the hidden words: drag across the letters, or tap the first and the last letter of a word. Each word you find tells you something about the theme.</p>
      <div class="gm-seg" data-for="words" role="group" aria-label="Difficulty"><button type="button" data-v="easy">Easy</button><button type="button" data-v="medium">Medium</button><button type="button" data-v="hard">Hard</button></div>
    </div>
    <div class="gm-wh-themes" id="words-themes" role="group" aria-label="Choose a theme"></div>
    <p class="gm-wh-intro" id="words-intro"></p>
    <div class="gm-stats">
      <span class="gm-stat"><b id="words-found">0</b> of <b id="words-total">0</b> found</span>
      <span class="gm-stat gm-stat-time"><b id="words-time">0:00</b></span>
      <span class="gm-stat gm-stat-best" id="words-best"></span>
      <button type="button" class="gm-again" id="words-new">New grid &#8635;</button>
    </div>
    <div class="gm-board gm-wh">
      <div class="gm-wh-grid" id="words-grid" role="img"></div>
      <div class="gm-wh-side">
        <ul class="gm-wh-list" id="words-list"></ul>
        <form class="gm-wh-type" id="words-type"><label for="words-input">Spotted one? Type it:</label><span><input id="words-input" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="14"><button type="submit">Check</button></span><span class="gm-live" id="words-say" aria-live="polite"></span></form>
      </div>
      <div class="gm-done" id="words-done" hidden></div>
    </div>
  </section>

  <!-- Guess the Year -->
  <section class="gm-game" id="game-year" role="tabpanel" aria-labelledby="tab-year" hidden>
    <div class="gm-head">
      <p class="gm-howto">Look at the picture and slide to the year you think it shows. The closer you are, the more points you score: five rounds, one from each age, up to 100 points each.</p>
    </div>
    <div class="gm-stats">
      <ol class="gm-rounds" id="year-rounds" aria-label="Rounds"><li></li><li></li><li></li><li></li><li></li></ol>
      <span class="gm-stat"><b id="year-score">0</b> points</span>
      <span class="gm-stat gm-stat-best" id="year-best"></span>
      <button type="button" class="gm-again" id="year-new">New game &#8635;</button>
    </div>
    <div class="gm-board gm-yr">
      <p class="gm-yr-q" id="year-q"></p>
      <figure class="gm-yr-fig"><img id="year-img" alt=""><figcaption class="gm-credit" id="year-credit"></figcaption></figure>
      <div class="gm-yr-pick" id="year-pick">
        <output class="gm-yr-out" id="year-out" for="year-range">1000 CE</output>
        <input type="range" id="year-range" min="0" max="1000" step="1" value="855" aria-label="Your year">
        <div class="gm-yr-scale" id="year-scale" aria-hidden="true"></div>
        <div class="gm-yr-fine" id="year-fine" role="group" aria-label="Fine-tune the year"><button type="button" data-d="-10">&minus;10</button><button type="button" data-d="-1">&minus;1</button><button type="button" data-d="1">+1</button><button type="button" data-d="10">+10</button></div>
        <button type="button" class="hero-cta" id="year-go">That&rsquo;s my guess</button>
      </div>
      <div class="gm-yr-res" id="year-res" hidden></div>
      <div class="gm-done" id="year-done" hidden></div>
    </div>
  </section>

  <!-- History Connections -->
  <section class="gm-game" id="game-conn" role="tabpanel" aria-labelledby="tab-conn" hidden>
    <div class="gm-head">
      <p class="gm-howto">Sixteen names from history hide four groups of four. Pick four that belong together and submit; the groups get harder from yellow to purple. Four mistakes are allowed. A new puzzle every day, the same for everyone.</p>
    </div>
    <div class="gm-stats">
      <span class="gm-stat" id="conn-num"></span>
      <span class="gm-conn-left" id="conn-left"></span>
      <span class="gm-stat gm-stat-best" id="conn-best"></span>
    </div>
    <div class="gm-board gm-conn">
      <div class="gm-conn-solved" id="conn-solved"></div>
      <div class="gm-conn-grid" id="conn-grid" role="group" aria-label="The tiles: pick four"></div>
      <p class="gm-live gm-conn-live" id="conn-live" aria-live="polite"></p>
      <div class="gm-conn-acts"><button type="button" class="gm-again" id="conn-shuffle">Shuffle</button><button type="button" class="gm-again" id="conn-clear">Deselect all</button><button type="button" class="hero-cta" id="conn-go" disabled>Submit</button></div>
      <div class="gm-done" id="conn-done" hidden></div>
    </div>
    <p class="gm-conn-more"><label>Play another <select id="conn-pick"></select></label></p>
  </section>

  <!-- History Crossword -->
  <section class="gm-game" id="game-cross" role="tabpanel" aria-labelledby="tab-cross" hidden>
    <div class="gm-head">
      <p class="gm-howto">A crossword of history, new every day and the same for everyone. Tap a square (tap it again to go the other way) and type the answer. Check, reveal a letter or a word, or show the answers when you are stuck.</p>
    </div>
    <div class="gm-stats">
      <span class="gm-stat" id="cw-num"></span>
      <span class="gm-stat gm-cw-time" id="cw-time" aria-label="Time"></span>
      <span class="gm-stat gm-stat-best" id="cw-best"></span>
    </div>
    <div class="gm-board gm-cw">
      <div class="gm-cw-main">
        <div class="gm-cw-bar"><button type="button" id="cw-prev" aria-label="Previous clue">&lsaquo;</button><p class="gm-cw-clue" id="cw-clue" aria-live="polite"></p><button type="button" id="cw-next" aria-label="Next clue">&rsaquo;</button></div>
        <div class="gm-cw-grid" id="cw-grid" role="group" tabindex="0" aria-label="The crossword: choose a square and type"><p class="gm-howto">The crossword is loading&hellip;</p></div>
        <div class="gm-cw-kb" id="cw-kb" aria-label="Letters" hidden></div>
        <div class="gm-cw-acts"><button type="button" class="gm-again" id="cw-check">Check</button><button type="button" class="gm-again" id="cw-rletter">Reveal a letter</button><button type="button" class="gm-again" id="cw-rword">Reveal the word</button><button type="button" class="gm-again" id="cw-show">Show the answers</button></div>
        <p class="gm-live" id="cw-live" aria-live="polite"></p>
      </div>
      <div class="gm-cw-clues"><div><p class="gm-cw-h">Across</p><ol id="cw-across"></ol></div><div><p class="gm-cw-h">Down</p><ol id="cw-down"></ol></div></div>
      <div class="gm-done" id="cw-done" hidden></div>
    </div>
    <p class="gm-conn-more"><label>Play another <select id="cw-pick"></select></label></p>
  </section>
</main>

