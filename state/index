<script>
initNav('states');
(function () {
  // Index of every state in the register; each state has its own page at /state/<id> (built by scripts/build-pages.ps1)
  // and the 394 with a full profile live at /empire/<slug>.
  var CM = ConnectionsMap, esc = CM.esc, nodes = [], PAGE = 150, shown = PAGE;
  var $ = function (id) { return document.getElementById(id); };
  var REGION_NAMES = { 'british-isles': 'British Isles', 'france-low-countries': 'France and the Low Countries', 'iberia': 'Iberia', 'italy': 'Italy', 'hre-germany-central-europe': 'Germany and Central Europe',
    'greece-aegean': 'Greece and the Aegean', 'balkans-hungary': 'Balkans and Hungary', 'scandinavia-baltic': 'Scandinavia and the Baltic', 'poland-lithuania-russia': 'Poland, Lithuania and Russia',
    'caucasus': 'Caucasus', 'anatolia-levant': 'Anatolia and the Levant', 'mesopotamia-iran': 'Mesopotamia and Iran', 'arabia-gulf': 'Arabia and the Gulf', 'egypt-maghreb-sahara': 'Egypt, North Africa and Sudan',
    'west-africa': 'West Africa', 'horn-east-africa': 'Horn and East Africa', 'central-southern-africa': 'Central and Southern Africa', 'central-asia-steppe': 'Central Asia and the Steppe',
    'south-asia': 'South Asia', 'south-asia-princely-states': 'Indian princely states', 'southeast-asia-mainland': 'Mainland Southeast Asia', 'maritime-southeast-asia': 'Maritime Southeast Asia',
    'china-tibet-mongolia': 'China, Tibet and Mongolia', 'korea-japan': 'Korea and Japan', 'mesoamerica-caribbean': 'Mesoamerica and the Caribbean', 'andes-south-america': 'South America', 'north-america-oceania': 'North America and Oceania' };
  function fold(s) { return (typeof searchFold === 'function' ? searchFold(s) : String(s).toLowerCase()); }
  function typeLabel(t) { return String(t || 'state').replace(/-/g, ' '); }
  function regionLabel(rg) { return REGION_NAMES[rg] || String(rg || '').replace(/-/g, ' ').replace(/\b\w/g, function (c) { return c.toUpperCase(); }); }
  function url(n) { return n.p ? n.p : '/state/' + n.id; }
  function alive(n, y) { return (n.s == null || n.s <= y) && (n.e == null || n.e >= y); }
  function fillSelect(el, values, label) { el.innerHTML += values.map(function (v) { return '<option value="' + esc(v) + '">' + esc(label ? label(v) : v) + '</option>'; }).join(''); }
  function filtered() {
    var q = fold($('st-q').value.trim()), rg = $('st-region').value, co = $('st-country').value, ty = $('st-type').value, yv = $('st-year').value.trim(), y = yv === '' ? null : +yv;
    return nodes.filter(function (n) {
      if (rg && n.rg !== rg) return false;
      if (ty && n.t !== ty) return false;
      if (co && (n.mo || []).indexOf(co) === -1) return false;
      if (y != null && !isNaN(y) && !alive(n, y)) return false;
      if (q && fold(n.n).indexOf(q) === -1 && !(n.a || []).some(function (a) { return fold(a).indexOf(q) !== -1; })) return false;
      return true;
    });
  }
  function renderIndex() {
    var list = filtered(), yv = $('st-year').value.trim();
    $('st-count').textContent = list.length.toLocaleString('en-GB') + (list.length === 1 ? ' state' : ' states') + (yv !== '' && !isNaN(+yv) ? ' existing in ' + CM.yr(+yv) : '');
    $('st-list').innerHTML = list.length ? list.slice(0, shown).map(function (n) {
      return '<li class="st-item"><a href="' + esc(url(n)) + '"><span class="st-name">' + esc(n.n) + '</span><span class="st-yrs">' + esc(CM.span(n)) + '</span>' +
        '<span class="st-sub"><b>' + esc(n.p ? 'profile' : typeLabel(n.t)) + '</b> · ' + esc(n.rg ? regionLabel(n.rg) : n.b || '') + (n.mo && n.mo.length ? ' · today ' + esc(n.mo.slice(0, 3).join(', ')) : '') + '</span></a></li>';
    }).join('') : '<li class="st-empty">No states match these filters.</li>';
    $('st-more').hidden = list.length <= shown;
    $('st-more').textContent = 'Show more (' + (list.length - shown).toLocaleString('en-GB') + ' left)';
  }
  ['st-q', 'st-region', 'st-country', 'st-type', 'st-year'].forEach(function (id) { $(id).addEventListener('input', function () { shown = PAGE; renderIndex(); }); });
  $('st-more').addEventListener('click', function () { shown += PAGE * 2; renderIndex(); });
  $('st-random').addEventListener('click', function (e) {
    var pool = nodes.filter(function (n) { return !n.p; }); if (!pool.length) return;
    e.preventDefault(); location.href = '/state/' + pool[Math.floor(Math.random() * pool.length)].id;
  });
  CM.load().then(function (d) {
    nodes = d.nodes.slice().sort(function (a, b) { return a.n.localeCompare(b.n, 'en'); });
    var regions = {}, countries = {}, types = {};
    nodes.forEach(function (n) { if (n.rg) regions[n.rg] = 1; (n.mo || []).forEach(function (c) { countries[c] = 1; }); types[n.t || 'state'] = 1; });
    fillSelect($('st-region'), Object.keys(regions).sort(), regionLabel);
    fillSelect($('st-country'), Object.keys(countries).sort());
    fillSelect($('st-type'), Object.keys(types).sort(), typeLabel);
    $('st-stats').textContent = nodes.length.toLocaleString('en-GB') + ' states · ' + Object.keys(countries).length + ' present-day countries';
    renderIndex();
  });
})();
</script>
