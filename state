<script>
initNav('states');
(function () {
  var CM = ConnectionsMap, esc = CM.esc, nodes = [], byId = {}, LINKS = [], chunks = {}, PAGE = 150, shown = PAGE;
  var $ = function (id) { return document.getElementById(id); };
  var REGION_NAMES = { 'british-isles': 'British Isles', 'france-low-countries': 'France and the Low Countries', 'iberia': 'Iberia', 'italy': 'Italy', 'hre-germany-central-europe': 'Germany and Central Europe',
    'greece-aegean': 'Greece and the Aegean', 'balkans-hungary': 'Balkans and Hungary', 'scandinavia-baltic': 'Scandinavia and the Baltic', 'poland-lithuania-russia': 'Poland, Lithuania and Russia',
    'caucasus': 'Caucasus', 'anatolia-levant': 'Anatolia and the Levant', 'mesopotamia-iran': 'Mesopotamia and Iran', 'arabia-gulf': 'Arabia and the Gulf', 'egypt-maghreb-sahara': 'Egypt, North Africa and Sudan',
    'west-africa': 'West Africa', 'horn-east-africa': 'Horn and East Africa', 'central-southern-africa': 'Central and Southern Africa', 'central-asia-steppe': 'Central Asia and the Steppe',
    'south-asia': 'South Asia', 'south-asia-princely-states': 'Indian princely states', 'southeast-asia-mainland': 'Mainland Southeast Asia', 'maritime-southeast-asia': 'Maritime Southeast Asia',
    'china-tibet-mongolia': 'China, Tibet and Mongolia', 'korea-japan': 'Korea and Japan', 'mesoamerica-caribbean': 'Mesoamerica and the Caribbean', 'andes-south-america': 'South America', 'north-america-oceania': 'North America and Oceania' };
  function fold(s) { return (typeof searchFold === 'function' ? searchFold(s) : String(s).toLowerCase()); }
  function yrs(n) { return CM.span(n) + (n.x ? ' (approx.)' : ''); }
  function typeLabel(t) { return String(t || 'state').replace(/-/g, ' '); }
  function regionLabel(rg) { return REGION_NAMES[rg] || String(rg || '').replace(/-/g, ' ').replace(/\b\w/g, function (c) { return c.toUpperCase(); }); }
  function url(n) { return n.p ? n.p : '/state#' + n.id; }
  function alive(n, y) { return (n.s == null || n.s <= y) && (n.e == null || n.e >= y); }

  // ── index ──
  function fillSelect(el, values, label) { el.innerHTML += values.map(function (v) { return '<option value="' + esc(v) + '">' + esc(label ? label(v) : v) + '</option>'; }).join(''); }
  function filtered() {
    var q = fold($('st-q').value.trim()), rg = $('st-region').value, co = $('st-country').value, ty = $('st-type').value, yv = $('st-year').value.trim(), y = yv === '' ? null : +yv;
    return nodes.filter(function (n) {
      if (rg && n.rg !== rg) return false;
      if (ty && n.t !== ty) return false;
      if (co && (n.mo || []).indexOf(co) === -1) return false;
      if (y != null && !isNaN(y) && !alive(n, y)) return false;
      if (q && fold(n.n).indexOf(q) === -1 && !(n.a || []).some(function (a) { return fold(a).indexOf(q) !== -1; })) return false;
      return true;
    });
  }
  function renderIndex() {
    var list = filtered(), yv = $('st-year').value.trim();
    $('st-count').textContent = list.length.toLocaleString('en-GB') + (list.length === 1 ? ' state' : ' states') + (yv !== '' && !isNaN(+yv) ? ' existing in ' + CM.yr(+yv) : '');
    $('st-list').innerHTML = list.length ? list.slice(0, shown).map(function (n) {
      return '<li class="st-item"><a href="' + esc(url(n)) + '"><span class="st-name">' + esc(n.n) + '</span><span class="st-yrs">' + esc(CM.span(n)) + '</span>' +
        '<span class="st-sub"><b>' + esc(n.p ? 'profile' : typeLabel(n.t)) + '</b> · ' + esc(n.rg ? regionLabel(n.rg) : n.b || '') + (n.mo && n.mo.length ? ' · today ' + esc(n.mo.slice(0, 3).join(', ')) : '') + '</span></a></li>';
    }).join('') : '<li class="st-empty">No states match these filters.</li>';
    $('st-more').hidden = list.length <= shown;
    $('st-more').textContent = 'Show more (' + (list.length - shown).toLocaleString('en-GB') + ' left)';
  }
  ['st-q', 'st-region', 'st-country', 'st-type', 'st-year'].forEach(function (id) { $(id).addEventListener('input', function () { shown = PAGE; renderIndex(); }); });
  $('st-more').addEventListener('click', function () { shown += PAGE * 2; renderIndex(); });
  function randomId() { var pool = nodes.filter(function (n) { return !n.p; }); return pool[Math.floor(Math.random() * pool.length)].id; }
  $('st-random').addEventListener('click', function (e) { e.preventDefault(); location.hash = randomId(); });

  // ── article ──
  function chunkKey(id) { var c = id.charAt(0); return /[a-z]/.test(c) ? c : '0'; }
  function loadChunk(id) {
    var k = chunkKey(id);
    if (!chunks[k]) chunks[k] = fetch('/data/states/' + k + '.json?v=5').then(function (r) { return r.ok ? r.json() : {}; }).catch(function () { return {}; });
    return chunks[k];
  }
  // text with gold-link markers: [[e:slug|text]] encyclopedia entry, [[s:id|text]] another state or empire
  function rich(t) {
    var out = '', pos = 0, rx = /\[\[([es]):([^|\]]+)\|([^\]]*)\]\]/g, m;
    while ((m = rx.exec(t))) {
      out += esc(t.slice(pos, m.index));
      if (m[1] === 'e') out += '<a class="enc-link" href="/encyclopedia#' + esc(m[2]) + '">' + esc(m[3]) + '</a>';
      else { var o = byId[m[2]]; out += o ? '<a class="enc-link st-link" href="' + esc(url(o)) + '">' + esc(m[3]) + '</a>' : esc(m[3]); }
      pos = m.index + m[0].length;
    }
    return out + esc(t.slice(pos));
  }
  // emblem card for states without a picture: a line emblem for the kind of state, its type and region, and where its
  // lifespan falls between 3000 BCE and today
  var EMBLEM = {
    crown: '<path d="M22 72 V40 L36 54 L50 28 L64 54 L78 40 V72 Z"/><path d="M22 80 H78"/><circle cx="50" cy="24" r="3"/><circle cx="22" cy="36" r="2.5"/><circle cx="78" cy="36" r="2.5"/>',
    coronet: '<path d="M20 74 H80 V60 H20 Z"/><path d="M20 60 Q35 46 50 60 Q65 46 80 60"/><circle cx="20" cy="54" r="3"/><circle cx="35" cy="48" r="3"/><circle cx="50" cy="44" r="3"/><circle cx="65" cy="48" r="3"/><circle cx="80" cy="54" r="3"/>',
    mitre: '<path d="M30 82 V46 Q50 12 70 46 V82 Z"/><path d="M50 30 V82 M40 58 H60"/>',
    tower: '<path d="M24 82 V42 H32 V34 H40 V42 H46 V34 H54 V42 H60 V34 H68 V42 H76 V82 Z"/><path d="M44 82 V66 Q50 58 56 66 V82"/><path d="M34 54 H40 M60 54 H66"/>',
    dome: '<path d="M24 82 V62 Q24 40 50 34 Q76 40 76 62 V82 Z"/><path d="M50 34 V24"/><path d="M53 13 A6 6 0 1 0 53 25 A4.5 4.5 0 1 1 53 13"/><path d="M38 82 V66 Q44 58 50 66 V82"/>',
    yurt: '<path d="M18 74 V58 Q50 30 82 58 V74 Z"/><path d="M42 74 V60 H58 V74"/><path d="M30 50 L50 36 L70 50"/><path d="M50 36 V26"/>',
    tribal: '<ellipse cx="44" cy="56" rx="16" ry="24"/><path d="M44 34 V78"/><path d="M68 20 V84"/><path d="M68 20 L63 30 H73 Z"/>',
    columns: '<path d="M20 38 L50 20 L80 38 Z"/><path d="M24 42 H76 M24 80 H76"/><path d="M30 44 V78 M43 44 V78 M57 44 V78 M70 44 V78"/>',
    ship: '<path d="M20 64 H80 L70 78 H30 Z"/><path d="M50 64 V18"/><path d="M50 22 L72 56 H50"/><path d="M50 28 L32 56 H50"/>',
    shield: '<path d="M26 24 H74 V52 Q74 74 50 84 Q26 74 26 52 Z"/><path d="M50 24 V84 M26 46 H74"/>'
  };
  function emblemKind(n) {
    var t = n.t || '', m = n.m || '';
    // the type decides first; the character (mode) only when the type says nothing distinctive
    if (/nomadic|khanate|khaganate|horde/.test(t)) return 'yurt';
    if (/chiefdom|tribal/.test(t)) return 'tribal';
    if (/kingdom|princely-state/.test(t)) return 'crown';
    if (/duchy|principality|county|margraviate|electorate|landgraviate|lordship|despotate/.test(t)) return 'coronet';
    if (/bishopric|theocracy|imamate/.test(t)) return 'mitre';
    if (/city|polis|league/.test(t)) return 'tower';
    if (/sultanate|emirate|caliphate|beylik/.test(t)) return 'dome';
    if (/republic|commune|confederation/.test(t)) return 'columns';
    if (/colony|protectorate|mandate|territory/.test(t)) return 'ship';
    return { nomadic: 'yurt', tribal: 'tribal', theocratic: 'mitre', colonial: 'ship', mercantile: 'tower' }[m] || 'shield';
  }
  function emblemCard(n) {
    var lo = -3000, hi = 2025, s = n.s == null ? lo : Math.max(lo, n.s), e = n.e == null ? hi : Math.min(hi, n.e);
    var left = (s - lo) / (hi - lo) * 100, width = Math.max(1.2, (e - s) / (hi - lo) * 100);
    return '<div class="st-emblem" role="img" aria-label="' + esc(typeLabel(n.t) + ', ' + yrs(n)) + '">' +
      '<svg viewBox="0 0 100 100" aria-hidden="true">' + EMBLEM[emblemKind(n)] + '</svg>' +
      '<p class="st-emblem-type">' + esc(typeLabel(n.t)) + '</p><p class="st-emblem-region">' + esc(n.rg ? regionLabel(n.rg) : n.b || '') + '</p>' +
      '<div class="st-span" aria-hidden="true"><span class="st-span-bar" style="left:' + left.toFixed(2) + '%;width:' + width.toFixed(2) + '%"></span></div>' +
      '<div class="st-span-axis" aria-hidden="true"><span>3000 BCE</span><span>1 CE</span><span>2000</span></div></div>';
  }
  // full sentence ("Kingdom of Powys was a vassal of Kingdom of Gwynedd") with the other state as a link
  function tieRow(r) {
    var s = esc(r.sentence), nm = esc(r.name), i = s.lastIndexOf(nm);
    if (i !== -1) s = s.slice(0, i) + '<a href="' + esc(url(byId[r.id])) + '">' + nm + '</a>' + s.slice(i + nm.length);
    return '<li><span>' + s + '</span><span class="dt">' + (r.f === r.u ? CM.yr(r.f) : CM.yr(r.f) + ' – ' + CM.yr(r.u)) + '</span></li>';
  }
  function renderArticle(n, d) {
    d = d || {};
    var preds = [], succs = [];
    LINKS.forEach(function (l) {
      if (l.r === 'successor-of' && l.s === n.id && byId[l.t]) preds.push(byId[l.t]);
      if (l.r === 'successor-of' && l.t === n.id && byId[l.s]) succs.push(byId[l.s]);
      if (l.r === 'merged-into' && l.s === n.id && byId[l.t]) succs.push(byId[l.t]);
      if (l.r === 'merged-into' && l.t === n.id && byId[l.s]) preds.push(byId[l.s]);
      if (l.r === 'split-from' && l.s === n.id && byId[l.t]) preds.push(byId[l.t]);
    });
    function uniq(a) { var s = {}; return a.filter(function (x) { if (s[x.id]) return false; s[x.id] = 1; return true; }).sort(function (a, b) { return (a.s || 0) - (b.s || 0); }); }
    preds = uniq(preds); succs = uniq(succs);
    function col(list) { return '<span class="col">' + list.slice(0, 6).map(function (x) { return '<a href="' + esc(url(x)) + '">' + esc(x.n) + ' <span class="st-conf">' + esc(CM.span(x)) + '</span></a>'; }).join('') + '</span>'; }
    var lineage = (preds.length || succs.length) ? '<section><h2 class="st-sec-title">Lineage</h2><div class="st-lineage">' + (preds.length ? col(preds) + '<span class="arr" aria-hidden="true">→</span>' : '') +
      '<span class="here">' + esc(n.n) + '</span>' + (succs.length ? '<span class="arr" aria-hidden="true">→</span>' + col(succs) : '') + '</div></section>' : '';
    var rows = CM.timeline(n.id).filter(function (r) { return preds.concat(succs).every(function (x) { return x.id !== r.id; }); });
    var ties = rows.length ? '<section><h2 class="st-sec-title">Connections (' + rows.length + ')</h2><ul class="st-ties">' + rows.slice(0, 60).map(tieRow).join('') + '</ul>' +
      (rows.length > 60 ? '<p class="st-conf">' + (rows.length - 60) + ' more on the <a href="/connections#' + esc(n.id) + '">connections map</a>.</p>' : '') + '</section>' : '';
    var fig = d.img ? '<figure class="st-fig"><img src="' + esc(d.img) + '" alt="' + esc(n.n) + '" loading="lazy" width="320">' +
      '<figcaption>' + ['Image: ' + (d.cr && d.cr.a ? esc(d.cr.a) : 'Wikimedia Commons'), d.cr && d.cr.l ? esc(d.cr.l) : ''].filter(Boolean).join(' · ') +
      (d.cr && d.cr.s ? ' · <a href="' + esc(d.cr.s) + '" target="_blank" rel="noopener">source</a>' : '') + '</figcaption></figure>'
      : emblemCard(n);
    var facts = '<dl class="st-facts"><dt>Years</dt><dd>' + esc(yrs(n)) + '</dd><dt>Type</dt><dd>' + esc(typeLabel(n.t)) + '</dd>' +
      (n.m ? '<dt>Character</dt><dd>' + esc(n.m) + '</dd>' : '') + (n.c ? '<dt>Capital</dt><dd>' + esc(n.c) + '</dd>' : '') +
      (d.ru && d.ru.length ? '<dt>Rulers</dt><dd>' + esc(d.ru.join(', ')) + '</dd>' : '') + (d.re ? '<dt>Religion</dt><dd>' + esc(d.re) + '</dd>' : '') +
      (d.la ? '<dt>Language</dt><dd>' + esc(d.la) + '</dd>' : '') + (n.mo && n.mo.length ? '<dt>Today</dt><dd>' + esc(n.mo.join(', ')) + '</dd>' : '') +
      (n.a && n.a.length ? '<dt>Also</dt><dd>' + esc(n.a.join(', ')) + '</dd>' : '') + '</dl>';
    var text = d.o ? '<h2>Origins</h2><p>' + rich(d.o) + '</p><h2>Rule and society</h2><p>' + rich(d.r) + '</p><h2>' + (n.e == null ? 'To the present' : 'Decline and legacy') + '</h2><p>' + rich(d.e) + '</p>' +
      (d.c === 'low' ? '<p class="st-conf">Few sources survive for this state; details are uncertain.</p>' : '')
      : '<p class="st-pending">A written history of this state is in preparation. Its dates, connections and lineage are below.</p>';
    $('st-article').innerHTML = '<a class="st-back" href="#">← All states</a>' +
      '<header><p class="st-kicker">' + esc(typeLabel(n.t)) + ' · ' + esc(n.rg ? regionLabel(n.rg) : n.b) + '</p><h1 class="st-title">' + esc(n.n) + '</h1><p class="st-meta">' + esc(yrs(n)) + (n.c ? ' · capital ' + esc(n.c) : '') + '</p></header>' +
      (d.t ? '<p class="st-teaser">' + esc(d.t) + '</p>' : '') +
      '<div class="st-body"><div class="st-text">' + text + '</div><aside class="st-side">' + fig + facts + '</aside></div>' + lineage +
      '<section class="st-mapwrap"><h2 class="st-sec-title">On the connections map</h2><div class="cx-map" id="st-map"></div><a class="st-maplink" href="/connections#' + esc(n.id) + '">Open the full map →</a></section>' + ties;
    document.title = n.n + ' — States — The Epoch Institute';
    CM.render($('st-map'), n.id, { compact: true, onSelect: function (id) { var o = byId[id]; if (o) location.href = url(o); } });
  }

  var lastScroll = 0;
  function route() {
    var id = decodeURIComponent(location.hash.slice(1)), n = id && byId[id];
    if (n && n.p) { location.replace(n.p); return; }
    if (n) {
      if (!$('st-index').hidden) lastScroll = window.scrollY;
      loadChunk(id).then(function (c) { renderArticle(n, c[id]); $('st-index').hidden = true; $('st-article').hidden = false; window.scrollTo(0, 0); });
    } else {
      $('st-index').hidden = false; $('st-article').hidden = true; document.title = 'States — The Epoch Institute'; window.scrollTo(0, lastScroll);
    }
  }
  CM.load().then(function (d) {
    nodes = d.nodes.slice().sort(function (a, b) { return a.n.localeCompare(b.n, 'en'); }); LINKS = d.links;
    nodes.forEach(function (n) { byId[n.id] = n; });
    var regions = {}, countries = {}, types = {};
    nodes.forEach(function (n) { if (n.rg) regions[n.rg] = 1; (n.mo || []).forEach(function (c) { countries[c] = 1; }); types[n.t || 'state'] = 1; });
    fillSelect($('st-region'), Object.keys(regions).sort(), regionLabel);
    fillSelect($('st-country'), Object.keys(countries).sort());
    fillSelect($('st-type'), Object.keys(types).sort(), typeLabel);
    $('st-stats').textContent = nodes.length.toLocaleString('en-GB') + ' states · ' + Object.keys(countries).length + ' present-day countries';
    renderIndex(); route();
  });
  window.addEventListener('hashchange', route);
})();
</script>

