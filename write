<script>
// /write: the twelve languages; the one chosen is kept in the address (#akkadian) and in this browser
(function () {
  var L = [['sumerian', 'Sumerian', 'Cuneiform'], ['akkadian', 'Akkadian', 'Cuneiform'], ['ancient-egyptian', 'Ancient Egyptian', 'Hieroglyphs'],
    ['ancient-greek', 'Ancient Greek', 'Greek, Linear B'], ['aramaic', 'Aramaic', 'Imperial Aramaic, Syriac'], ['hebrew', 'Hebrew', 'Square script, Paleo-Hebrew'],
    ['sanskrit', 'Sanskrit', 'Devanagari, Brahmi'], ['classical-chinese', 'Classical Chinese', 'Characters'], ['persian', 'Persian', 'Persian alphabet, Old Persian cuneiform'],
    ['arabic', 'Arabic', 'Arabic script'], ['old-turkic', 'Old Turkic', 'Orkhon runes'], ['old-norse', 'Old Norse', 'Younger Futhark runes']];
  var nav = document.getElementById('write-langs'), tool = document.getElementById('write-tool'), cur = null;
  nav.innerHTML = L.map(function (l) {
    return '<button type="button" class="write-lang" data-l="' + l[0] + '"><img src="/logos/thumbs/' + encodeURIComponent(l[1]) + '.png" alt="" width="40" height="40" loading="lazy"><span class="write-lang-t"><span class="write-lang-n">' + escHtml(l[1]) + '</span><span class="write-lang-s">' + escHtml(l[2]) + '</span></span></button>';
  }).join('');
  function choose(slug, scroll) {
    var l = L.filter(function (x) { return x[0] === slug; })[0] || L[2];
    if (cur === l[0]) return; cur = l[0];
    Array.prototype.forEach.call(nav.querySelectorAll('.write-lang'), function (b) { b.setAttribute('aria-current', String(b.getAttribute('data-l') === l[0])); });
    document.getElementById('write-tool-t').textContent = 'Write in ' + l[1];
    var p = document.getElementById('write-prof'); p.href = '/language/' + l[0]; p.innerHTML = 'The history of ' + escHtml(l[1]) + ' &rarr;';
    Scribe.mount(tool, l[0]);
    try { history.replaceState(null, '', '#' + l[0]); localStorage.setItem('epoch-write-lang', l[0]); } catch (e) {}
    if (scroll && tool.scrollIntoView) tool.scrollIntoView({ block: 'start', behavior: 'smooth' });
  }
  nav.addEventListener('click', function (e) { var b = e.target.closest('.write-lang'); if (b) choose(b.getAttribute('data-l'), true); });
  window.addEventListener('hashchange', function () { choose(location.hash.slice(1)); });
  var start = location.hash.slice(1); if (!start) { try { start = localStorage.getItem('epoch-write-lang'); } catch (e) {} }
  choose(start || 'ancient-egyptian');
})();
</script>
