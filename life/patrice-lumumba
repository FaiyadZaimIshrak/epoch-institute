        <h1 class="profile-detail-name">Patrice Lumumba</h1>
        <div class="info-stats" style="margin-top:10px;">
          <div class="info-stat"><span class="info-stat-label">Period</span><span class="info-stat-val">1925 CE – 1961 CE</span></div>
