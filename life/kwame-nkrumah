        <h1 class="profile-detail-name">Kwame Nkrumah</h1>
        <div class="info-stats" style="margin-top:10px;">
          <div class="info-stat"><span class="info-stat-label">Period</span><span class="info-stat-val">1909 CE – 1972 CE</span></div>
