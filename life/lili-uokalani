        <h1 class="profile-detail-name">Liliʻuokalani</h1>
        <div class="info-stats" style="margin-top:10px;">
          <div class="info-stat"><span class="info-stat-label">Period</span><span class="info-stat-val">1838 CE – 1917 CE</span></div>
