        <h1 class="profile-detail-name">Murasaki Shikibu</h1>
        <div class="info-stats" style="margin-top:10px;">
          <div class="info-stat"><span class="info-stat-label">Period</span><span class="info-stat-val">c. 973 CE – c. 1014 CE</span></div>
