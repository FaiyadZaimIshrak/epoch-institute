</head>
<body>

<main class="cx-page" id="main">
  <div class="cx-head">
    <p class="explorer-label">Interactive map</p>
    <h1 class="explorer-title">Connections</h1>
    <p class="explorer-description">Pick a state, kingdom or empire. The states connected to it light up: provinces and vassals, predecessors and successors, unions and conquests. The timeline shows when each link held. Unconnected states of the same age appear as dim points at the edge.</p>
  </div>
  <div class="cx-controls">
    <label class="cx-search"><span>State</span><input id="cx-q" list="cx-names" placeholder="Search a state, e.g. Kingdom of Wales" autocomplete="off"><datalist id="cx-names"></datalist></label>
    <label class="cx-year"><span>Year <output id="cx-year-out">any</output></span><input type="range" id="cx-year" min="-3000" max="2000" step="10" value="2000" aria-label="Year"></label>
    <label class="cx-any"><input type="checkbox" id="cx-any" checked> Any year</label>
    <p class="cx-count" id="cx-count"></p>
  </div>
  <div class="cx-body">
    <div class="cx-map" id="cx-map" aria-live="polite"></div>
    <aside class="cx-card" id="cx-card"></aside>
  </div>
  <section class="cx-timeline-wrap" aria-labelledby="cx-tl-title">
    <h2 class="profile-references-title" id="cx-tl-title">Timeline of connections</h2>
    <div class="cx-legend"><span class="lg firm"></span>part of, province, colony, conquest <span class="lg loose"></span>vassal, tributary, union <span class="lg seq"></span>predecessor or successor</div>
    <div id="cx-timeline"></div>
  </section>
</main>

<script src="/shared-data.js?v=5"></script>
<script src="/shared-nav.js?v=14"></script>
<script src="/connections-map.js?v=9"></script>
<script>
initNav('connections');
(function () {
  var CM = ConnectionsMap, current = null, yearOn = false, expand = null, showAll = false;
  var map = document.getElementById('cx-map'), card = document.getElementById('cx-card'), tl = document.getElementById('cx-timeline');
  var q = document.getElementById('cx-q'), yr = document.getElementById('cx-year'), any = document.getElementById('cx-any'), yout = document.getElementById('cx-year-out');
  function year() { return yearOn ? +yr.value : null; }
  function show(id, push) {
    if (!CM.get(id)) return;
    if (id !== current) { expand = null; showAll = false; }
    current = id;
    if (push !== false && location.hash.slice(1) !== id) history.replaceState(null, '', '#' + id);
    CM.render(map, id, { year: year(), expand: expand,
      onSelect: function (nid) { show(nid); window.scrollTo({ top: map.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' }); },
      onExpand: function (t) { expand = t; showAll = false; show(current, false); } }).then(function (h) {
      var n = CM.get(id), e = CM.esc;
      document.title = n.n + ' — Connections — The Epoch Institute';
      card.innerHTML = '<p class="featured-region">' + e((n.t || 'state').replace(/-/g, ' ')) + (n.b ? ' · ' + e(n.b) : '') + '</p>' +
        '<h2 class="cx-name">' + e(n.n) + '</h2><p class="cx-dates">' + e(CM.span(n)) + (n.x ? ' (approx.)' : '') + '</p>' +
        '<dl class="cx-facts">' + (n.c ? '<dt>Capital</dt><dd>' + e(n.c) + '</dd>' : '') + (n.m ? '<dt>Character</dt><dd>' + e(n.m) + '</dd>' : '') +
        (n.mo ? '<dt>Today</dt><dd>' + e(n.mo.join(', ')) + '</dd>' : '') + (n.a ? '<dt>Also</dt><dd>' + e(n.a.join(', ')) + '</dd>' : '') +
        '<dt>Connections</dt><dd>' + h.total1 + ' direct, ' + h.total2 + ' further</dd></dl>' +
        (n.p ? '<a class="cx-profile" href="' + e(n.p) + '">Read the full profile →</a>' : '<a class="cx-profile" href="/state#' + e(n.id) + '">Read about this state →</a>');
      var rows = CM.timeline(id), total = rows.length, note = '';
      if (!rows.length) { tl.innerHTML = '<p class="cx-none">No recorded connections: an independent state with no recorded ties to the others in the archive.</p>'; return; }
      if (expand) { rows = rows.filter(function (r) { return (CM.get(r.id).t || 'state') === expand; }); note = '<p class="cx-filter-note">Showing ' + rows.length + ' of ' + total + ' connections: ' + e(expand.replace(/-/g, ' ')) + ' only.</p>'; }
      var LIMIT = 40, more = !showAll && rows.length > LIMIT ? rows.length - LIMIT : 0;
      if (more) rows = rows.slice(0, LIMIT);
      var lo = Math.min.apply(null, rows.map(function (r) { return r.f; })), hi = Math.max.apply(null, rows.map(function (r) { return r.u; }));
      if (hi - lo < 50) { lo -= 25; hi += 25; }
      tl.innerHTML = note + '<div class="cx-axis"><span>' + CM.yr(lo) + '</span><span>' + CM.yr(Math.round((lo + hi) / 2)) + '</span><span>' + CM.yr(hi) + '</span></div>' +
        rows.map(function (r) {
          var left = (r.f - lo) / (hi - lo) * 100, width = Math.max(0.8, (r.u - r.f) / (hi - lo) * 100);
          return '<button type="button" class="cx-row" data-id="' + e(r.id) + '"><span class="cx-row-label"><b>' + e(r.name) + '</b> <i>' + e(r.sentence) + '</i></span>' +
            '<span class="cx-track"><span class="cx-bar' + (r.exact ? '' : ' cx-bar-approx') + '" style="left:' + left.toFixed(2) + '%;width:' + width.toFixed(2) + '%"></span></span>' +
            '<span class="cx-row-dates">' + (r.f === r.u ? CM.yr(r.f) : CM.yr(r.f) + ' – ' + CM.yr(r.u)) + '</span></button>';
        }).join('') + (more ? '<button type="button" class="cx-more">Show ' + more + ' more</button>' : '');
      var mb = tl.querySelector('.cx-more'); if (mb) mb.addEventListener('click', function () { showAll = true; show(current, false); });
      tl.querySelectorAll('.cx-row').forEach(function (b) { b.addEventListener('click', function () { show(b.getAttribute('data-id')); window.scrollTo({ top: 0, behavior: 'smooth' }); }); });
    });
  }
  CM.load().then(function (d) {
    document.getElementById('cx-names').innerHTML = d.nodes.map(function (n) { return '<option value="' + CM.esc(n.n) + '">'; }).join('');
    document.getElementById('cx-count').textContent = d.nodes.length.toLocaleString('en-GB') + ' states · ' + d.links.length.toLocaleString('en-GB') + ' connections';
    var start = decodeURIComponent(location.hash.slice(1));
    show(CM.get(start) ? start : 'british-empire', false);
  });
  q.addEventListener('change', function () {
    var v = searchFold(q.value), hit = CM.all().filter(function (n) { return searchFold(n.n) === v || (n.a || []).some(function (a) { return searchFold(a) === v; }); })[0];
    if (hit) { show(hit.id); q.value = ''; }
  });
  any.addEventListener('change', function () { yearOn = !any.checked; yout.textContent = yearOn ? CM.yr(+yr.value) : 'any'; if (current) show(current); });
  yr.addEventListener('input', function () { any.checked = false; yearOn = true; yout.textContent = CM.yr(+yr.value); if (current) show(current); });
  window.addEventListener('hashchange', function () { var id = decodeURIComponent(location.hash.slice(1)); if (id !== current && CM.get(id)) show(id, false); });
})();
</script>

</body>
</html>
