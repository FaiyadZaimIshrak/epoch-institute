        <h1 class="profile-detail-name">Battle of Trafalgar</h1>
        <div class="info-stats" style="margin-top:10px;">
          <div class="info-stat"><span class="info-stat-label">Date</span><span class="info-stat-val">21 October 1805</span></div>
