<script>
// /faiths: the eighteen religions, oldest first; the faith, the one compared with it, the century and the flat map are
// kept in the address (?faith=buddhism&vs=christianity&c=7&view=flat) and the faith in this browser
(function () {
  var F = EMPIRES.filter(function (e) { return e.kind === 'religion'; }).sort(function (a, b) { return a.start - b.start || (a.name < b.name ? -1 : 1); })
    .map(function (e) { return { slug: toSlug(e.name), name: e.name, span: profileSpanText(e), url: profileUrl(e) }; });
  var list = document.getElementById('faith-list'), vs = document.getElementById('faith-vs'), host = document.getElementById('faith-map');
  list.innerHTML = F.map(function (f) {
    return '<button type="button" class="write-lang" data-f="' + f.slug + '"><img src="/logos/thumbs/' + encodeURIComponent(f.name) + '.png" alt="" width="40" height="40" loading="lazy"><span class="write-lang-t"><span class="write-lang-n">' + escHtml(f.name) + '</span><span class="write-lang-s">' + escHtml(f.span) + '</span></span></button>';
  }).join('');
  var q = new URLSearchParams(location.search), cur = null, map = null;
  function find(slug) { return F.filter(function (f) { return f.slug === slug; })[0]; }
  function save(c) {
    var p = new URLSearchParams(); p.set('faith', cur); if (vs.value) p.set('vs', vs.value); if (c != null) p.set('c', String(c));
    if (map && map.view() === 'flat') p.set('view', 'flat');
    try { history.replaceState(null, '', '?' + p.toString()); } catch (e) {}
  }
  function fillVs() {
    var keep = vs.value;
    vs.innerHTML = '<option value="">no other faith</option>' + F.filter(function (f) { return f.slug !== cur; }).map(function (f) { return '<option value="' + f.slug + '">' + escHtml(f.name) + '</option>'; }).join('');
    vs.value = keep && keep !== cur ? keep : '';
  }
  function choose(slug, other, cent, scroll) {
    var f = find(slug) || find('buddhism');
    cur = f.slug;
    Array.prototype.forEach.call(list.querySelectorAll('.write-lang'), function (b) { b.setAttribute('aria-current', String(b.getAttribute('data-f') === cur)); });
    fillVs(); if (other !== undefined) vs.value = other && other !== cur && find(other) ? other : '';
    var o = find(vs.value);
    document.getElementById('faith-t').textContent = f.name + (o ? ' and ' + o.name : '') + ' through the centuries';
    var p = document.getElementById('faith-prof'); p.href = f.url + '#faith-map'; p.innerHTML = 'The history of ' + escHtml(f.name) + ' &rarr;';
    if (!map) map = FaithMap.mount(host, cur, { compare: vs.value || null, cent: cent, view: q.get('view'), onChange: save, onView: function () { save(map.century()); } });
    else map.set(cur, vs.value || null, cent);
    try { localStorage.setItem('epoch-faith', cur); } catch (e) {}
    if (scroll && host.scrollIntoView) host.scrollIntoView({ block: 'center', behavior: 'smooth' });
  }
  list.addEventListener('click', function (e) { var b = e.target.closest('.write-lang'); if (b) choose(b.getAttribute('data-f'), vs.value === b.getAttribute('data-f') ? '' : vs.value, null, true); });
  vs.addEventListener('change', function () { choose(cur, vs.value, map ? map.century() : null); });
  var start = q.get('faith'); if (!start) { try { start = localStorage.getItem('epoch-faith'); } catch (e) {} }
  var c = parseInt(q.get('c'), 10);
  choose(start || 'buddhism', q.get('vs') || '', isNaN(c) ? null : c);
})();
</script>
