        <p class="profile-detail-region">Islamic Caliphates &amp; Middle East</p>
        <h1 class="profile-detail-name">Umayyad Caliphate</h1>
        <div class="info-stats" style="margin-top:10px;">
          <div class="info-stat"><span class="info-stat-label">Peak</span><span class="info-stat-val">710 CE</span></div>
          <div class="info-stat"><span class="info-stat-label">Duration</span><span class="info-stat-val">89 yrs</span></div>
