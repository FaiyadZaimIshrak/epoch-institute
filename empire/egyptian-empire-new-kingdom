        <h1 class="profile-detail-name">Egyptian Empire New Kingdom</h1>
        <div class="info-stats" style="margin-top:10px;">
          <div class="info-stat"><span class="info-stat-label">Peak</span><span class="info-stat-val">1370 BCE</span></div>
          <div class="info-stat"><span class="info-stat-label">Duration</span><span class="info-stat-val">480 yrs</span></div>
