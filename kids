<script>
initNav('kids');
(function () {
  // picture and fact of the day: the same for everyone on a given day, then the next one tomorrow
  var now = new Date(), day = Math.floor(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / 864e5);
  var cards = document.querySelectorAll('.kd-card'), facts = window.KIDS_FACTS || [];
  if (cards.length) {
    var c = cards[(day * 7) % cards.length], img = c.querySelector('img'), a = document.getElementById('kd-potd');
    a.href = c.getAttribute('href');
    document.getElementById('kd-potd-img').src = img.getAttribute('src');
    document.getElementById('kd-potd-t').textContent = c.querySelector('.kd-card-t').textContent;
    document.getElementById('kd-potd-d').textContent = c.querySelector('.kd-card-d').textContent;
  }
  var fi = facts.length ? day % facts.length : -1;
  function showFact() {
    var f = facts[fi], l = document.getElementById('kd-fact-link');
    document.getElementById('kd-fact').textContent = f[0];
    if (f[1]) { l.href = f[1]; l.hidden = false; } else l.hidden = true;
  }
  if (fi >= 0) {
    showFact();
    document.getElementById('kd-fact-next').addEventListener('click', function () { fi = (fi + 1) % facts.length; showFact(); });
  }
  if (cards.length || fi >= 0) document.getElementById('kd-daily').hidden = false;

  // the site-wide switch (the same as the star in the header)
  var sb = document.getElementById('kd-switch-btn'), msg = document.getElementById('kd-switch-msg');
  function paint() {
    var on = window.kidsModeOn();
    msg.textContent = on ? 'It is on: every page of the Institute looks like this one.' : 'Right now it is on only in the Kids corner.';
    sb.textContent = on ? 'Turn Kids mode off' : 'Turn on Kids mode everywhere';
    sb.className = on ? 'kd-btn kd-btn-ghost' : 'kd-btn';
    sb.hidden = false;
  }
  sb.addEventListener('click', function () { window.setKidsMode(!window.kidsModeOn()); });
  document.addEventListener('epoch:kids', paint);
  paint();
})();
</script>

</body>
</html>
