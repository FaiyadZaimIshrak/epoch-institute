<script>
initNav('home');

// ── Homepage: featured profiles (daily), browse chips, entry of the day, paths, quiz, search ──
(function () {
  function fmtYear(y) { y = Math.round(y); return y < 0 ? Math.abs(y) + ' BCE' : y + ' CE'; }
  function span(e) { return [e.points[0][0], e.points[e.points.length - 1][0]]; }
  var day = Math.floor(Date.now() / 86400000);
  function seeded(n) { var x = Math.sin(day * 9301 + n * 49297) * 233280; return x - Math.floor(x); }

  // Featured profiles: 6 per day, one from each of six different regions where possible
  var pool = EMPIRES.filter(function (e) { return typeof HOME_PICS !== 'undefined' && HOME_PICS[e.name]; })
    .map(function (e, i) { return { e: e, r: seeded(i + 1) }; }).sort(function (a, b) { return a.r - b.r; });
  var picked = [], regions = {};
  pool.forEach(function (x) { if (picked.length < 6 && !regions[x.e.region]) { picked.push(x.e); regions[x.e.region] = 1; } });
  pool.forEach(function (x) { if (picked.length < 6 && picked.indexOf(x.e) === -1) picked.push(x.e); });
  document.getElementById('featured-grid').innerHTML = picked.map(function (e) {
    var p = HOME_PICS[e.name], s = span(e), info = firstSentence(EMPIRE_INFO[e.name]);
    if (info.length > 150) info = info.slice(0, info.lastIndexOf(' ', 147)) + '…';
    return '<a class="featured-card" href="' + profileUrl(e) + '">' +
      '<span class="featured-img"><img src="' + escHtml(p.img) + '" alt="' + escHtml(p.name) + '" loading="lazy"></span>' +
      '<span class="featured-body"><span class="featured-region">' + escHtml(e.region) + '</span>' +
      '<span class="featured-name">' + escHtml(e.name) + '</span>' +
      '<span class="featured-dates">' + fmtYear(s[0]) + ' – ' + fmtYear(s[1]) + '</span>' +
      '<span class="featured-info">' + escHtml(info) + '</span></span></a>';
  }).join('');

  // Browse chips (filtered profile views)
  document.getElementById('browse-eras').innerHTML = ERA_ORDER.map(function (k) {
    return '<a class="browse-chip" href="/profiles?era=' + k + '">' + escHtml(ERA_LABELS[k]) + '</a>';
  }).join('');
  document.getElementById('browse-regions').innerHTML = REGIONS.map(function (r) {
    return '<a class="browse-chip" href="/profiles?region=' + encodeURIComponent(r) + '">' + escHtml(r) + '</a>';
  }).join('');

  // Encyclopedia entry of the day
  if (typeof HOME_ENTRIES !== 'undefined' && HOME_ENTRIES.length) {
    var en = HOME_ENTRIES[day % HOME_ENTRIES.length];
    document.getElementById('enc-day').innerHTML = '<a class="enc-day-card" href="/encyclopedia/' + en.slug + '">' +
      '<span class="enc-day-img"><img src="' + escHtml(en.img) + '" alt="' + escHtml(en.name) + '" loading="lazy"></span>' +
      '<span class="enc-day-body"><span class="featured-region">Entry of the day' + (en.dates ? ' · ' + escHtml(en.dates) : '') + '</span>' +
      '<span class="enc-day-name">' + escHtml(en.name) + '</span>' +
      '<span class="enc-day-desc">' + escHtml(en.desc) + '</span>' +
      '<span class="home-section-more">Read the entry →</span></span></a>';
  }

  // Reading paths: three, rotating daily
  if (typeof READING_PATHS !== 'undefined' && READING_PATHS.length) {
    var rp = READING_PATHS.slice(), start = day % rp.length, three = [0, 1, 2].map(function (k) { return rp[(start + k) % rp.length]; });
    document.getElementById('home-paths').innerHTML = three.map(function (p) {
      var th = p.steps.filter(function (s) { return s.img; }).slice(0, 3).map(function (s) { return '<img src="' + escHtml(s.img) + '" alt="" loading="lazy">'; }).join('');
      return '<a class="path-card" href="/paths/' + p.slug + '"><span class="path-thumbs">' + th + '</span><span class="path-card-body">' +
        '<span class="featured-region">' + p.steps.length + ' stops</span><span class="path-card-title">' + escHtml(p.title) + '</span>' +
        '<span class="path-card-tag">' + escHtml(p.tagline) + '</span></span></a>';
    }).join('');
  }

  // Continue reading: the profile last read in this browser (from the empire pages' progress tracking)
  (function () {
    var last = null; try { last = JSON.parse(localStorage.getItem('epoch-last') || 'null'); } catch (e) {}
    if (!last || !last.url || last.pct >= 95 || Date.now() - last.t > 30 * 86400000) return;
    var el = document.createElement('a'); el.className = 'continue-reading'; el.href = last.url;
    el.innerHTML = '<span class="continue-label">Continue reading</span><span class="continue-name">' + escHtml(last.name) + '</span>' +
      '<span class="continue-bar" aria-hidden="true"><span style="width:' + Math.max(5, last.pct) + '%"></span></span><span class="continue-pct">' + last.pct + '% read →</span>';
    document.querySelector('.hero-ctas').insertAdjacentElement('afterend', el);
  })();

  // Daily quiz (quiz.js; the same puzzle as on /quiz)
  if (typeof EpochQuiz !== 'undefined') {
    EpochQuiz.mount(document.getElementById('quiz'), EpochQuiz.daily(EpochQuiz.today()),
      { daily: true, titleEl: document.getElementById('quiz-title'), titlePrefix: 'Daily Quiz: ', streakEl: document.getElementById('quiz-streak'), moreHref: '/quiz' });
  }

  // Hero search opens the site search with what was typed
  var hs = document.getElementById('home-search'), hi = document.getElementById('home-search-input');
  hs.addEventListener('submit', function (e) { e.preventDefault(); openSiteSearch(hi.value); hi.value = ''; });
  hi.addEventListener('input', function () { if (hi.value.length >= 2) { var v = hi.value; hi.value = ''; openSiteSearch(v); } });
})();

// ── Article modal (announcements) ─────────────────────────────────────────────
function openAnnouncementModal(fileId, name) {
  document.getElementById('article-modal-title').textContent = name;
  document.getElementById('article-modal-meta').textContent = 'Announcement';
  document.getElementById('article-modal-frame').src =
    'https://drive.google.com/file/d/' + encodeURIComponent(fileId) + '/preview';
  const overlay = document.getElementById('article-modal');
  overlay.classList.remove('closing');
  overlay.style.display = 'flex';
  overlay.offsetHeight;
  overlay.classList.add('is-open');
  document.body.style.overflow = 'hidden';
  setTimeout(function() { var c = document.getElementById('article-modal-close'); if (c) c.focus(); }, 50);
}

(function() {
  const close = document.getElementById('article-modal-close');
  const overlay = document.getElementById('article-modal');
  function closeModal() {
    overlay.classList.remove('is-open');
    overlay.classList.add('closing');
    setTimeout(() => {
      overlay.style.display = 'none';
      overlay.classList.remove('closing');
      document.body.style.overflow = '';
      document.getElementById('article-modal-frame').src = '';
    }, 220);
  }
  close.addEventListener('click', closeModal);
  overlay.addEventListener('click', e => { if (e.target === e.currentTarget) closeModal(); });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && overlay.style.display !== 'none') closeModal();
  });
})();

// ── Announcements ─────────────────────────────────────────────────────────────
function loadAnnouncements() {
  if (!EPOCH_API_URL || EPOCH_API_URL.includes('PASTE')) {
    document.getElementById('announcements').style.display = 'none';
    return;
  }
  fetch(EPOCH_API_URL + '?action=announcements&callback=_')
    .then(r => r.text())
    .then(text => {
      const items = JSON.parse(text.replace(/^_\(/, '').replace(/\)[\s]*$/, ''));
      renderAnnouncements(Array.isArray(items) ? items : []);
    })
    .catch(() => renderAnnouncements([]));
}

function renderAnnouncements(items) {
  const section = document.getElementById('announcements');
  const grid    = document.getElementById('announcements-grid');
  const empty   = document.getElementById('announcements-empty');

  if (!items.length) {
    section.style.display = 'none';
    return;
  }

  section.style.display = '';
  empty.style.display = 'none';
  grid.innerHTML = items.map(item => {
    const isImg = /\.(png|jpe?g|gif|webp)$/i.test(item.name) || /^image\//.test(item.mimeType);
    const typeLabel = isImg ? 'Image Notice' : 'Document Notice';
    const imgHtml = isImg
      ? `<img class="announcement-card-img" src="https://lh3.googleusercontent.com/d/${encodeURIComponent(item.id)}" alt="${escHtml(item.name)}" loading="lazy">`
      : `<div class="announcement-card-img" style="display:flex;align-items:center;justify-content:center;font-size:40px;color:var(--gold);opacity:0.35;">📄</div>`;
    return `<div class="announcement-card" data-id="${escHtml(item.id)}" data-name="${escHtml(item.name)}">
      ${imgHtml}
      <div class="announcement-card-body">
        <span class="announcement-card-type">${typeLabel}</span>
        <span class="announcement-card-name">${escHtml(item.name.replace(/\.[^.]+$/, ''))}</span>
        <span class="announcement-card-cta">View →</span>
      </div>
    </div>`;
  }).join('');
}

document.getElementById('announcements-grid').addEventListener('click', e => {
  const card = e.target.closest('.announcement-card');
  if (card) openAnnouncementModal(card.dataset.id, card.dataset.name);
});

// Refresh every 5 min while visible; on tab return only if the data is stale.
const ANNOUNCEMENTS_TTL = 5 * 60 * 1000;
let _announcementsLoadedAt = 0;
function refreshAnnouncements() {
  if (document.hidden || Date.now() - _announcementsLoadedAt < ANNOUNCEMENTS_TTL) return;
  _announcementsLoadedAt = Date.now();
  loadAnnouncements();
}
refreshAnnouncements();
setInterval(refreshAnnouncements, ANNOUNCEMENTS_TTL);
document.addEventListener('visibilitychange', refreshAnnouncements);

// ── On this day ───────────────────────────────────────────────────────────────
(function() {
  var now     = new Date();
  var mm      = String(now.getMonth() + 1).padStart(2, '0');
  var dd      = String(now.getDate()).padStart(2, '0');
  var key     = mm + '-' + dd;
  var daySlug = now.toLocaleDateString('en-GB', { month: 'long' }).toLowerCase() + '-' + now.getDate();
  var PAGE_URL = 'https://the-epoch-institute.org/today-in-history/' + daySlug;
  document.getElementById('tih-more').href = '/today-in-history/' + daySlug;

  var SHARE_SVG = '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>';
  var GLOBE_SVG = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>';

  var activeDropdown = null;

  function closeAllDropdowns() {
    if (activeDropdown) { activeDropdown.style.display = 'none'; activeDropdown = null; }
  }

  document.addEventListener('click', function(e) {
    if (activeDropdown && !activeDropdown.parentNode.contains(e.target)) closeAllDropdowns();
  });

  function buildCard(ev, ddId) {
    return '<div class="tih-card tih-strip-card">' +
      '<button class="tih-share-btn" data-dd="' + ddId + '" aria-label="Share this event">' + SHARE_SVG + '</button>' +
      '<div class="tih-share-dropdown" id="' + ddId + '" style="display:none;">' +
        '<button class="tih-share-dd-item" data-action="tweet" data-dd="' + ddId + '">Post on X</button>' +
        '<button class="tih-share-dd-item" data-action="copy" data-dd="' + ddId + '">Copy link</button>' +
      '</div>' +
      '<p class="tih-year">' + escHtml(ev.yearDisplay || String(ev.year)) + '</p>' +
      '<p class="tih-title">' + escHtml(ev.title) + '</p>' +
      '<p class="tih-desc">' + escHtml(ev.description) + '</p>' + tihTags(ev) +
    '</div>';
  }

  function buildPinnedCard(day) {
    return '<div class="tih-card tih-strip-card tih-pinned-card tih-strip-pinned">' +
      '<span class="tih-pinned-icon">' + GLOBE_SVG + '</span>' +
      '<p class="tih-pinned-label">Today\'s International Day</p>' +
      '<p class="tih-pinned-title">' + escHtml(day.name) + '</p>' +
      '<p class="tih-pinned-desc">' + escHtml(day.description) + '</p>' +
    '</div>';
  }

  function renderStrip(events, intlDay) {
    if (!events.length && !intlDay) return;
    var strip   = document.getElementById('tih-strip');
    var dateEl  = document.getElementById('tih-strip-date');
    var cardsEl = document.getElementById('tih-strip-cards');

    var dow      = now.toLocaleDateString('en-GB', { weekday: 'long' });
    var fullDate = now.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
    dateEl.innerHTML =
      '<span class="tih-date-sep"></span>' +
      '<span class="tih-date-dow">' + escHtml(dow) + '</span>' +
      '<span class="tih-date-full">' + escHtml(fullDate) + '</span>' +
      '<span class="tih-date-sep"></span>';

    var count    = intlDay ? 2 : 3;
    var pool     = events.slice().sort(function() { return Math.random() - 0.5; });
    var selected = pool.slice(0, Math.min(count, pool.length));

    var html = '';
    if (intlDay) html += buildPinnedCard(intlDay);
    var evMap = {};
    selected.forEach(function(ev, i) {
      var ddId = 'strip-dd-' + i;
      html += buildCard(ev, ddId);
      evMap[ddId] = ev;
    });
    cardsEl.innerHTML = html;

    cardsEl.querySelectorAll('.tih-share-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var ddId = btn.dataset.dd;
        var ev   = evMap[ddId];
        if (navigator.share) {
          navigator.share({ title: ev.title, text: composeTweet(ev), url: PAGE_URL }).catch(function() {});
          return;
        }
        var dd = document.getElementById(ddId);
        if (dd.style.display === 'none') {
          closeAllDropdowns();
          dd.style.display = '';
          activeDropdown = dd;
        } else {
          closeAllDropdowns();
        }
      });
    });

    cardsEl.querySelectorAll('.tih-share-dd-item').forEach(function(item) {
      item.addEventListener('click', function(e) {
        e.stopPropagation();
        var ddId   = item.dataset.dd;
        var ev     = evMap[ddId];
        var action = item.dataset.action;
        if (action === 'tweet') {
          window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(composeTweet(ev)), '_blank');
          closeAllDropdowns();
        } else if (action === 'copy') {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(PAGE_URL).then(function() {
              var orig = item.textContent;
              item.textContent = '✓ Copied!';
              setTimeout(function() { item.textContent = orig; }, 2000);
            }).catch(function() {});
          }
          setTimeout(closeAllDropdowns, 2100);
        }
      });
    });

    strip.style.display = '';
  }

  // Show skeleton cards while loading
  (function() {
    var strip = document.getElementById('tih-strip');
    var cardsEl = document.getElementById('tih-strip-cards');
    var skelHtml = '';
    for (var i = 0; i < 2; i++) skelHtml += '<div class="tih-skeleton-card tih-strip-card"><div class="tih-sk-year"></div><div class="tih-sk-title"></div><div class="tih-sk-desc"></div></div>';
    cardsEl.innerHTML = skelHtml;
    strip.style.display = '';
    var dateEl = document.getElementById('tih-strip-date');
    var dowLabel = now.toLocaleDateString('en-GB', { weekday: 'long' });
    var fullDate = now.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
    dateEl.innerHTML = '<span class="tih-date-sep"></span><span class="tih-date-dow">' + escHtml(dowLabel) + '</span><span class="tih-date-full">' + escHtml(fullDate) + '</span><span class="tih-date-sep"></span>';
  })();

  Promise.all([
    fetch('/data/history.json?v=2').then(function(r) { if (!r.ok) throw new Error(); return r.json(); }),
    fetch('/data/international-days.json').then(function(r) { return r.ok ? r.json() : {}; }).catch(function() { return {}; })
  ]).then(function(results) {
    var events  = results[0][key] || [];
    var intlDay = results[1][key] || null;
    renderStrip(events, intlDay);
  }).catch(function() {
    document.getElementById('tih-strip').style.display = 'none';
  });
})();
</script>

<script>
// ── Newsletter form ──────────────────────────────────────────────────────────
(function() {
  var form = document.getElementById('newsletter-form');
  if (!form) return;
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var email = document.getElementById('newsletter-email').value.trim();
    if (!isValidEmail(email)) return;
    var btn = form.querySelector('button');
    btn.disabled = true; btn.textContent = 'Subscribing…';
    fetch(FORMSPREE_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ email: email, _subject: 'Newsletter signup', source: 'homepage' })
    }).then(function(res) {
      if (!res.ok) throw new Error('HTTP ' + res.status);
      var msg = document.getElementById('newsletter-msg');
      msg.textContent = "You're subscribed.";
      msg.style.display = 'block';
      form.style.display = 'none';
    }).catch(function() {
      btn.disabled = false; btn.textContent = 'Subscribe';
    });
  });
})();
</script>
