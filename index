    var b = box(), wk = null;
    if (cv.transferControlToOffscreen && window.Worker && window.OffscreenCanvas) { try { wk = new Worker(GLOBE_JS); } catch (e) { wk = null; } }
    if (wk) {
      var off = cv.transferControlToOffscreen(), done = false;
      // the worker could not get its files, failed or never answered: a fresh canvas (the old one belongs to the
      // worker now) and the globe drawn on the page instead
      var fallback = function () {
        if (done) return; done = true; try { wk.terminate(); } catch (e) {}
        var fresh = cv.cloneNode(false); cv.parentNode.replaceChild(fresh, cv); cv = fresh;
        onPage(box());
      };
      var timer = setTimeout(fallback, 20000);
      wk.onerror = fallback;
      wk.onmessage = function (e) {
        if (e.data.t === 'fail') { clearTimeout(timer); fallback(); return; }
        if (e.data.t !== 'ready' || done) return;
        done = true; clearTimeout(timer);
        show({ size: function (w, h, d) { wk.postMessage({ t: 'size', w: w, h: h, dpr: d }); }, colours: function (c) { wk.postMessage({ t: 'colours', colours: c }); }, run: function (on) { wk.postMessage({ t: 'run', on: on }); } });
      };
      wk.postMessage({ t: 'init', canvas: off, d3: D3, land: HOME_GLOBE_SRC, pts: pts, dpr: dpr, coarse: coarse, colours: colours(), w: b[0], h: b[1], run: live() }, [off]);
      return;
    }
    onPage(b);
  }
