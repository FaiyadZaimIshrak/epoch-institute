// ── A gentle reveal as the sections scroll in (none under reduced motion). It starts a little before a section reaches
// the screen: started only once it was inside, a quick scroll showed blank stretches where sections were still hidden ──
(function () {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
  var els = document.querySelectorAll('.home-section');
  var io = new IntersectionObserver(function (es) {
    es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
  }, { rootMargin: '0px 0px 20% 0px' });
  els.forEach(function (el) { el.classList.add('home-reveal'); io.observe(el); });
  // never leave a section hidden: if the observer has not shown one within a few seconds (a browser that throttles
  // it, a tab opened in the background), show them all
  setTimeout(function () { els.forEach(function (el) { el.classList.add('is-in'); }); }, 5000);
})();

// ── The hero globe: the world of 1000 CE, turning slowly (the flat strip stays as the instant fallback) ──
(function () {
  var cv = document.getElementById('home-globe');
  if (!cv || !cv.getContext || typeof HOME_GLOBE === 'undefined') return;
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;          // keep the still map
  if (navigator.connection && navigator.connection.saveData) return;
  // drawn by /home-globe.js: in a worker on an OffscreenCanvas where the browser can (the page stays free while it
  // turns), else on the page; the page sends the size, the theme's colours and whether the globe is on screen
  var GLOBE_JS = '/home-globe.js?v=2', D3 = '/d3-geo.js?v=1', pts = [];
  for (var i = 0; i < HOME_GLOBE.length; i += 3) pts.push([HOME_GLOBE[i] / 100, HOME_GLOBE[i + 1] / 100, HOME_GLOBE[i + 2]]);
  var coarse = matchMedia('(pointer: coarse)').matches, dpr = Math.min(coarse ? 1.5 : 2, window.devicePixelRatio || 1), onScreen = true;
  function colours() {
    var cs = getComputedStyle(document.documentElement);
    return { g: (cs.getPropertyValue('--gold-rgb') || '201,168,76').trim(), gold: (cs.getPropertyValue('--gold') || '#c9a84c').trim(), text: (cs.getPropertyValue('--text') || '#e8e0d0').trim() };
  }
  function box() {
    var a = cv.parentNode, w = a.clientWidth, h = Math.round(w * 0.56);
    if (!document.documentElement.classList.contains('home-globe-on')) cv.style.height = h + 'px';   // else the CSS box held for it
    else if (a.clientHeight) h = a.clientHeight;   // a square beside the text on wide screens, 25:14 on phones
    return [w, h];
  }
  function live() { return onScreen && !document.hidden; }
  function show(api) {   // the globe has drawn: it replaces the flat map, and follows the page from now on
    cv.removeAttribute('hidden');
    var flat = cv.parentNode.querySelector('svg'); if (flat) flat.style.display = 'none';
    var resize = function () { var b = box(); api.size(b[0], b[1], dpr); };
    if (window.ResizeObserver) new ResizeObserver(resize).observe(cv.parentNode); else window.addEventListener('resize', resize);
    var re = function () { api.colours(colours()); };
    new MutationObserver(re).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'data-kids'] });
    var mql = matchMedia('(prefers-color-scheme: light)'); if (mql.addEventListener) mql.addEventListener('change', re);
    new IntersectionObserver(function (es) { onScreen = es[0].isIntersecting; api.run(live()); }, { rootMargin: '80px' }).observe(cv);
    document.addEventListener('visibilitychange', function () { api.run(live()); });
  }
  // a script asked for again when it does not arrive (after every deploy the files come cold from the slow host)
  function load(src, cb, fail, n) {
    n = n || 0;
    var s = document.createElement('script'); s.src = src + (n ? '&again=' + n : ''); s.onload = cb;
    s.onerror = function () { s.remove(); if (n < 3) setTimeout(function () { load(src, cb, fail, n + 1); }, [500, 1500, 4000][n]); else if (fail) fail(); };
    document.head.appendChild(s);
  }
  // the globe drawn on the page itself: where there is no worker, or the worker could not get its files
  function onPage(b) {
    var go = function () { var hg = HomeGlobe(cv, { pts: pts, dpr: dpr, coarse: coarse }); hg.colours(colours()); hg.size(b[0], b[1], dpr); show(hg); hg.run(live()); };
    var again = function () {   // nothing came: keep the flat map, and try once more when the line or the tab comes back
      var retry = function () { window.removeEventListener('online', retry); document.removeEventListener('visibilitychange', vis); onPage(box()); };
      var vis = function () { if (!document.hidden) retry(); };
      window.addEventListener('online', retry); document.addEventListener('visibilitychange', vis);
    };
    var land = function (f) { if (window.ATLAS_GLOBE) f(); else load(HOME_GLOBE_SRC, f, again); };
    var globe = function () { if (window.HomeGlobe) go(); else load(GLOBE_JS, go, again); };
    if (window.d3 && window.d3.geoOrthographic) land(globe); else load(D3, function () { land(globe); }, again);
  }
