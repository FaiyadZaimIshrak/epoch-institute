      '<span class="tih-date-full">' + escHtml(fullDate) + '</span>' +
      '<span class="tih-date-sep"></span>';

    // one full row of three: the picture and the international day take a place each, events fill the rest
    var count    = Math.max(1, 3 - (pic ? 1 : 0) - (intlDay ? 1 : 0));
    // the picture is the day's anniversary event, captioned, so that event is not dealt again as a card
    var rest     = pic && hero ? events.filter(function(ev) { return ev !== hero; }) : events;
    // Kids mode leaves out the day's wars and killings (fewer cards rather than a grim one), unless that is all there is
    var gentle   = document.documentElement.getAttribute('data-kids') === '1' && typeof kidsGentle === 'function' ? rest.filter(function(ev) { return kidsGentle(ev.title, ev.description); }) : rest;
    var pool     = (gentle.length ? gentle : rest).slice().sort(function() { return Math.random() - 0.5; });
    var selected = pool.slice(0, Math.min(count, pool.length)).sort(function(a, b) { return a.year - b.year; });

    var html = '';
    if (pic) html += '<a class="tih-strip-pic" href="/today-in-history/' + daySlug + '"' + (hero ? '' : ' aria-hidden="true" tabindex="-1"') + '><img src="' + escHtml(pic) + '" alt="" loading="lazy">' +
      (hero ? '<span class="tih-strip-cap"><b>' + escHtml(hero.yearDisplay || String(hero.year)) + '</b>' + escHtml(hero.title) + '</span>' : '') + '</a>';
    if (intlDay) html += buildPinnedCard(intlDay);
    var evMap = {};
    selected.forEach(function(ev, i) {
      var ddId = 'strip-dd-' + i;
      html += buildCard(ev, ddId);
      evMap[ddId] = ev;
    });
    cardsEl.innerHTML = html;

    cardsEl.querySelectorAll('.tih-share-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var ddId = btn.dataset.dd;
        var ev   = evMap[ddId];
        if (navigator.share) {
          navigator.share({ title: ev.title, text: composeTweet(ev), url: PAGE_URL }).catch(function() {});
          return;
        }
        var dd = document.getElementById(ddId);
        if (dd.style.display === 'none') {
          closeAllDropdowns();
          dd.style.display = '';
          activeDropdown = dd;
        } else {
          closeAllDropdowns();
        }
      });
    });

    cardsEl.querySelectorAll('.tih-share-dd-item').forEach(function(item) {
      item.addEventListener('click', function(e) {
        e.stopPropagation();
        var ddId   = item.dataset.dd;
        var ev     = evMap[ddId];
        var action = item.dataset.action;
        if (action === 'tweet') {
          window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(composeTweet(ev)), '_blank');
          closeAllDropdowns();
        } else if (action === 'copy') {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(PAGE_URL).then(function() {
              var orig = item.textContent;
              item.textContent = '✓ Copied!';
              setTimeout(function() { item.textContent = orig; }, 2000);
            }).catch(function() {});
          }
          setTimeout(closeAllDropdowns, 2100);
        }
      });
    });

    strip.style.display = '';
  }

  // Show skeleton cards while loading
  (function() {
    var strip = document.getElementById('tih-strip');
    var cardsEl = document.getElementById('tih-strip-cards');
    var skelHtml = '';
    for (var i = 0; i < 2; i++) skelHtml += '<div class="tih-skeleton-card tih-strip-card"><div class="tih-sk-year"></div><div class="tih-sk-title"></div><div class="tih-sk-desc"></div></div>';
    cardsEl.innerHTML = skelHtml;
    strip.style.display = '';
    var dateEl = document.getElementById('tih-strip-date');
    var dowLabel = now.toLocaleDateString('en-GB', { weekday: 'long' });
    var fullDate = now.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
    dateEl.innerHTML = '<span class="tih-date-sep"></span><span class="tih-date-dow">' + escHtml(dowLabel) + '</span><span class="tih-date-full">' + escHtml(fullDate) + '</span><span class="tih-date-sep"></span>';
  })();

  // today's events, international day and picture: one small file per day (data/days, written by the builder)
  var DAYS_V = '0e86673aa9';
  fetch('/data/days/' + key + '.json?v=' + DAYS_V).then(function(r) { if (!r.ok) throw new Error(); return r.json(); }).then(function(d) {
    var evs = d.events || [], pic = d.pic ? d.pic[0] : null, hero = evs[d.hero];
    // Kids mode: no picture from a battle or a killing
    if (pic && hero && document.documentElement.getAttribute('data-kids') === '1' && typeof kidsGentle === 'function' && !kidsGentle(hero.title, hero.description)) pic = null;
    renderStrip(evs, d.intl || null, pic, pic ? hero : null);
    // the song of the day, from the same file: [slug, title, culture, year, a line for young readers, has its words]
    var sg = d.song, sdEl = document.getElementById('song-day');
    if (sg && sdEl) sdEl.innerHTML = '<a class="song-day-card" href="/songs/' + encodeURIComponent(sg[0]) + '"><span class="sd-k">' + escHtml(sg[3]) + ' &middot; ' + escHtml(sg[2]) + '</span>' +
      '<span class="sd-t">' + escHtml(sg[1]) + '</span><span class="sd-d">' + escHtml(sg[4]) + '</span><span class="sd-go">' + (sg[5] ? 'Read the words and listen' : 'Its story, and a performance') + ' &rarr;</span></a>' +
      (sg[6] ? '<button type="button" class="sd-listen" data-yt="' + escHtml(sg[6]) + '"><span aria-hidden="true">&#9654;</span> Play the performance' + (sg[7] ? '<span class="sd-by">' + escHtml(sg[7]) + '</span>' : '') + '</button>'
        : '<button type="button" class="sd-listen sd-wait" tabindex="-1" aria-hidden="true"><span aria-hidden="true">&#9654;</span> Play the performance</button>');   // no performance: the room stays, so nothing moves
    // the performance plays here when asked: YouTube's player (youtube-nocookie.com) loads only on the press, as on the song's page
    var sdBtn = sdEl && sdEl.querySelector('.sd-listen');
    if (sdBtn) sdBtn.addEventListener('click', function () {
      var f = document.createElement('iframe');
      f.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(sdBtn.getAttribute('data-yt')) + '?autoplay=1&rel=0';
      f.title = 'Performance: ' + sg[1]; f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.setAttribute('allowfullscreen', ''); f.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      var box = document.createElement('div'); box.className = 'sd-video'; box.appendChild(f); sdBtn.replaceWith(box);
      try { f.focus(); } catch (e) {}
    });
    // born on this day, from the same file: [slug, name, dates, thumbnail, year], the best known four in year order
    var bd = document.getElementById('born-day'), bm = document.getElementById('born-more');
    if (bm) bm.href = '/today-in-history/' + daySlug + '#day-born';
    if (bd && d.born && d.born.length) bd.innerHTML = d.born.map(function (p) {
      return '<li><a href="/encyclopedia/' + encodeURIComponent(p[0]) + '"><img src="' + escHtml(p[3]) + '" alt="" width="64" height="64" loading="lazy"><span class="bd-y">' + escHtml(p[4] < 0 ? -p[4] + ' BCE' : String(p[4])) + '</span><span class="bd-n">' + escHtml(p[1]) + '</span><span class="bd-d">' + escHtml(p[2]) + '</span></a></li>';
    }).join('');
    else if (bd) bd.closest('.home-born').hidden = true;
  }).catch(function() {
    document.getElementById('tih-strip').style.display = 'none';
  });
})();

