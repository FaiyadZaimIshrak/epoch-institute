/li><li><a href="/encyclopedia/anton-korosec"><img src="/images/encyclopedia/thumbs/anton-korosec.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Anton Korošec</span><span class="tp">1872–1940</span></span></a></li><li><a href="/encyclopedia/juho-kusti-paasikivi"><img src="/images/encyclopedia/thumbs/juho-kusti-paasikivi.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Juho Kusti Paasikivi</span><span class="tp">1870–1956</span></span></a></li><li><a href="/encyclopedia/friedrich-durrenmatt"><img src="/images/encyclopedia/thumbs/friedrich-durrenmatt.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Friedrich Dürrenmatt</span><span class="tp">1921–1990</span></span></a></li></ul></section>
