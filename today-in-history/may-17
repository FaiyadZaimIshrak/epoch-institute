<section class="day-ppl" aria-labelledby="day-died"><h2 class="ref-sec-title" id="day-died">Died on 17 May <span class="n">7</span></h2><ul class="enc-seealso"><li><a href="/encyclopedia/li-maozhen"><span class="ph ph-person" aria-hidden="true"></span><span><span class="nm">Li Maozhen</span><span class="tp">856–924</span></span></a></li><li><a href="/encyclopedia/sandro-botticelli"><img src="/images/encyclopedia/thumbs/sandro-botticelli.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Sandro Botticelli</span><span class="tp">c. 1445–1510</span></span></a></li><li><a href="/encyclopedia/edward-stafford-3rd-duke-of-buckingham"><img src="/images/encyclopedia/thumbs/edward-stafford-3rd-duke-of-buckingham.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Edward Stafford, 3rd Duke of Buckingham</span><span class="tp">1478–1521</span></span></a></li><li><a href="/encyclopedia/philipp-von-hutten"><img src="/images/encyclopedia/thumbs/philipp-von-hutten.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Philipp von Hutten</span><span class="tp">d. 1546</span></span></a></li><li><a href="/encyclopedia/armand-emmanuel-du-plessis-duc-de-richelieu"><img src="/images/encyclopedia/thumbs/armand-emmanuel-du-plessis-duc-de-richelieu.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Armand-Emmanuel du Plessis, Duc de Richelieu</span><span class="tp">1766–1822</span></span></a></li><li><a href="/encyclopedia/charles-brooke-rajah-of-sarawak"><img src="/images/encyclopedia/thumbs/charles-brooke-rajah-of-sarawak.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Charles Brooke, Rajah of Sarawak</span><span class="tp">1829–1917</span></span></a></li><li><a href="/encyclopedia/jorge-rafael-videla"><img src="/images/encyclopedia/thumbs/jorge-rafael-videla.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Jorge Rafael Videla</span><span class="tp">1925–2013</span></span></a></li></ul></section>
