<section class="day-ppl" aria-labelledby="day-died"><h2 class="ref-sec-title" id="day-died">Died on 31 October <span class="n">9</span></h2><ul class="enc-seealso"><li><a href="/encyclopedia/wolfgang-of-regensburg"><img src="/images/encyclopedia/thumbs/wolfgang-of-regensburg.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Wolfgang of Regensburg</span><span class="tp">c. 924–994</span></span></a></li><li><a href="/encyclopedia/eleanor-of-england-queen-of-castile"><img src="/images/encyclopedia/thumbs/eleanor-of-england-queen-of-castile.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Eleanor of England, Queen of Castile</span><span class="tp">1162–1214</span></span></a></li><li><a href="/encyclopedia/cornelis-jol"><img src="/images/encyclopedia/thumbs/cornelis-jol.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Cornelis Jol</span><span class="tp">1597–1641</span></span></a></li><li><a href="/encyclopedia/cosimo-iii-de-medici"><img src="/images/encyclopedia/thumbs/cosimo-iii-de-medici.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Cosimo III de' Medici</span><span class="tp">1642–1723</span></span></a></li><li><a href="/encyclopedia/victor-amadeus-ii"><img src="/images/encyclopedia/thumbs/victor-amadeus-ii.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Victor Amadeus II</span><span class="tp">1666–1732</span></span></a></li><li><a href="/encyclopedia/thomas-cochrane-10th-earl-of-dundonald"><img src="/images/encyclopedia/thumbs/thomas-cochrane-10th-earl-of-dundonald.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Thomas Cochrane, 10th Earl of Dundonald</span><span class="tp">1775–1860</span></span></a></li><li><a href="/encyclopedia/mikhail-frunze"><img src="/images/encyclopedia/thumbs/mikhail-frunze.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Mikhail Frunze</span><span class="tp">1885–1925</span></span></a></li><li><a href="/encyclopedia/sharof-rashidov"><span class="ph ph-person" aria-hidden="true"></span><span><span class="nm">Sharof Rashidov</span><span class="tp">1917–1983</span></span></a></li><li><a href="/encyclopedia/indira-gandhi"><span class="ph ph-person" aria-hidden="true"></span><span><span class="nm">Indira Gandhi</span><span class="tp">1917–1984</span></span></a></li></ul></section>
