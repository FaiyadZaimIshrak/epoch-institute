<section class="day-ppl" aria-labelledby="day-died"><h2 class="ref-sec-title" id="day-died">Died on 27 September <span class="n">6</span></h2><ul class="enc-seealso"><li><a href="/encyclopedia/raymond-vii-count-of-toulouse"><img src="/images/encyclopedia/thumbs/raymond-vii-count-of-toulouse.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Raymond VII, Count of Toulouse</span><span class="tp">1197–1249</span></span></a></li><li><a href="/encyclopedia/john-vii-count-of-nassau-siegen"><img src="/images/encyclopedia/thumbs/john-vii-count-of-nassau-siegen.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">John VII, Count of Nassau-Siegen</span><span class="tp">1561–1623</span></span></a></li><li><a href="/encyclopedia/maximilian-i-elector-of-bavaria"><img src="/images/encyclopedia/thumbs/maximilian-i-elector-of-bavaria.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Maximilian I, Elector of Bavaria</span><span class="tp">1573–1651</span></span></a></li><li><a href="/encyclopedia/pope-innocent-xii"><img src="/images/encyclopedia/thumbs/pope-innocent-xii.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Pope Innocent XII</span><span class="tp">1615–1700</span></span></a></li><li><a href="/encyclopedia/ram-mohan-roy"><img src="/images/encyclopedia/thumbs/ram-mohan-roy.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Ram Mohan Roy</span><span class="tp">1772–1833</span></span></a></li><li><a href="/encyclopedia/mohammad-najibullah"><img src="/images/encyclopedia/thumbs/mohammad-najibullah.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Mohammad Najibullah</span><span class="tp">1947–1996</span></span></a></li></ul></section>
