<section class="day-ppl" aria-labelledby="day-died"><h2 class="ref-sec-title" id="day-died">Died on 29 November <span class="n">9</span></h2><ul class="enc-seealso"><li><a href="/encyclopedia/chlothar-i"><img src="/images/encyclopedia/thumbs/chlothar-i.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Chlothar I</span><span class="tp">c. 497–561</span></span></a></li><li><a href="/encyclopedia/otto-ii-duke-of-bavaria"><img src="/images/encyclopedia/thumbs/otto-ii-duke-of-bavaria.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Otto II, Duke of Bavaria</span><span class="tp">1206–1253</span></span></a></li><li><a href="/encyclopedia/pope-clement-iv"><img src="/images/encyclopedia/thumbs/pope-clement-iv.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Pope Clement IV</span><span class="tp">c. 1190–1268</span></span></a></li><li><a href="/encyclopedia/philip-iv-of-france"><img src="/images/encyclopedia/thumbs/philip-iv-of-france.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Philip IV of France</span><span class="tp">1268–1314</span></span></a></li><li><a href="/encyclopedia/frederick-v-of-the-palatinate"><img src="/images/encyclopedia/thumbs/frederick-v-of-the-palatinate.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Frederick V of the Palatinate</span><span class="tp">1596–1632</span></span></a></li><li><a href="/encyclopedia/claudio-monteverdi"><img src="/images/encyclopedia/thumbs/claudio-monteverdi.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Claudio Monteverdi</span><span class="tp">1567–1643</span></span></a></li><li><a href="/encyclopedia/maria-theresa"><img src="/images/encyclopedia/thumbs/maria-theresa.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Maria Theresa</span><span class="tp">1717–1780</span></span></a></li><li><a href="/encyclopedia/giacomo-puccini"><img src="/images/encyclopedia/thumbs/giacomo-puccini.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Giacomo Puccini</span><span class="tp">1858–1924</span></span></a></li><li><a href="/encyclopedia/peng-dehuai"><img src="/images/encyclopedia/thumbs/peng-dehuai.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Peng Dehuai</span><span class="tp">1898–1974</span></span></a></li></ul></section>
