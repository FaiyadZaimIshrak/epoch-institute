th="44" height="44"><span><span class="nm">Umberto II</span><span class="tp">1904–1983</span></span></a></li><li><a href="/encyclopedia/fernando-de-la-rua"><img src="/images/encyclopedia/thumbs/fernando-de-la-rua.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Fernando de la Rúa</span><span class="tp">1937–2019</span></span></a></li></ul></section>
<section class="day-ppl" aria-labelledby="day-died"><h2 class="ref-sec-title" id="day-died">Died on 15 September <span class="n">5</span></h2><ul class="enc-seealso"><li><a href="/encyclopedia/louis-i-duke-of-bavaria"><span class="ph ph-person" aria-hidden="true"></span><span><span class="nm">Louis I, Duke of Bavaria</span><span class="tp">1173–1231</span></span></a></li><li><a href="/encyclopedia/isabella-jagiellon"><img src="/images/encyclopedia/thumbs/isabella-jagiellon.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Isabella Jagiellon</span><span class="tp">1519–1559</span></span></a></li><li><a href="/encyclopedia/francisco-morazan"><img src="/images/encyclopedia/thumbs/francisco-morazan.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Francisco Morazán</span><span class="tp">1792–1842</span></span></a></li><li><a href="/encyclopedia/john-hanning-speke"><img src="/images/encyclopedia/thumbs/john-hanning-speke.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">John Hanning Speke</span><span class="tp">1827–1864</span></span></a></li><li><a href="/encyclopedia/roman-von-ungern-sternberg"><img src="/images/encyclopedia/thumbs/roman-von-ungern-sternberg.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Roman von Ungern-Sternberg</span><span class="tp">1885–1921</span></span></a></li></ul></section>
