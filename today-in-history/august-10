<section class="day-ppl" aria-labelledby="day-died"><h2 class="ref-sec-title" id="day-died">Died on 10 August <span class="n">5</span></h2><ul class="enc-seealso"><li><a href="/encyclopedia/conrad-the-red"><span class="ph ph-person" aria-hidden="true"></span><span><span class="nm">Conrad the Red</span><span class="tp">d. 955</span></span></a></li><li><a href="/encyclopedia/eric-iv-of-denmark"><img src="/images/encyclopedia/thumbs/eric-iv-of-denmark.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Eric IV of Denmark</span><span class="tp">1216–1250</span></span></a></li><li><a href="/encyclopedia/francis-iii-duke-of-brittany"><img src="/images/encyclopedia/thumbs/francis-iii-duke-of-brittany.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Francis III, Duke of Brittany</span><span class="tp">1518–1536</span></span></a></li><li><a href="/encyclopedia/maarten-tromp"><img src="/images/encyclopedia/thumbs/maarten-tromp.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Maarten Tromp</span><span class="tp">1598–1653</span></span></a></li><li><a href="/encyclopedia/yahya-khan"><img src="/images/encyclopedia/thumbs/yahya-khan.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Yahya Khan</span><span class="tp">1917–1980</span></span></a></li></ul></section>
