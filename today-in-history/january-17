/li><li><a href="/encyclopedia/douglas-hyde"><img src="/images/encyclopedia/thumbs/douglas-hyde.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Douglas Hyde</span><span class="tp">1860–1949</span></span></a></li><li><a href="/encyclopedia/konstantin-stanislavski"><img src="/images/encyclopedia/thumbs/konstantin-stanislavski.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Konstantin Stanislavski</span><span class="tp">1863–1938</span></span></a></li><li><a href="/encyclopedia/tabare-vazquez"><span class="ph ph-person" aria-hidden="true"></span><span><span class="nm">Tabaré Vázquez</span><span class="tp">1940–2020</span></span></a></li></ul></section>
<section class="day-ppl" aria-labelledby="day-died"><h2 class="ref-sec-title" id="day-died">Died on 17 January <span class="n">7</span></h2><ul class="enc-seealso"><li><a href="/encyclopedia/thierry-of-alsace"><img src="/images/encyclopedia/thumbs/thierry-of-alsace.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Thierry of Alsace</span><span class="tp">c. 1099–1168</span></span></a></li><li><a href="/encyclopedia/albert-of-riga"><img src="/images/encyclopedia/thumbs/albert-of-riga.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Albert of Riga</span><span class="tp">c. 1165–1229</span></span></a></li><li><a href="/encyclopedia/martino-zaccaria"><img src="/images/encyclopedia/thumbs/martino-zaccaria.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Martino Zaccaria</span><span class="tp">d. 1345</span></span></a></li><li><a href="/encyclopedia/skanderbeg"><img src="/images/encyclopedia/thumbs/skanderbeg.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Skanderbeg</span><span class="tp">1405–1468</span></span></a></li><li><a href="/encyclopedia/big-bear"><img src="/images/encyclopedia/thumbs/big-bear.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Big Bear</span><span class="tp">c. 1825–1888</span></span></a></li><li><a href="/encyclopedia/pyotr-krasnov"><img src="/images/encyclopedia/thumbs/pyotr-krasnov.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Pyotr Krasnov</span><span class="tp">1869–1947</span></span></a></li><li><a href="/encyclopedia/patrice-lumumba"><img src="/images/encyclopedia/thumbs/patrice-lumumba.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Patrice Lumumba</span><span class="tp">1925–1961</span></span></a></li></ul></section>
