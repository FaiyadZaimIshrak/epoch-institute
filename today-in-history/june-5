<section class="day-ppl" aria-labelledby="day-died"><h2 class="ref-sec-title" id="day-died">Died on 5 June <span class="n">9</span></h2><ul class="enc-seealso"><li><a href="/encyclopedia/saint-boniface"><img src="/images/encyclopedia/thumbs/saint-boniface.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Saint Boniface</span><span class="tp">c. 675–754</span></span></a></li><li><a href="/encyclopedia/yaqub-ibn-al-layth-al-saffar"><img src="/images/encyclopedia/thumbs/yaqub-ibn-al-layth-al-saffar.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Ya'qub ibn al-Layth al-Saffar</span><span class="tp">840–879</span></span></a></li><li><a href="/encyclopedia/louis-the-blind"><img src="/images/encyclopedia/thumbs/louis-the-blind.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Louis the Blind</span><span class="tp">c. 880–928</span></span></a></li><li><a href="/encyclopedia/braccio-da-montone"><img src="/images/encyclopedia/thumbs/braccio-da-montone.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Braccio da Montone</span><span class="tp">1368–1424</span></span></a></li><li><a href="/encyclopedia/yury-of-zvenigorod"><img src="/images/encyclopedia/thumbs/yury-of-zvenigorod.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Yury of Zvenigorod</span><span class="tp">1374–1434</span></span></a></li><li><a href="/encyclopedia/lamoral-count-of-egmont"><img src="/images/encyclopedia/thumbs/lamoral-count-of-egmont.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Lamoral, Count of Egmont</span><span class="tp">1522–1568</span></span></a></li><li><a href="/encyclopedia/odysseas-androutsos"><img src="/images/encyclopedia/thumbs/odysseas-androutsos.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Odysseas Androutsos</span><span class="tp">1788–1825</span></span></a></li><li><a href="/encyclopedia/herbert-kitchener"><img src="/images/encyclopedia/thumbs/herbert-kitchener.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Herbert Kitchener</span><span class="tp">1850–1916</span></span></a></li><li><a href="/encyclopedia/ronald-reagan"><img src="/images/encyclopedia/thumbs/ronald-reagan.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Ronald Reagan</span><span class="tp">1911–2004</span></span></a></li></ul></section>
