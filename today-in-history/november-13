href="/encyclopedia/robert-louis-stevenson"><img src="/images/encyclopedia/thumbs/robert-louis-stevenson.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Robert Louis Stevenson</span><span class="tp">1850–1894</span></span></a></li><li><a href="/encyclopedia/iskander-mirza"><img src="/images/encyclopedia/thumbs/iskander-mirza.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Iskander Mirza</span><span class="tp">1899–1969</span></span></a></li><li><a href="/encyclopedia/lon-nol"><img src="/images/encyclopedia/thumbs/lon-nol.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Lon Nol</span><span class="tp">1913–1985</span></span></a></li><li><a href="/encyclopedia/andres-manuel-lopez-obrador"><img src="/images/encyclopedia/thumbs/andres-manuel-lopez-obrador.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Andrés Manuel López Obrador</span><span class="tp">b. 1953</span></span></a></li></ul></section>
