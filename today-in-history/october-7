belaunde-terry"><img src="/images/encyclopedia/thumbs/fernando-belaunde-terry.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Fernando Belaúnde Terry</span><span class="tp">1912–2002</span></span></a></li><li><a href="/encyclopedia/desmond-tutu"><img src="/images/encyclopedia/thumbs/desmond-tutu.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Desmond Tutu</span><span class="tp">1931–2021</span></span></a></li><li><a href="/encyclopedia/jakaya-kikwete"><img src="/images/encyclopedia/thumbs/jakaya-kikwete.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Jakaya Kikwete</span><span class="tp">b. 1950</span></span></a></li></ul></section>
<section class="day-ppl" aria-labelledby="day-died"><h2 class="ref-sec-title" id="day-died">Died on 7 October <span class="n">9</span></h2><ul class="enc-seealso"><li><a href="/encyclopedia/charles-the-simple"><img src="/images/encyclopedia/thumbs/charles-the-simple.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Charles the Simple</span><span class="tp">879–929</span></span></a></li><li><a href="/encyclopedia/emperor-shizong-of-liao"><span class="ph ph-person" aria-hidden="true"></span><span><span class="nm">Emperor Shizong of Liao</span><span class="tp">919–951</span></span></a></li><li><a href="/encyclopedia/qian-chu"><img src="/images/encyclopedia/thumbs/qian-chu.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Qian Chu</span><span class="tp">929–988</span></span></a></li><li><a href="/encyclopedia/ezzelino-iii-da-romano"><img src="/images/encyclopedia/thumbs/ezzelino-iii-da-romano.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Ezzelino III da Romano</span><span class="tp">1194–1259</span></span></a></li><li><a href="/encyclopedia/sigismondo-pandolfo-malatesta"><img src="/images/encyclopedia/thumbs/sigismondo-pandolfo-malatesta.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Sigismondo Pandolfo Malatesta</span><span class="tp">1417–1468</span></span></a></li><li><a href="/encyclopedia/victor-amadeus-i-duke-of-savoy"><img src="/images/encyclopedia/thumbs/victor-amadeus-i-duke-of-savoy.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Victor Amadeus I, Duke of Savoy</span><span class="tp">1587–1637</span></span></a></li><li><a href="/encyclopedia/guru-gobind-singh"><img src="/images/encyclopedia/thumbs/guru-gobind-singh.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Guru Gobind Singh</span><span class="tp">1666–1708</span></span></a></li><li><a href="/encyclopedia/alfred-deakin"><img src="/images/encyclopedia/thumbs/alfred-deakin.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Alfred Deakin</span><span class="tp">1856–1919</span></span></a></li><li><a href="/encyclopedia/ramiz-alia"><img src="/images/encyclopedia/thumbs/ramiz-alia.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Ramiz Alia</span><span class="tp">1925–2011</span></span></a></li></ul></section>
