<section class="day-ppl" aria-labelledby="day-died"><h2 class="ref-sec-title" id="day-died">Died on 23 December <span class="n">8</span></h2><ul class="enc-seealso"><li><a href="/encyclopedia/naum-of-ohrid"><img src="/images/encyclopedia/thumbs/naum-of-ohrid.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Naum of Ohrid</span><span class="tp">c. 830–910</span></span></a></li><li><a href="/encyclopedia/conrad-i-of-germany"><img src="/images/encyclopedia/thumbs/conrad-i-of-germany.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Conrad I of Germany</span><span class="tp">c. 881–918</span></span></a></li><li><a href="/encyclopedia/berengaria-of-navarre"><img src="/images/encyclopedia/thumbs/berengaria-of-navarre.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Berengaria of Navarre</span><span class="tp">c. 1165–1230</span></span></a></li><li><a href="/encyclopedia/thomas-preljubovic"><img src="/images/encyclopedia/thumbs/thomas-preljubovic.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Thomas Preljubović</span><span class="tp">d. 1384</span></span></a></li><li><a href="/encyclopedia/ngungunhane"><img src="/images/encyclopedia/thumbs/ngungunhane.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Ngungunhane</span><span class="tp">c. 1850–1906</span></span></a></li><li><a href="/encyclopedia/lavrentiy-beria"><img src="/images/encyclopedia/thumbs/lavrentiy-beria.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Lavrentiy Beria</span><span class="tp">1899–1953</span></span></a></li><li><a href="/encyclopedia/p-v-narasimha-rao"><img src="/images/encyclopedia/thumbs/p-v-narasimha-rao.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">P. V. Narasimha Rao</span><span class="tp">1921–2004</span></span></a></li><li><a href="/encyclopedia/desi-bouterse"><span class="ph ph-person" aria-hidden="true"></span><span><span class="nm">Desi Bouterse</span><span class="tp">1945–2024</span></span></a></li></ul></section>
