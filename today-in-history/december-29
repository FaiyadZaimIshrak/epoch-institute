<section class="day-ppl" aria-labelledby="day-died"><h2 class="ref-sec-title" id="day-died">Died on 29 December <span class="n">4</span></h2><ul class="enc-seealso"><li><a href="/encyclopedia/emperor-zhangzong-of-jin"><span class="ph ph-person" aria-hidden="true"></span><span><span class="nm">Emperor Zhangzong of Jin</span><span class="tp">1168–1208</span></span></a></li><li><a href="/encyclopedia/wilhelm-maybach"><img src="/images/encyclopedia/thumbs/wilhelm-maybach.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Wilhelm Maybach</span><span class="tp">1846–1929</span></span></a></li><li><a href="/encyclopedia/miroslav-krleza"><img src="/images/encyclopedia/thumbs/miroslav-krleza.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Miroslav Krleža</span><span class="tp">1893–1981</span></span></a></li><li><a href="/encyclopedia/jimmy-carter"><img src="/images/encyclopedia/thumbs/jimmy-carter.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Jimmy Carter</span><span class="tp">1924–2024</span></span></a></li></ul></section>
