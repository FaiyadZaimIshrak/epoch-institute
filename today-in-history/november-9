<section class="day-ppl" aria-labelledby="day-died"><h2 class="ref-sec-title" id="day-died">Died on 9 November <span class="n">4</span></h2><ul class="enc-seealso"><li><a href="/encyclopedia/constantine-vii"><img src="/images/encyclopedia/thumbs/constantine-vii.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Constantine VII</span><span class="tp">905–959</span></span></a></li><li><a href="/encyclopedia/emperor-gaozong-of-song"><img src="/images/encyclopedia/thumbs/emperor-gaozong-of-song.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Emperor Gaozong of Song</span><span class="tp">1107–1187</span></span></a></li><li><a href="/encyclopedia/otto-iii-duke-of-bavaria"><img src="/images/encyclopedia/thumbs/otto-iii-duke-of-bavaria.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Otto III, Duke of Bavaria</span><span class="tp">1261–1312</span></span></a></li><li><a href="/encyclopedia/ibn-saud"><img src="/images/encyclopedia/thumbs/ibn-saud.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Ibn Saud</span><span class="tp">1875–1953</span></span></a></li></ul></section>
