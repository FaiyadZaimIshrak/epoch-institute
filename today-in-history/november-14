<section class="day-ppl" aria-labelledby="day-died"><h2 class="ref-sec-title" id="day-died">Died on 14 November <span class="n">5</span></h2><ul class="enc-seealso"><li><a href="/encyclopedia/geoffrey-ii-count-of-anjou"><span class="ph ph-person" aria-hidden="true"></span><span><span class="nm">Geoffrey II, Count of Anjou</span><span class="tp">1006–1060</span></span></a></li><li><a href="/encyclopedia/alexander-nevsky"><img src="/images/encyclopedia/thumbs/alexander-nevsky.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Alexander Nevsky</span><span class="tp">1221–1263</span></span></a></li><li><a href="/encyclopedia/gottfried-wilhelm-leibniz"><img src="/images/encyclopedia/thumbs/gottfried-wilhelm-leibniz.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Gottfried Wilhelm Leibniz</span><span class="tp">1646–1716</span></span></a></li><li><a href="/encyclopedia/georg-wilhelm-friedrich-hegel"><img src="/images/encyclopedia/thumbs/georg-wilhelm-friedrich-hegel.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Georg Wilhelm Friedrich Hegel</span><span class="tp">1770–1831</span></span></a></li><li><a href="/encyclopedia/andrew-inglis-clark"><img src="/images/encyclopedia/thumbs/andrew-inglis-clark.jpg" alt="" loading="lazy" width="44" height="44"><span><span class="nm">Andrew Inglis Clark</span><span class="tp">1848–1907</span></span></a></li></ul></section>
