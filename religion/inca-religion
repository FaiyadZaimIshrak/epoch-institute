        <h1 class="profile-detail-name">Inca religion</h1>
        <div class="info-stats" style="margin-top:10px;">
          <div class="info-stat"><span class="info-stat-label">Period</span><span class="info-stat-val">c. 1200 CE – c. 1572 CE</span></div>
