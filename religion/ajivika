        <h1 class="profile-detail-name">Ājīvika</h1>
        <div class="info-stats" style="margin-top:10px;">
          <div class="info-stat"><span class="info-stat-label">Period</span><span class="info-stat-val">c. 500 BCE – c. 1346 CE</span></div>
