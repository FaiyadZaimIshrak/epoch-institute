    <section class="rise-fall" id="timeline" aria-labelledby="timeline-title">
      <h2 class="profile-section-title" id="timeline-title">Timeline</h2>
      <ol class="rf-events"><li><span class="rf-year">c. 5th century BCE</span><span class="rf-text">Siddhartha Gautama attains awakening at <a class="enc-link" href="/encyclopedia/bodh-gaya">Bodh Gaya</a> and gives his first teaching at <a class="enc-link" href="/encyclopedia/sarnath">Sarnath</a></span></li><li><span class="rf-year">c. 260 BCE</span><span class="rf-text">The Mauryan emperor <a class="enc-link" href="/encyclopedia/ashoka">Ashoka</a> turns to the Buddha’s teaching and promotes it across his empire</span></li><li><span class="rf-year">1st century BCE</span><span class="rf-text">The Pali Canon is written down in <a class="enc-link" href="/encyclopedia/sri-lanka">Sri Lanka</a>, by tradition at the Aluvihara monastery</span></li><li><span class="rf-year">1st century CE</span><span class="rf-text">Buddhism reaches <a class="enc-link" href="/encyclopedia/china">China</a> along the trade routes of <a class="enc-link" href="/encyclopedia/central-asia">Central Asia</a></span></li><li><span class="rf-year">538 or 552</span><span class="rf-text">Buddhism is brought to <a class="enc-link" href="/encyclopedia/japan">Japan</a> from the Korean kingdom of Baekje</span></li><li><span class="rf-year">c. 779</span><span class="rf-text"><a class="enc-link" href="/encyclopedia/samye">Samye</a>, the first Buddhist monastery in <a class="enc-link" href="/encyclopedia/tibet">Tibet</a>, is consecrated</span></li><li><span class="rf-year">c. 1200</span><span class="rf-text">The great monastery of <a class="enc-link" href="/encyclopedia/nalanda">Nalanda</a> is sacked, and Buddhism fades from most of <a class="enc-link" href="/encyclopedia/india">India</a></span></li><li><span class="rf-year">1956</span><span class="rf-text"><a class="enc-link" href="/encyclopedia/b-r-ambedkar">B. R. Ambedkar</a> and hundreds of thousands of his followers become Buddhists at <a class="enc-link" href="/encyclopedia/nagpur">Nagpur</a></span></li></ol>
    </section>

