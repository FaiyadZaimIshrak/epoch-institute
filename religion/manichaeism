        <h1 class="profile-detail-name">Manichaeism</h1>
        <div class="info-stats" style="margin-top:10px;">
          <div class="info-stat"><span class="info-stat-label">Period</span><span class="info-stat-val">c. 240 CE – c. 1600 CE</span></div>
