        <h1 class="profile-detail-name">Jainism</h1>
        <div class="info-stats" style="margin-top:10px;">
          <div class="info-stat"><span class="info-stat-label">Period</span><span class="info-stat-val">c. 500 BCE – present</span></div>
          <div class="info-stat"><span class="info-stat-label">Origin</span><span class="info-stat-val"><a class="enc-link" href="/encyclopedia/magadha">Magadha</a>, north-east <a class="enc-link" href="/encyclopedia/india">India</a>, 6th or 5th century BCE</span></div>
