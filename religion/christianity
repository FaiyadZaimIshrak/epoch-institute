        <h1 class="profile-detail-name">Christianity</h1>
        <div class="info-stats" style="margin-top:10px;">
          <div class="info-stat"><span class="info-stat-label">Period</span><span class="info-stat-val">c. 30 CE – present</span></div>
          <div class="info-stat"><span class="info-stat-label">Origin</span><span class="info-stat-val">Roman Judea and <a class="enc-link" href="/encyclopedia/galilee">Galilee</a>, about 30 CE</span></div>
