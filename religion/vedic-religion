        <h1 class="profile-detail-name">Vedic religion</h1>
        <div class="info-stats" style="margin-top:10px;">
          <div class="info-stat"><span class="info-stat-label">Period</span><span class="info-stat-val">c. 1500 BCE – c. 500 BCE</span></div>
