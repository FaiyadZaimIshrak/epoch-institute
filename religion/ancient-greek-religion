    <section class="rise-fall" id="timeline" aria-labelledby="timeline-title">
      <h2 class="profile-section-title" id="timeline-title">Timeline</h2>
      <ol class="rf-events"><li><span class="rf-year">14th–13th centuries BCE</span><span class="rf-text">Tablets in <a class="enc-link" href="/encyclopedia/linear-b">Linear B</a> at <a class="enc-link" href="/encyclopedia/knossos">Knossos</a> and Pylos record offerings to <a class="enc-link" href="/encyclopedia/zeus">Zeus</a>, <a class="enc-link" href="/encyclopedia/hera">Hera</a>, <a class="enc-link" href="/encyclopedia/poseidon">Poseidon</a> and <a class="enc-link" href="/encyclopedia/dionysus">Dionysus</a></span></li><li><span class="rf-year">776 BCE</span><span class="rf-text">The first Olympic Games are held in honour of <a class="enc-link" href="/encyclopedia/zeus">Zeus</a>, by tradition</span></li><li><span class="rf-year">c. 700 BCE</span><span class="rf-text"><a class="enc-link" href="/encyclopedia/homer">Homer</a>’s epics and <a class="enc-link" href="/encyclopedia/hesiod">Hesiod</a>’s <a class="enc-link" href="/encyclopedia/theogony">Theogony</a> give the gods their classic form</span></li><li><span class="rf-year">438 BCE</span><span class="rf-text"><a class="enc-link" href="/encyclopedia/phidias">Pheidias</a>’s gold and ivory statue of <a class="enc-link" href="/encyclopedia/athena">Athena</a> is dedicated in the <a class="enc-link" href="/encyclopedia/parthenon">Parthenon</a></span></li><li><span class="rf-year">399 BCE</span><span class="rf-text"><a class="enc-link" href="/encyclopedia/socrates">Socrates</a> is condemned to death in <a class="enc-link" href="/encyclopedia/athens">Athens</a> for impiety</span></li><li><span class="rf-year">392</span><span class="rf-text">The emperor Theodosius bans all pagan sacrifice and worship</span></li><li><span class="rf-year">393</span><span class="rf-text">The last ancient Olympic Games are held, by tradition</span></li><li><span class="rf-year">529</span><span class="rf-text">Justinian forbids pagans to teach; the Platonic school of <a class="enc-link" href="/encyclopedia/athens">Athens</a> closes</span></li></ol>
