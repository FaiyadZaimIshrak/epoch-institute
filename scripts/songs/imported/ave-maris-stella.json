   "stanzas": [
    [
     "Ave, maris stella,",
     "Dei mater alma,",
     "atque semper virgo,",
     "Felix cæli porta."
    ],
    [
     "Sumens illud Ave",
     "Gabrielis ore,",
     "funda nos in pace,",
     "mutans Evæ nomen."
    ],
    [
     "Solve vincla reis,",
     "profer lumen cæcis,",
     "mala nostra pelle,",
     "bona cuncta posce."
    ],
    [
     "Monstra te esse matrem,",
     "sumat per te precem",
     "qui pro nobis natus",
     "tulit esse tuus."
    ],
    [
     "Virgo singularis,",
     "inter omnes mitis,",
     "nos culpis solutos",
     "mites fac et castos."
    ],
    [
     "Vitam præsta puram,",
     "iter para tutum,",
     "ut videntes Jesum",
     "semper collætemur."
    ],
    [
     "Sit laus Deo Patri,",
     "summo Christo decus,",
     "Spiritui Sancto",
     "tribus honor unus. Amen."
    ]
   ]
  }
 }
