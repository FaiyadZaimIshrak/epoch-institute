   "credit": "Traditional student song (C. W. Kindleben's version, 1781)",
   "stanzas": [
    [
     "Gaudeamus igitur,",
     "Iuvenes dum sumus,",
     "Post molestam senectutem :,:",
     "Nos habebit humus."
    ],
    [
     "Ubi sunt, qui ante nos",
     "In mundo fuere,",
     "Vadite ad superos,",
     "Transite ad inferos,",
     "Ubi jam fuere."
    ],
    [
     "Vita nostra brevis est,",
     "Brevi finietur,",
     "Venit mors velociter,",
     "Rapit nos atrociter,",
     "Nemini parcetur."
    ],
    [
     "Vivat Academia,",
     "Vivant Professores,",
     "Vivat membrum quodlibet,",
     "Vivant membra quaelibet,",
     "Semper sint in flore!"
    ],
    [
     "Vivant omnes virgines",
     "Faciles, formosae",
     "Vivant et mulieres :,:",
     "Bonae, laboriosae."
    ],
    [
     "Vivat et respublica,",
     "Et qui illam regit,",
     "Vivat nostra civitas,",
     "Mecaenatum caritas,",
     "Quae nos hic protegit."
    ],
    [
     "Pereat tristitia,",
     "Pereant osores,",
     "Pereat diabolus,",
     "Quivis Antiburschius,",
     "Atque irrisores."
    ]
   ]
  }
 }
}