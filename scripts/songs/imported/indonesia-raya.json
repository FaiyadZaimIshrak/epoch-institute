   "stanzas": [
    [
     "Indonesia, tanah airkoe,",
     "Tanah toempah darahkoe,",
     "Disanalah akoe berdiri,",
     "Mendjaga Pandoe Iboekoe.",
     "Indonesia kebangsaankoe,",
     "Kebangsaan tanah airkoe,",
     "Marilah kita berseroe:",
     "\"Indonesia Bersatoe\"."
