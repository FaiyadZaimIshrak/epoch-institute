<script>
initNav('quiz');
(function () {
  if (typeof EpochQuiz === 'undefined') return;
  var daily = EpochQuiz.daily(EpochQuiz.today());
  EpochQuiz.mount(document.getElementById('qz-daily'), daily, { daily: true, titleEl: document.getElementById('qz-daily-kind'), streakEl: document.getElementById('qz-streak') });

  // practice: random puzzles of one category, a score for this visit and the best run kept in this browser
  var el = document.getElementById('qz-practice'), kindEl = document.getElementById('qz-practice-kind'), scoreEl = document.getElementById('qz-score');
  var cat = 'profile', seen = {}, played = 0, solved = 0, run = 0, best = 0;
  try { best = parseInt(localStorage.getItem('epoch-quiz-best') || '0', 10) || 0; } catch (e) {}
  function score() { scoreEl.textContent = played ? solved + ' of ' + played + ' solved' + (run > 1 ? ' · run of ' + run : '') + (best > 1 ? ' · best run ' + best : '') : (best > 1 ? 'Best run: ' + best : ''); }
  function next(focus) {
    var p = EpochQuiz.random(cat, seen); if (!p) return;
    seen[p.key] = 1;
    EpochQuiz.mount(el, p, { titleEl: kindEl, focus: focus, onNext: function () { next(true); }, onDone: function (won) {
      played++; if (won) { solved++; run++; if (run > best) { best = run; try { localStorage.setItem('epoch-quiz-best', String(best)); } catch (e) {} } } else run = 0;
      score();
    } });
  }
  var cats = document.getElementById('qz-cats');
  EpochQuiz.cats.forEach(function (c) {
    if (!EpochQuiz.has(c[0])) return;
    var b = document.createElement('button'); b.type = 'button'; b.textContent = c[1]; b.setAttribute('aria-pressed', c[0] === cat ? 'true' : 'false');
    b.addEventListener('click', function () {
      cat = c[0]; Array.prototype.forEach.call(cats.children, function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      next(true);
    });
    cats.appendChild(b);
  });
  score(); next(false);
})();
</script>
