phrey"><span class="ph ph-person" aria-hidden="true"></span><span><span class="nm">John Peters Humphrey</span><span class="tp">1905–1995</span></span></a></li><li><a href="/encyclopedia/martand-singh"><span class="ph ph-person" aria-hidden="true"></span><span><span class="nm">Martand Singh</span><span class="tp">1923–1995</span></span></a></li><li><a href="/encyclopedia/souphanouvong"><span class="ph ph-person" aria-hidden="true"></span><span><span class="nm">Souphanouvong</span><span class="tp">1909–1995</span></span></a></li><li><a href="/encyclopedia/david-marshall"><span class="ph ph-person" aria-hidden="true"></span><span><span class="nm">David Marshall</span><span class="tp">1908–1995</span></span></a></li></ul></section>
