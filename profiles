<style>
/* ── Profile search, filters, sort ── */
.profile-controls {
  display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px 16px;
  padding: 24px 40px 20px;
}
.profile-search-wrap {
  display: flex; flex-direction: row; align-items: center; gap: 8px; flex: 1 1 260px; max-width: 420px;
  padding: 0; position: relative;
}
.profile-search-wrap .profile-search-input { padding-right: 40px; }
.profile-filter { display: flex; flex-direction: column; gap: 4px; }
.profile-filter span { font-family: var(--font-ui); font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
.profile-filter select {
  font-family: var(--font-ui); font-size: 15px; color: var(--text); background: var(--surface);
  border: 1px solid var(--border); border-radius: 3px; padding: 9px 10px; min-width: 150px; cursor: pointer;
}
.profile-filter select:focus { border-color: var(--gold); }
.profile-count { font-family: var(--font-ui); font-size: 14px; color: var(--muted); margin: 0 0 10px auto; }
.profile-controls .compare-toggle-btn { min-height: 42px; }
.profile-reset { font: inherit; color: var(--gold); background: none; border: 0; text-decoration: underline; cursor: pointer; }
.profile-search-input {
  flex: 1; background: var(--surface); border: 1px solid var(--border);
  border-radius: 3px; padding: 10px 14px;
  font-family: var(--font-ui); font-size: 15px;
  color: var(--text); outline: none; transition: border-color 0.2s;
}
.profile-search-input::placeholder { color: var(--muted); }
.profile-search-input::-webkit-search-cancel-button { -webkit-appearance: none; display: none; }
.profile-search-input:focus { border-color: var(--gold); }
.profile-search-clear {
  background: none; border: none; cursor: pointer;
  font-size: 14px; color: var(--muted); padding: 0 4px;
  display: none; transition: color 0.2s;
}
.profile-search-clear:hover { color: var(--gold); }
.profile-search-empty {
  padding: 0 40px 32px;
  font-family: var(--font-text); font-size: 17px;
  color: var(--muted);
}
@media (max-width: 600px) {
  .profile-controls { padding: 20px 16px 16px; }
  .profile-search-wrap { max-width: none; flex-basis: 100%; }
  .profile-filter { flex: 1 1 140px; }
  .profile-filter select { min-width: 0; width: 100%; }
  .profile-count { margin: 0; flex-basis: 100%; }
  .profile-search-empty { padding: 0 16px 24px; }
  .profile-search-input { font-size: 16px; }
}

/* ── Empire cards: emblem left, name / dates / region / one-line summary right ── */
#profiles .profile-thumb-grid { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
#profiles .empire-thumb {
  flex-direction: row; align-items: flex-start; text-align: left; gap: 14px; padding: 16px;
  border-radius: 3px; background: var(--surface);
}
#profiles .thumb-logo, #profiles .thumb-logo-fallback { width: 56px; height: 56px; flex: 0 0 56px; }
.thumb-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
#profiles .thumb-name { font-family: var(--font-display); font-size: 16px; letter-spacing: 0.02em; color: var(--gold-light); line-height: 1.3; }
.thumb-dates { font-family: var(--font-ui); font-size: 13px; color: var(--muted); }
.thumb-region { font-family: var(--font-ui); font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gold); }
.thumb-info { font-family: var(--font-text); font-size: 15px; line-height: 1.5; color: var(--text); margin-top: 4px; }
@media (max-width: 600px) { #profiles .profile-thumb-grid { grid-template-columns: 1fr; gap: 10px; } }

/* ── Profiles page layout ── */
#profiles { min-height: 100vh; }
#profiles .explorer-header { padding-top: 100px; }
