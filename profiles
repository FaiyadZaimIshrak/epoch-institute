<script>
// ── Era classifier ────────────────────────────────────────────────────────────
function getEmpireEra(empire) {
  var peak = empire.points.reduce(function(m, p) { return p[1] >= m[1] ? p : m; });
  var y = peak[0];
  if (y <= -500) return 'ancient';
  if (y <= 500)  return 'classical';
  if (y <= 1400) return 'medieval';
  if (y <= 1800) return 'early-modern';
  return 'modern';
}

// ── Navigate to empire detail page ───────────────────────────────────────────
function openEmpireDetail(name) {
  window.location.href = '/empire/' + toSlug(name);
}

// ── Gallery: search, era/region filters (?era= / ?region=), sort ──────────────
var PF = { q: '', era: '', region: '', sort: 'chrono', kind: '' };
function pfYears(e) { return [e.points[0][0], e.points[e.points.length - 1][0]]; }
function pfYear(y) { y = Math.round(y); return y < 0 ? Math.abs(y) + ' BCE' : y + ' CE'; }
function pfCard(emp) {
  var safeName = escHtml(emp.name), y = pfYears(emp);
  var info = firstSentence(EMPIRE_INFO[emp.name]);
  if (info.length > 120) info = info.slice(0, info.lastIndexOf(' ', 117)) + '…';
  return '<a class="empire-thumb" href="' + profileUrl(emp) + '" data-name="' + safeName + '">' +
    '<img class="thumb-logo" src="/logos/thumbs/' + encodeURIComponent(emp.name) + '.png" alt="" loading="lazy" ' +
      'onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'">' +
    '<div class="thumb-logo-fallback" style="display:none">🏛</div>' +
    '<span class="thumb-text"><span class="thumb-name">' + safeName + '</span>' +
    '<span class="thumb-dates">' + pfYear(y[0]) + ' – ' + pfYear(y[1]) + '</span>' +
    '<span class="thumb-region">' + escHtml(emp.region) + '</span>' +
    (info ? '<span class="thumb-info">' + escHtml(info) + '</span>' : '') + '</span>' +
  '</a>';
}
function buildProfileGallery() {
  var gallery = document.getElementById('profile-gallery'), q = PF.q.toLowerCase().trim();
  var list = EMPIRES.filter(function (e) {
    return (!q || e.name.toLowerCase().indexOf(q) !== -1) && (!PF.era || getEmpireEra(e) === PF.era) && (!PF.region || e.region === PF.region) && (!PF.kind || profileKind(e) === PF.kind);
  });
  var html;
  if (PF.sort === 'chrono') {
    html = ERA_ORDER.map(function (eraKey) {
      var emps = list.filter(function (e) { return getEmpireEra(e) === eraKey; });
      if (!emps.length) return '';
      return '<div class="profile-era-group" data-era="' + eraKey + '"><h2 class="profile-era-title">' + ERA_LABELS[eraKey] + '</h2>' +
        '<div class="profile-thumb-grid">' + emps.map(pfCard).join('') + '</div></div>';
    }).join('');
  } else {
    var sorted = list.slice().sort(function (a, b) {
      if (PF.sort === 'az') return a.name.localeCompare(b.name);
      if (PF.sort === 'start') return pfYears(a)[0] - pfYears(b)[0];
      var da = pfYears(a)[1] - pfYears(a)[0], db = pfYears(b)[1] - pfYears(b)[0]; return db - da;
    });
    html = sorted.length ? '<div class="profile-era-group"><div class="profile-thumb-grid">' + sorted.map(pfCard).join('') + '</div></div>' : '';
  }
  gallery.innerHTML = html;
  document.getElementById('profile-count').textContent = list.length === EMPIRES.length ? EMPIRES.length + ' profiles' : list.length + ' of ' + EMPIRES.length + ' profiles';
  document.getElementById('profile-search-empty').style.display = list.length ? 'none' : 'block';
  document.getElementById('profile-search-clear').style.display = PF.q ? 'block' : 'none';
  // keep the URL shareable: /profiles?era=medieval&region=Europe
  var params = new URLSearchParams();
  if (PF.era) params.set('era', PF.era); if (PF.region) params.set('region', PF.region); if (PF.sort !== 'chrono') params.set('sort', PF.sort);
  history.replaceState(null, '', location.pathname + (params.toString() ? '?' + params : '') + location.hash);
}
(function () {
  var eraSel = document.getElementById('filter-era'), regSel = document.getElementById('filter-region'), sortSel = document.getElementById('filter-sort');
  var search = document.getElementById('profile-search');
  ERA_ORDER.forEach(function (k) { eraSel.insertAdjacentHTML('beforeend', '<option value="' + k + '">' + escHtml(ERA_LABELS[k]) + '</option>'); });
  REGIONS.forEach(function (r) { regSel.insertAdjacentHTML('beforeend', '<option value="' + escHtml(r) + '">' + escHtml(r) + '</option>'); });
  // Kind chips (states, cultures, ideologies…) appear once more than one kind of profile exists
  var kinds = Object.keys(PROFILE_KINDS).filter(function (k) { return EMPIRES.some(function (e) { return profileKind(e) === k; }); });
  var kindRow = document.getElementById('profile-kinds');
  if (kinds.length > 1) {
    kindRow.hidden = false;
    kindRow.innerHTML = [['', 'All']].concat(kinds.map(function (k) { return [k, PROFILE_KINDS[k].label]; })).map(function (k) {
      return '<button type="button" class="browse-chip" data-kind="' + k[0] + '" aria-pressed="' + (PF.kind === k[0]) + '">' + escHtml(k[1]) + '</button>';
    }).join('');
    kindRow.addEventListener('click', function (ev) {
      var b = ev.target.closest('[data-kind]'); if (!b) return; PF.kind = b.getAttribute('data-kind');
      kindRow.querySelectorAll('[data-kind]').forEach(function (x) { x.setAttribute('aria-pressed', x === b); }); buildProfileGallery();
    });
  }
  var params = new URLSearchParams(location.search);
  if (ERA_ORDER.indexOf(params.get('era')) !== -1) PF.era = params.get('era');
  if (REGIONS.indexOf(params.get('region')) !== -1) PF.region = params.get('region');
  if (['az', 'duration', 'start'].indexOf(params.get('sort')) !== -1) PF.sort = params.get('sort');
  eraSel.value = PF.era; regSel.value = PF.region; sortSel.value = PF.sort;
  eraSel.addEventListener('change', function () { PF.era = this.value; buildProfileGallery(); });
  regSel.addEventListener('change', function () { PF.region = this.value; buildProfileGallery(); });
  sortSel.addEventListener('change', function () { PF.sort = this.value; buildProfileGallery(); });
  search.addEventListener('input', function () { PF.q = this.value; buildProfileGallery(); });
  document.getElementById('profile-search-clear').addEventListener('click', function () { search.value = ''; PF.q = ''; buildProfileGallery(); search.focus(); });
  document.getElementById('profile-reset').addEventListener('click', function () {
    search.value = ''; PF.q = ''; PF.era = ''; PF.region = ''; eraSel.value = ''; regSel.value = ''; buildProfileGallery();
  });
})();

// ── Empire Comparison IIFE ───────────────────────────────────────────────────
(function() {
  var _compareMode = false;
  var _slotA = null, _slotB = null;

  var panel      = document.getElementById('compare-panel');
  var toggleBtn  = document.getElementById('compare-toggle-btn');
  var actions    = document.getElementById('compare-actions');
  var profilesEl = document.getElementById('profiles');
  var hint       = document.getElementById('compare-hint');

  function stripTags(s) { return (s || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim(); }

  function truncateText(text, charLimit) {
    if (text.length <= charLimit) return { out: text, hasMore: false };
    var cut = text.lastIndexOf(' ', charLimit);
    var at = cut > 20 ? cut : charLimit;
    return { out: text.slice(0, at) + '…', hasMore: true };
  }

  function empireStats(name) {
    var emp = EMPIRES.find(function(e) { return e.name === name; });
    if (!emp) return { peak: '—', duration: '—', period: '—' };
    var pts    = emp.points;
    var startY = Math.round(pts[0][0]);
    var endY   = Math.round(pts[pts.length - 1][0]);
    var peakPt = pts.reduce(function(m, p) { return p[1] >= m[1] ? p : m; });
    var peakY  = Math.round(peakPt[0]);
    var dur    = Math.abs(Math.round(endY - startY));
    function fmt(y) { return y < 0 ? Math.abs(y) + ' BCE' : y + ' CE'; }
    return { peak: fmt(peakY), duration: dur + ' yrs', period: fmt(startY) + ' – ' + fmt(endY) };
  }

  function renderSlot(slotId, name) {
    var slotEl = document.getElementById(slotId);
    if (!name) {
      var label = slotId === 'compare-slot-a' ? 'Select profile A' : 'Select profile B';
      slotEl.className = 'compare-slot compare-slot-empty';
      slotEl.innerHTML = '<span class="compare-slot-placeholder">' + label + '</span>';
      return;
    }
    var emp   = EMPIRES.find(function(e) { return e.name === name; }) || {};
    var stats = empireStats(name);
    var statsHtml = (typeof window.epochStatsCompareHTML === 'function')
      ? window.epochStatsCompareHTML(name)
      : '';

    slotEl.className = 'compare-slot compare-slot-filled';
    slotEl.innerHTML =
      '<div class="compare-slot-header">' +
        '<div class="compare-slot-identity">' +
          '<img class="compare-slot-logo" src="/logos/thumbs/' + encodeURIComponent(name) + '.png" alt="' + escHtml(name) + '" onerror="this.style.display=\'none\'">' +
          '<div>' +
            '<p class="compare-slot-region">' + escHtml(emp.region || '') + '</p>' +
            '<h3 class="compare-slot-name">' + escHtml(name) + '</h3>' +
          '</div>' +
        '</div>' +
        '<button class="compare-slot-remove" data-slot="' + slotId + '" aria-label="Remove ' + escHtml(name) + '">✕</button>' +
      '</div>' +
      '<div class="compare-slot-stats">' +
        '<div class="compare-stat-item"><span class="compare-stat-label">Peak</span><span class="compare-stat-val">' + stats.peak + '</span></div>' +
        '<div class="compare-stat-item"><span class="compare-stat-label">Duration</span><span class="compare-stat-val">' + stats.duration + '</span></div>' +
        '<div class="compare-stat-item"><span class="compare-stat-label">Period</span><span class="compare-stat-val">' + stats.period + '</span></div>' +
      '</div>' +
      statsHtml +
      '<button class="compare-view-btn" data-empire="' + escHtml(name) + '">View Full Profile →</button>';
  }

  function updatePanel() {
    var bothFilled = _slotA && _slotB;
    if (bothFilled) {
      var tweetText = _slotA + ' vs ' + _slotB + ' — two civilisations, one chart. Compare their rise and fall across five millennia. #EpochInstitute #History';
      actions.innerHTML = buildShareButton('compare-share-dd', 'https://the-epoch-institute.org/profiles', tweetText);
      attachShareListeners(actions, 'https://the-epoch-institute.org/profiles');
    } else {
      actions.innerHTML = '';
    }
    actions.style.display = bothFilled ? 'flex' : 'none';
    hint.style.display    = (!_slotA && !_slotB) ? 'block' : 'none';
  }

  function addToCompare(name) {
    if (!_slotA) {
      _slotA = name; renderSlot('compare-slot-a', _slotA);
    } else if (!_slotB && _slotA !== name) {
      _slotB = name; renderSlot('compare-slot-b', _slotB);
    } else if (_slotA === name || _slotB === name) {
      return;
    } else {
      _slotA = name; renderSlot('compare-slot-a', _slotA);
    }
    updatePanel();
  }

  function enterCompareMode() {
    _compareMode = true;
    profilesEl.classList.add('compare-mode');
    panel.classList.add('open');
    toggleBtn.classList.add('active');
    toggleBtn.textContent = '✕ Exit Compare';
  }

  function exitCompareMode() {
    _compareMode = false; _slotA = null; _slotB = null;
    profilesEl.classList.remove('compare-mode');
    panel.classList.remove('open');
    toggleBtn.classList.remove('active');
    toggleBtn.textContent = '⇄ Compare';
    renderSlot('compare-slot-a', null);
    renderSlot('compare-slot-b', null);
    updatePanel();
  }

  toggleBtn.addEventListener('click', function() {
    if (_compareMode) exitCompareMode(); else enterCompareMode();
  });

  panel.addEventListener('click', function(e) {
    var removeBtn = e.target.closest('.compare-slot-remove');
    if (removeBtn) {
      if (removeBtn.dataset.slot === 'compare-slot-a') { _slotA = null; renderSlot('compare-slot-a', null); }
      else { _slotB = null; renderSlot('compare-slot-b', null); }
      updatePanel();
      return;
    }
    var readMore = e.target.closest('.compare-read-more');
    if (readMore) {
      var uid     = readMore.dataset.uid;
      var key     = readMore.dataset.key;
      var slot    = readMore.dataset.slot;
      var name    = slot === 'compare-slot-a' ? _slotA : _slotB;
      var profile = (typeof EMPIRE_PROFILES !== 'undefined' && EMPIRE_PROFILES[name]) || {};
      var bodyEl  = document.getElementById('csb-' + uid);
      if (bodyEl) { bodyEl.textContent = stripTags(profile[key] || ''); }
      readMore.remove();
      return;
    }
    var viewBtn = e.target.closest('.compare-view-btn');
    if (viewBtn) {
      window.location.href = '/empire/' + toSlug(viewBtn.dataset.empire);
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && _compareMode) exitCompareMode();
  });

  // Intercept openEmpireDetail: in compare mode → add to slot; otherwise → navigate
  var _origOpenEmpireDetail = openEmpireDetail;
  window.openEmpireDetail = function(name) {
    if (_compareMode) { addToCompare(name); return; }
    _origOpenEmpireDetail(name);
  };
  // Cards are links to the empire pages; in compare mode a click selects the empire instead.
  document.getElementById('profile-gallery').addEventListener('click', function(e) {
    var card = e.target.closest('.empire-thumb');
    if (!card || !_compareMode) return;
    e.preventDefault();
    addToCompare(card.dataset.name.replace(/&amp;/g, '&').replace(/&quot;/g, '"'));
  });
})();

// ── Init ──────────────────────────────────────────────────────────────────────
initNav('profiles');
buildProfileGallery();
</script>

