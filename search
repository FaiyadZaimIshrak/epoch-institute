<main id="main" class="enc-page srch-page">
  <div class="enc-wrap">
    <nav class="ref-crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Search</li></ol></nav>
    <header class="enc-head">
      <span class="hero-ornament"></span>
      <h1 class="research-title">Search</h1>
      <p class="research-subtitle">Every profile, every recorded state and every encyclopedia entry, in one list, with filters for kind, region and century.</p>
    </header>
    <form class="enc-controls srch-form" id="srch-form" role="search" action="/search" method="get">
      <span class="srch-box"><input class="enc-search" id="srch-q" name="q" type="search" placeholder="A name, a place, a battle…" aria-label="Search words" autocomplete="off"><button type="submit" class="srch-go">Search</button></span>
      <div class="enc-row" id="srch-kinds" role="group" aria-label="Kind"></div>
      <div class="srch-row" id="srch-more">
        <label>Region <select id="srch-region"><option value="">All regions</option></select></label>
        <label>From <select id="srch-from" aria-label="From century"><option value="">the earliest</option></select></label>
        <label>To <select id="srch-to" aria-label="To century"><option value="">today</option></select></label>
        <label class="srch-check"><input type="checkbox" id="srch-pic"> With a picture</label>
        <button type="button" class="enc-chip" id="srch-clear" hidden>Clear filters</button>
