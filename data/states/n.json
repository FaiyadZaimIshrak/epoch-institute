a":"Scanned by Ulamm (talk · contribs), modified by Fvasconcellos (talk · contribs)","l":"CC BY-SA 2.0","s":"https://commons.wikimedia.org/wiki/File:Matabeleland.png"}},"new-sweden":{"img":"/images/states/new-sweden.jpg","cr":{"a":"Original: Odengatan Vector: Kjoonlee","l":"Public domain","s":"https://commons.wikimedia.org/wiki/File:Flag_of_Sweden_(1562%E2%80%931650).svg"}},"north-hsenwi":{"img":"/images/states/north-hsenwi.jpg","cr":{"a":"User:Jolle","l":"CC BY-SA 3.0","s":"https://commons.wikimedia.org/wiki/File:Shan_States-Map.png"}},"nuevo-santander":{"img":"/images/states/nuevo-santander.jpg","cr":{"a":"Ningyou.","l":"Public domain","s":"https://commons.wikimedia.org/wiki/File:Flag_of_Cross_of_Burgundy.svg"}},"natal-colony":{"img":"/images/states/natal-colony.jpg","cr":{"a":"Sodacan","l":"CC BY-SA 4.0","s":"https://commons.wikimedia.org/wiki/File:Flag_of_the_Natal_Colony_(1875%E2%80%931910).svg"}},"new-haven-colony":{"img":"/images/states/new-haven-colony.jpg","cr":{"a":"No machine-readable author provided. Kmusser assumed (based on copyright claims).","l":"CC BY-SA 2.5","s":"https://commons.wikimedia.org/wiki/File:Ctcolony.png"}},"nabataean-kingdom":{"img":"/images/states/nabataean-kingdom.jpg","cr":{"a":"SVG map by Ali Zifan","l":"CC BY-SA 4.0","s":"https://commons.wikimedia.org/wiki/File:Nabatean_Kingdom_(flat_map).svg"}},"new-kingdom-of-granada":{"img":"/images/states/new-kingdom-of-granada.jpg","cr":{"a":"Milenioscuro","l":"CC BY-SA 3.0","s":"https://commons.wikimedia.org/wiki/File:Colombia_(1810).svg"}},"nagod-state":{"img":"/images/states/nagod-state.jpg","cr":{"a":"Xufanc","l":"CC BY-SA 3.0","s":"https://commons.wikimedia.org/wiki/File:Nagod_state_flag.png"}},"namnetes":{"t":"Gallic people of the Loire estuary, allies of the Veneti against Caesar, who gave their name to the city of Nantes.","o":"The Namnetes lived on the north bank of the lower Loire, with a port called Condevicnum or Portus Namnetum on the site of Nantes. Strabo and Ptolemy place them between the Veneti and the Pictones, and Greek writers knew the Loire mouth as a trading point for Atlantic tin, linked to the earlier port of Corbilo.","r":"Little is known of their government. They took part in the Atlantic trade of the Armorican peoples and struck gold and silver coins of Armorican style.","e":"In 56 BCE the Namnetes sent help to the Veneti in their naval war against Caesar and shared in their defeat. Under Rome their port grew into the town of Condevicnum, renamed after the people as Namnetes, the origin of the name Nantes.","re":"Celtic polytheism","la":"Gaulish","c":"low","img":"/images/states/namnetes.jpg","cr":{"a":"World Imaging","l":"CC BY-SA 3.0","s":"https://commons.wikimedia.org/wiki/File:Coins_of_the_Namnetes.jpg"}},"nyasaland":{"img":"/images/states/nyasaland.jpg","cr":{"a":"Fry1989 eh?","l":"CC BY-SA 4.0","s":"https://commons.wikimedia.org/wiki/File:Flag_of_Nyasaland_(1925%E2%80%931964).svg"}},"northern-march":{"img":"/images/states/northern-march.jpg","cr":{"a":"Skäpperöd","l":"CC BY-SA 3.0","s":"https://commons.wikimedia.org/wiki/File:Lutizenbund.PNG"}}}