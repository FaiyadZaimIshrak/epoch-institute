:Flagge_Preu%C3%9Fen_-_Provinz_Posen_(1815).svg"}},"gaurihar-state":{"img":"/images/states/gaurihar-state.jpg","cr":{"a":"John George Bartholomew (1860–1920)","l":"Public domain","s":"https://commons.wikimedia.org/wiki/File:JaitpurKart.jpg"}},"gingee-nayaks":{"img":"/images/states/gingee-nayaks.jpg","cr":{"a":"Varungarde at English Wikipedia","l":"CC BY-SA 3.0","s":"https://commons.wikimedia.org/wiki/File:GingeeRajas_mandap.jpg"}},"guiyi-circuit":{"img":"/images/states/guiyi-circuit.jpg","cr":{"a":"SY","l":"CC BY-SA 4.0","s":"https://commons.wikimedia.org/wiki/File:Guiyi_Circuit.png"}},"gran-colombia":{"img":"/images/states/gran-colombia.jpg","cr":{"a":"HansenBCN","l":"CC BY-SA 4.0","s":"https://commons.wikimedia.org/wiki/File:Flag_of_Gran_Colombia_(1819%E2%80%931820).svg"}},"ghassanid-kingdom":{"img":"/images/states/ghassanid-kingdom.jpg","cr":{"a":"MoeyElan","l":"CC0","s":"https://commons.wikimedia.org/wiki/File:Ghassanid_Influence_Map.png"}},"griqualand-west":{"img":"/images/states/griqualand-west.jpg","cr":{"a":"Seb az86556","l":"CC BY 3.0","s":"https://commons.wikimedia.org/wiki/File:FlagGriekwalandEast.svg"}},"grand-duchy-of-lithuania":{"img":"/images/states/grand-duchy-of-lithuania.jpg","cr":{"a":"Alex Tora","l":"CC BY 3.0","s":"https://commons.wikimedia.org/wiki/File:Flag_of_the_Grand_Duchy_of_Lithuania_(1403%E2%80%931410).svg"}},"guangzhouwan":{"img":"/images/states/guangzhouwan.jpg","cr":{"a":"noUSERname","l":"Public domain","s":"https://commons.wikimedia.org/wiki/File:Flag_of_Colonial_Annam.svg"}},"gwalior-state":{"img":"/images/states/gwalior-state.jpg","cr":{"a":"Wikijunkie","l":"Public domain","s":"https://commons.wikimedia.org/wiki/File:Flag_of_Gwalior_(State).svg"}},"gojoseon":{"img":"/images/states/gojoseon.jpg","cr":{"a":"Asieon","l":"CC0","s":"https://commons.wikimedia.org/wiki/File:Old_Chos%C5%8Fn.png"}},"galindians":{"img":"/images/states/galindians.jpg","cr":{"a":"MapMaster","l":"CC BY-SA 3.0","s":"https://commons.wikimedia.org/wiki/File:Baltic_Tribes_c_1200.svg"}},"gabali":{"t":"Mountain people of the Lozère, clients of the Arverni, who gave their name to the Gévaudan.","o":"The Gabali lived on the granite plateaus and valleys of the southern Massif Central, in the modern Lozère. Caesar names them as clients of the Arverni.","r":"Pliny mentions their silver mines and their cheese, which was sold in Rome. No rulers or institutions are recorded.","e":"They took part in the revolt of Vercingetorix in 52 BCE, attacking the Helvii on the border of the Province. Under Rome their chief town was Anderitum (Javols), and their name lived on in the medieval county and bishopric of Gévaudan.","re":"Celtic polytheism","la":"Gaulish","c":"low"},"garifuna-of-saint-vincent":{"img":"/images/states/garifuna-of-saint-vincent.jpg","cr":{"a":"Agostino Brunias (ca. 1730 – 2 April 1796)","l":"Public domain","s":"https://commons.wikimedia.org/wiki/File:Black_Caribs-family-St.-Vincent_by_Augustino_Brunias.jpg"}},"golden-ambrosian-republic":{"img":"/images/states/golden-ambrosian-republic.jpg","cr":{"a":"Facquis","l":"CC BY-SA 4.0","s":"https://commons.wikimedia.org/wiki/File:Flag_of_the_Golden_Ambrosian_Republic.svg"}},"gambia-colony-and-protectorate":{"img":"/images/states/gambia-colony-and-protectorate.jpg","cr":{"a":"Thommy","l":"CC0","s":"https://commons.wikimedia.org/wiki/File:Flag_of_The_Gambia_(1889%E2%80%931965).svg"}},"gondal-state":{"img":"/images/states/gondal-state.jpg","cr":{"a":"Dr. Andreas Birken at German Wikipedia","l":"CC BY-SA 3.0 de","s":"https://commons.wikimedia.org/wiki/File:SaurashtraKart.jpg"}},"graaff-reinet-republic":{"img":"/images/states/graaff-reinet-republic.jpg","cr":{"a":"Samhanin","l":"CC0","s":"https://commons.wikimedia.org/wiki/File:Flag_of_the_Boer_republics.svg"}},"gurgum":{"img":"/images/states/gurgum.jpg","cr":{"a":"Hans van Deukeren (talk)","l":"CC BY-SA 3.0","s":"https://commons.wikimedia.org/wiki/File:NeoHittiteStates.gif"}},"grand-duchy-of-tuscany":{"img":"/images/states/grand-duchy-of