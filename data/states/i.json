org/wiki/File:Flag_of_Italy_(1861-1946)_crowned.svg"}},"imperial-abbey-of-thorn":{"img":"/images/states/imperial-abbey-of-thorn.jpg","cr":{"a":"Wim Bosmans","l":"CC BY-SA 4.0","s":"https://commons.wikimedia.org/wiki/File:Drie_Eigen.png"}},"italian-republic":{"img":"/images/states/italian-republic.jpg","cr":{"a":"See below.","l":"Public domain","s":"https://commons.wikimedia.org/wiki/File:Flag_of_Italy.svg"}},"isaaq-sultanate":{"img":"/images/states/isaaq-sultanate.jpg","cr":{"a":"Al Sheikh Abdullah Ray is a Somali","l":"CC BY-SA 4.0","s":"https://commons.wikimedia.org/wiki/File:Isaaq_Flag.svg"}},"ilercavones":{"t":"The Iberian people of the lower Ebro around Tortosa, near whose town Hibera the Scipios defeated Hasdrubal Barca in 215 BCE.","o":"The Ilercavones lived around the mouth and lower course of the Ebro, in southern Catalonia and northern Castellón, from about the 5th century BCE. Their position on the river made them a crossroads between the Iberian peoples of the north-east and those of Valencia.","r":"Little is known of their government. Their towns included Hibera, near modern Tortosa, and they lived from farming, fishing and trade along the river and coast. They minted coins with Iberian legends, and later the Roman town of Dertosa issued coins naming Hibera Iulia Ilercavonia.","e":"In 215 BCE the Scipio brothers defeated Hasdrubal Barca near Hibera, securing the Ebro for Rome. The Ilercavones were pacified by 197 BCE and absorbed into Hispania Citerior, with Dertosa becoming their main Roman town.","re":"Iberian religion","la":"Iberian","c":"low"},"iskolat":{"img":"/images/states/iskolat.jpg","cr":{"a":"Iskolata_karogas.png: Abols (Jānis Āboliņš) derivative work: Explorer09 (talk)","l":"CC BY 3.0","s":"https://commons.wikimedia.org/wiki/File:Iskolata_karogs.svg"}},"italian-eritrea":{"img":"/images/states/italian-eritrea.jpg","cr":{"a":"F l a n k e r","l":"Public domain","s":"https://commons.wikimedia.org/wiki/File:Flag_of_Italy_(1861-1946)_crowned.svg"}