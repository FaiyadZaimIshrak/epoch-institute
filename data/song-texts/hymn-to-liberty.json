  "rom": {
   "stanzas": [
    [
     "Se gnorízo apó tin kópsi",
     "tou spathioú tin tromerí,",
     "se gnorízo apó tin ópsi",
     "pou me vía metráei tin gi."
    ],
    [
     "Ap' ta kókala vgalméni",
     "ton Ellínon ta ierá,",
     "kai san próta andreioméni,",
     "chaíre, o chaíre, Eleftheriá!"
    ],
    [
     "Ekeí mésa ekatoikoúses",
     "pikraméni, entropalí,",
     "ki éna stóma akarteroúses,",
     "«éla páli», na sou pi."
    ],
    [
     "Árgeie ná'lthi ekeíni i méra,",
     "ki ítan óla siopilá,",
     "giatí ta 'skiaze i fovéra",
     "kai ta plákone i sklaviá."
    ],
    [
     "Dystychís! Parigoría",
     "móni sou émene na les",
     "perasména megaleía",
     "kai diigóntas ta na klais."
    ],
    [
     "Kai akartérei kai akartérei",
     "fileléftheri laliá,",
     "éna ektýpae t' állo chéri",
     "apó tin apelpisiá,"
    ],
    [
     "Ki élees: «Póte, a, póte vgáno",
     "to kefáli apó ts' ermiés?»",
     "Kai apokrínonto apó páno",
     "klápses, ályses, fonés."
    ],
    [
     "Tóte esíkones to vlémma",
     "mes sta kláimata tholó,",
     "kai eis to roúcho sou éstaz' aíma,",
     "plíthos aíma ellinikó."
    ],
    [
     "Me ta roúcha aimatoména",
     "xéro óti évgaines kryfá",
     "na gyrévis eis ta xéna",
     "álla chéria dynatá."
    ],
    [
     "Monachí to drómo epíres,",
     "exanálthes monachí;",
     "den eín' éfkoles oi thýres",
     "eán i chreía tes kourtalí."
    ],
    [
     "Állos sou éklapse eis ta stíthia,",
     "all' anásasi kammiá;",
     "állos sou étaxe voítheia",
     "kai se gélase friktá."
    ],
    [
     "Álloi, oïmé, sti symforá sou",
     "opoú echaíronto polý,",
     "«sýre na 'vris ta paidiá sou,",
     "sýre», élegan oi skliroí."
    ],
    [
     "Févgei opíso to podári",
     "kai ologlígoro pateí",
     "í tin pétra í to chortári",
     "pou ti dóxa sou enthymeí."
    ],
    [
     "Tapeinótatí sou gérnei",
     "i trisáthlia kefalí,",
     "san ptochoú pou thyrodérnei",
     "ki eínai város tou i zoí."
    ],
    [
     "Naí, allá tóra antipalévei",
     "káthe tékno sou me ormí,",
     "pou akatápafsta gyrévei",
     "í ti níki í ti thaní."
    ],
    [
     "Ap' ta kókala vgalméni",
     "ton Ellínon ta ierá,",
     "kai san próta andreioméni,",
     "chaíre, o chaíre, Eleftheriá!"
    ],
    [
     "Mólis eíde tin ormí sou",
     "o ouranós pou gia ts' echthroús",
     "eis ti gi ti mitrikí sou",
     "étref' ánthia kai karpoús,"
    ],
    [
     "egalínepse; kai echýthei",
     "katachthónia mia voí,",
     "kai tou Ríga sou apekríthi",
     "polemókrachti i foní."
    ],
    [
     "Óloi oi tópoi sou s' ekráxan",
     "chairetóntas se thermá,",
     "kai ta stómata efonáxan",
     "ósa aistháneto i kardiá."
    ],
    [
     "Efonáxane os t' astéria",
     "tou Ioníou kai ta nisiá,",
     "ki esikósane ta chéria",
     "gia na deíxoune chará,"
    ],
    [
     "m' ólon pou 'nai alysoméno",
     "to kathéna techniká,",
     "kai eis to métopo gramméno",
     "échei: «Pséftra Eleftheriá»."
    ],
    [
     "Gkardiaká charopoiíthei",
     "kai tou Vásigkton i gi,",
     "kai ta sídera enthymíthei",
     "pou tin édenan ki aftí."
    ],
    [
     "Ap' ton pýrgo tou fonázei,",
     "sa na léi se chairetó,",
     "kai ti chíti tou tinázei",
     "to liontári to Ispanó."
    ],
    [
     "Elafiásthi tis Anglías",
     "to thirío, kai sérnei efthýs",
     "katá t' ákra tis Rousías",
     "ta mougkrísmata ts' orgís."
    ]
   ],
