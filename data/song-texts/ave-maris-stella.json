     "nurturing mother of God,",
     "and ever virgin,",
     "happy gate of heaven."
    ],
    [
     "Taking that \"Ave\"",
     "from the mouth of Gabriel,",
     "ground us in peace,",
     "turning around the name of Eva."
    ],
    [
     "Loose the chains of the guilty,",
     "bring out light for the blind,",
     "drive away our evils,",
     "ask for all good things."
    ],
    [
     "Show yourself to be a mother:",
     "may he take up our prayer through you",
     "who, born for us,",
     "chose to be yours."
    ],
    [
     "Virgin without equal,",
     "gentle above all others,",
     "make us, loosed from our faults,",
     "gentle and chaste."
    ],
    [
     "Grant a pure life,",
     "make ready a safe road,",
     "so that, seeing Jesus,",
     "we may rejoice together for ever."
    ],
