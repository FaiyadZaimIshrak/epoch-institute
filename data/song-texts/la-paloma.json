    [
     "Cuando salí de La Habana,",
     "¡Válgame Dios!",
     "Nadie me ha visto salir",
     "si no fui yo,",
     "y una linda Guachinanga",
     "Sí, allá voy yo,",
     "que se vino tras de mí,",
     "¡Que sí, señor!"
