  "en": {
   "stanzas": [
    [
     "Calm and cheerful,",
     "brave and bold,",
     "let us sing, soldiers,",
     "the hymn to battle.",
     "At our voices",
     "let the world wonder",
     "and see in us",
     "the sons of the Cid."
    ],
    [
     "Soldiers, the fatherland",
     "calls us to battle.",
     "Let us swear by her",
     "to conquer or to die."
    ],
    [
     "Let us wield the steel,",
     "for the timid slave",
     "on the strong and brave man’s",
     "face dares not look;",
     "his hosts like smoke",
     "you will see scattered,",
     "and before our swords",
     "run swiftly away."
    ],
    [
     "The world never saw",
     "a nobler daring,",
     "nor ever saw a day",
     "greater in courage",
     "than that on which, set alight,",
     "we found ourselves on fire",
     "with what had stirred in Riego:",
     "the love of our country."
    ]
   ],
