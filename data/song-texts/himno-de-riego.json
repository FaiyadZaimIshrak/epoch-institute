 "parts": {
  "orig": {
   "stanzas": [
    [
     "Serenos, alegres,",
     "valientes y osados,",
     "cantemos, soldados,",
     "el himno a la lid.",
     "De nuestros acentos",
     "el orbe se admire",
     "y en nosotros mire",
     "los hijos del Cid"
    ],
    [
     "Soldados la patria,",
     "nos llama a la lid.",
     "Juremos por ella,",
     "vencer o morir"
    ],
    [
     "Blandamos el hierro",
     "que el tímido esclavo",
     "del fuerte, del bravo",
     "la faz no osa a ver;",
     "sus huestes cual humo",
     "veréis disipadas,",
     "y a nuestras espadas",
     "fugaces correr."
    ],
    [
     "El mundo vio nunca",
     "más noble osadía",
     "Ni vio nunca un día",
     "más grande en valor,",
     "que aquel que inflamados",
     "nos vimos del fuego",
     "que excitara en Riego",
     "de Patria el amor"
    ]
   ],
