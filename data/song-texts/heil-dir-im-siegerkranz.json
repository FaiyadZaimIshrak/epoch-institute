  "en": {
   "stanzas": [
    [
     "Hail to you in the victor’s wreath,",
     "ruler of the fatherland!",
     "Hail, Emperor, to you!",
     "Feel in the splendour of the throne",
     "the high delight in full",
     "of being the people’s darling!",
     "Hail, Emperor, to you!"
    ],
    [
     "Not horses and mounted men",
     "make safe the steep height",
     "where princes stand:",
     "love of the fatherland,",
     "love of the free man",
     "founds the ruler’s throne",
     "like a rock in the sea."
    ],
    [
     "Holy flame, glow,",
     "glow and never go out",
     "for the fatherland!",
     "Then we shall all stand",
     "bravely as one man,",
     "and gladly fight and bleed",
     "for throne and empire!"
    ],
    [
     "May trade and learning",
     "lift with courage and strength",
     "their heads on high!",
     "May the deeds of warriors and heroes",
     "find their laurel leaf",
     "faithfully kept there",
     "at your throne!"
    ],
    [
     "Be, Emperor Wilhelm, here",
     "long your people’s ornament,",
     "the pride of mankind!",
     "Feel in the splendour of the throne",
     "the high delight in full",
     "of being the people’s darling!",
     "Hail, Emperor, to you!"
    ]
   ],
