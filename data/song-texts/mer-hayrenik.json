{
 "slug": "mer-hayrenik",
 "parts": {
  "orig": {
   "stanzas": [
    [
     "Մեր Հայրենիք, ազատ անկախ,",
     "Որ ապրել է դարեդար,",
     "Յուր որդիքը արդ կանչում են",
     "Ազատ, անկախ Հայաստան։"
    ],
    [
     "Ահա եղբայր քեզ մի դրոշ,",
     "Որ իմ ձեռքով գործեցի",
     "Գիշերները ես քուն չեղա,",
     "Արտասուքով լվացի։"
    ],
    [
     "Նայիր նրան երեք գույնով,",
     "Նվիրական մեկ նշան",
     "Թող փողփողի թշնամու դեմ,",
     "Թող միշտ պանծա Հայաստան։"
    ],
    [
     "Ամենայն տեղ մահը մի է",
     "Մարդ մի անգամ պիտ մեռնի,",
     "Բայց երանի՝ որ յուր ազգի",
     "Ազատության կզոհվի։"
    ]
   ],
   "credit": "After Mikayel Nalbandian's poem (1861); the anthem's text",
   "url": "https://hy.wikisource.org/wiki/%D5%84%D5%A5%D6%80_%D5%80%D5%A1%D5%B5%D6%80%D5%A5%D5%B6%D5%AB%D6%84",
   "licence": "",
   "source": "hy",
   "page": "Մեր Հայրենիք",
   "own": false,
   "also": []
  },
  "en": {
   "stanzas": [
    [
     "Our Fatherland, free, independent,",
     "That has lived from age to age,",
     "Its sons are now calling",
     "A free, independent Armenia."
    ],
    [
     "Here, brother, is a flag for you,",
     "That I made with my own hand;",
     "The nights I did not sleep,",
     "With tears I washed it."
    ],
    [
     "Look at it, with three colours,",
     "A single sacred sign,",
     "Let it flutter against the enemy,",
     "Let Armenia ever be glorious."
    ],
    [
     "Everywhere death is the same,",
     "A man must die but once,",
     "But blessed is he who for his nation's",
     "Freedom is sacrificed."
    ]
   ],
   "credit": "Translation: The Epoch Institute",
   "own": true
  },
  "rom": {
   "stanzas": [
    [
     "Mer Hayrenikʿ, azat ankax,",
     "Or aprel ē daredar,",
     "Yur ordikʿə ard kančʿum en",
     "Azat, ankax Hayastan."
    ],
    [
     "Aha ełbayr kʿez mi droš,",
     "Or im jeṙkʿov gorcecʿi",
     "Gišernerə es kʿun čʿeła,",
     "Artasukʿov lvacʿi."
    ],
    [
     "Nayir nran erekʿ guynov,",
     "Nvirakan mek nšan",
     "Tʿoł pʿołpʿołi tʿšnamu dem,",
     "Tʿoł mišt panca Hayastan."
    ],
    [
     "Amenayn teł mahə mi ē",
     "Mard mi angam pit meṙni,",
     "Baycʿ erani, or yur azgi",
     "Azatutʿyan kzohvi."
    ]
   ],
