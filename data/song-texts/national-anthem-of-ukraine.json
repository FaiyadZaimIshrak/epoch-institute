    [
     "Šče ne vmerla Ukraina,",
     "Y slava, y volja!",
     "Šče namʺ, brattja-molodci,",
     "Usmixnetcja dolja!",
     "Zhynutʹ naši vorohy,",
     "Jakʺ rosa na sonci;",
     "Zapanujemʺ, brattja, j my",
     "U svoij storonci."
    ],
    [
     "Dušu, tilo my položymʺ",
     "Za svoju svobodu",
     "Y pokažemʺ, ščo my brattja",
     "Kozacʹkoho rodu."
    ],
    [
     "Hej-hej, brattja myle,",
     "Numo bratysja za dilo!",
     "Hej-hej pora vstaty,",
     "Pora volju dobuvaty!"
    ],
    [
     "Nalyvajko, Zaliznjakʺ",
     "Y Tarasʺ Trjasylo",
     "Klyčutʹ nasʺ yzʺ-za mohylʺ",
     "Na svjateje dilo.",
     "Yzhadajmo slavnu smertʹ",
     "Lycarstva-kozactva,",
     "Ščobʺ ne vtratytʹ marne namʺ",
     "Svojeho junactva."
    ],
    [
     "Oj Bohdane, Bohdane,",
     "Slavnyj našʺ hetʹmane!",
     "Na-ščo viddavʺ Ukrainu",
     "Moskaljamʺ pohanymʺ?!",
     "Ščobʺ vernuty ii čestʹ,",
     "Ljažemʺ holovamy,",
     "Nazovemsja Ukrainy",
     "Virnymy synamy!"
    ],
    [
     "Naši brattja Slavjane",
     "Vže za zbroju vzjalysʹ;",
     "Ne dižde nixto, ščobʺ my",
     "Po-zadu zistalysʹ.",
     "Pojednajmosʹ razomʺ vsi,",
     "Bratčyky-Slavjane:",
     "Nexaj hynutʹ vorohy,",
     "Naj volja nastane!"
    ]
   ],
