  "en": {
   "stanzas": [
    [
     "Ukraine has not yet died,",
     "Nor her glory, nor her freedom!",
     "Still upon us, brothers, brave lads,",
     "Fate will smile!",
     "Our enemies will perish",
     "Like dew in the sun;",
     "We too, brothers, shall be masters",
     "In our own land."
    ],
    [
     "Soul and body we shall lay down",
     "For our freedom",
     "And we shall show that we, brothers,",
     "Are of Cossack kin."
    ],
    [
     "Hey, hey, dear brothers,",
     "Come, let us set to the work!",
     "Hey, hey, it is time to rise,",
     "Time to win freedom!"
    ],
    [
     "Nalyvaiko, Zalizniak",
     "And Taras Triasylo",
     "Call us from beyond the graves",
     "To the holy work.",
     "Let us remember the glorious death",
     "Of the Cossack knighthood,",
     "So that we do not lose in vain",
     "Our youth."
    ],
    [
     "Oh Bohdan, Bohdan,",
     "Our glorious hetman!",
     "Why did you give Ukraine away",
     "To the vile Muscovites?!",
     "To win back her honour",
     "We shall lay down our heads,",
     "We shall call ourselves Ukraine's",
     "Faithful sons!"
    ],
    [
     "Our brothers the Slavs",
     "Have already taken up arms;",
     "No one shall live to see us",
     "Left behind.",
     "Let us all unite together,",
     "Brother Slavs:",
     "Let the enemies perish,",
     "Let freedom come!"
    ]
   ],
   "credit": "Translation: The Epoch Institute",
   "own": true
  },
  "rom": {
