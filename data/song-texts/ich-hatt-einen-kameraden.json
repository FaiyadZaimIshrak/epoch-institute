    [
     "I had a comrade,",
     "A better one you will not find.",
     "The drum beat for battle,",
     "He walked at my side",
     "In the same step and stride."
    ],
    [
     "A bullet came flying:",
     "Is it meant for me, or is it meant for you?",
     "It has torn him away,",
     "He lies at my feet",
     "As if it were a piece of me."
    ],
    [
     "He still wants to reach me his hand,",
     "While I am just loading.",
     "I cannot give you my hand,",
     "Stay you, in eternal life,",
     "My good comrade!"
    ]
