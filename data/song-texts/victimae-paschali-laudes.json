     "Victimae paschali laudes",
     "immolent Christiani."
    ],
    [
     "Agnus redemit oves:",
     "Christus innocens Patri",
     "reconciliavit peccatores."
    ],
    [
     "Mors et vita duello",
     "conflixere mirando:",
     "dux vitae mortuus,",
     "regnat vivus."
    ],
    [
     "Dic nobis Maria,",
     "quid vidisti in via?",
     "Sepulcrum Christi viventis,",
     "et gloriam vidi resurgentis:"
