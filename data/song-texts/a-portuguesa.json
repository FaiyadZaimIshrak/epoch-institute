  "en": {
   "stanzas": [
    [
     "Heroes of the sea, noble people,",
     "valiant, immortal nation,",
     "raise up today once more",
     "the splendour of Portugal!"
    ],
    [
     "Among the mists of memory,",
     "O Homeland, is felt the voice",
     "of your illustrious forefathers",
     "that shall guide you to victory!"
    ],
    [
     "To arms, to arms!",
     "Over the land, over the sea,",
     "to arms, to arms!",
     "To fight for the Homeland,",
     "against the cannons march, march!"
    ],
    [
     "Unfurl the unconquered Flag",
     "in the living light of your sky!",
     "Let Europe cry out to the whole earth:",
     "Portugal has not perished"
    ],
    [
     "Your joyful soil is kissed",
     "by the ocean, roaring with love,",
     "and your victorious Arm",
     "gave new worlds to the world!"
    ],
    [
     "To arms, to arms!",
     "Over the land, over the sea,",
     "to arms, to arms!",
     "To fight for the Homeland,",
     "against the cannons march, march!"
    ],
    [
     "Salute the Sun that is rising",
     "over a smiling future;",
     "let the echo of an affront",
     "be the signal to rise again."
    ],
    [
     "Rays of that strong dawn",
     "are like a mother's kisses,",
     "which guard us, sustain us,",
     "against the injuries of fortune."
    ],
    [
     "To arms, to arms!",
     "Over the land, over the sea,",
     "to arms, to arms!",
     "To fight for the Homeland,",
     "against the cannons march, march!"
    ]
   ],
