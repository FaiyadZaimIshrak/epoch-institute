# The pages fetch these JSON files. The server does not compress application/json, but it does compress
# text/javascript, so JSON is sent with that type (fetch().json() does not mind). Kept for a week; fetches carry ?v=.
AddType "text/javascript; charset=utf-8" .json
<IfModule mod_headers.c>
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=604800"
    Header unset Expires
  </FilesMatch>
</IfModule>
