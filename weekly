<script>
(function () {
  // the games' own records (games.js: localStorage epoch-games), by each game's day number: #1 of the Daily Ten and
  // Connections is 26 October 2026, of the Crossword 27 October, of Who Said It? 28 October, of the song game 3 November
  var G = {}; try { G = JSON.parse(localStorage.getItem('epoch-games') || '{}') || {}; } catch (e) {}
  var kids = document.documentElement.getAttribute('data-kids') === '1';
  var Q = Math.floor(Date.now() / 864e5), d0 = function (m, d) { return Math.floor(Date.UTC(2026, m, d) / 864e5); };
  var GAMES = [
    { k: 'ten', n: 'Daily Ten', day0: d0(9, 26), get: function (q) { var r = G['daily-' + q]; if (!r || !r.m) return null; var s = (r.m.match(/1/g) || []).length; return { pts: s, max: 10, t: s + '/10' + (r.m.length < 10 ? ' so far' : ''), sq: r.m }; } },
    { k: 'conn', n: 'Connections', day0: d0(9, 26), get: function (q, num) { var r = G['conn-' + num]; if (!r) return null; var f = (r.s || []).length, m = r.m || 0;
      return { pts: f, max: 4, t: f === 4 ? 'Solved' + (m ? ', ' + m + (m === 1 ? ' mistake' : ' mistakes') : ', no mistakes') : r.done ? f + ' of 4 groups' : f + ' of 4 so far', sq: f === 4 ? '1' : '0' }; } },
    { k: 'cw', n: 'Crossword', day0: d0(9, 27), get: function (q, num) { var r = G['cw-' + num]; if (!r) return null; var t = r.t || 0, mm = Math.floor(t / 60) + ':' + ('0' + (t % 60)).slice(-2);
      if (r.gave) return { pts: 0, max: 1, t: 'Answers shown', sq: '0' }; if (!r.done) return { pts: 0, max: 1, t: 'In progress', sq: '0' };
      return { pts: 1, max: 1, t: mm + ((r.r || 0) ? ', with reveals' : (r.c || 0) ? ', with checks' : ', no help'), sq: '1' }; } },
    { k: 'said', n: 'Who Said It?', day0: d0(9, 28), get: function (q, num) { var r = G['said-' + num]; if (!r || !r.m) return null; var s = (r.m.match(/1/g) || []).length; return { pts: s, max: 5, t: s + '/5' + (r.m.length < 5 ? ' so far' : ''), sq: r.m }; } },
    { k: 'song', n: 'Song game', day0: d0(10, 3), get: function (q, num) { var r = G['songq-' + (kids ? 'k' : '') + num]; if (!r || !r.m) return null; var s = (r.m.match(/1/g) || []).length; return { pts: s, max: 5, t: s + '/5' + (r.m.length < 5 ? ' so far' : ''), sq: r.m }; } },
    { k: 'six', n: 'Six Degrees', day0: d0(10, 6), get: function (q, num) { var r = G['sixd-' + num]; if (!r) return null; if (r.gave) return { pts: 0, max: 1, t: 'Route shown', sq: '0' }; if (!r.done) return { pts: 0, max: 1, t: (r.c || 0) + ' clicks so far', sq: '0' }; return { pts: 1, max: 1, t: 'Solved in ' + r.c + ' clicks', sq: '1' }; } }];
  var esc = typeof escHtml === 'function' ? escHtml : function (s) { return String(s); };
  var rows = [], tot = GAMES.map(function () { return { days: 0, pts: 0, max: 0 }; }), played = 0;
  for (var k = 6; k >= 0; k--) {
    var q = Q - k, date = new Date(q * 864e5), lbl = k === 0 ? 'Today' : k === 1 ? 'Yesterday' : date.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'short', timeZone: 'UTC' });
    var any = false, cells = GAMES.map(function (g, i) {
      var num = q - g.day0 + 1; if (num < 1) return '<td class="wk-na">&ndash;</td>';
      var r = g.get(q, num); if (!r) return '<td class="wk-none">' + (k === 0 ? '<a href="/games#' + { ten: 'first-daily', conn: 'conn', cw: 'cross', said: 'said', song: 'songq', six: 'six' }[g.k] + '">Play</a>' : 'Not played') + '</td>';
      any = true; tot[i].days++; tot[i].pts += r.pts; tot[i].max += r.max;
      return '<td class="wk-done"><span class="wk-sq" aria-hidden="true">' + String(r.sq).split('').map(function (c) { return c === '1' ? '&#x1F7E9;' : '&#x1F7E5;'; }).join('') + '</span>' + esc(r.t) + '</td>';
    });
    if (any) played++;
    rows.push('<tr' + (k === 0 ? ' class="wk-today"' : '') + '><th scope="row">' + esc(lbl) + '</th>' + cells.join('') + '</tr>');
  }
  document.getElementById('wk-body').innerHTML = rows.join('');
  document.getElementById('wk-n').textContent = played + ' of 7 days played';
  var lines = GAMES.map(function (g, i) { var t = tot[i]; return t.days ? g.n + ': ' + t.days + (t.days === 1 ? ' day, ' : ' days, ') + t.pts + ' of ' + t.max : ''; }).filter(Boolean);
  document.getElementById('wk-sum').textContent = lines.length ? 'This week: ' + lines.join('; ') + '.' : 'No daily game played this week yet: today’s are waiting.';
  // share: the week as one poster (share-card.js rows: a line per game) and as text
  var sb = document.getElementById('wk-share'); if (!played || !sb) return;
  sb.hidden = false;
  var spec = { title: 'My week of history games', score: String(played), unit: 'of 7 days played', rows: GAMES.map(function (g, i) { var t = tot[i]; return [g.n, t.days + ' of 7 days', t.days ? t.pts + '/' + t.max : '–']; }), url: 'the-epoch-institute.org/weekly', kids: kids };
  var poster = null;
  sb.addEventListener('pointerenter', function () { if (!poster && typeof scoreCard === 'function') poster = scoreCard(spec); }, { once: true });
  sb.addEventListener('click', function () {
    if (!poster && typeof scoreCard === 'function') poster = scoreCard(spec);
    var text = 'My week of history games at The Epoch Institute: ' + played + ' of 7 days played. ' + lines.join('; ') + '.';
    if (typeof sharePoster === 'function') sharePoster({ text: text, url: 'https://the-epoch-institute.org/weekly', title: 'My week of history games', heading: 'Share your week', image: poster, file: 'epoch-week.jpg', alt: 'My week of history games' });
  });
})();
</script>
