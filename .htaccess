ErrorDocument 404 /404.html

# Serve extensionless files as HTML
<FilesMatch "^(index|about|research|research-series|profiles|community|contributors|dataset|explorer|connections|atlas|quiz|contact|start|games|kids|search|timeline|passport|write|faiths|flashcards|race)$">
  ForceType text/html
</FilesMatch>
DirectoryIndex index
AddType font/woff2 .woff2

# One address per page (301): www -> apex, /index -> its folder, a trailing slash on a page -> without, old .html
# addresses -> clean ones. THE_REQUEST is the visitor's own request line, so the internal DirectoryIndex lookup of
# /folder/ -> /folder/index is not redirected.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*/)?)index(?:\.html)?[?\s]
  RewriteRule ^ /%1 [R=301,L]
  RewriteRule ^(about|research|research-series|profiles|community|contributors|dataset|explorer|today-in-history|encyclopedia|paths|connections|state)\.html$ /$1 [R=301,L]
  RewriteRule ^empire/([a-z0-9-]+)\.html$ /empire/$1 [R=301,L]
  RewriteRule ^epoch-institute-empire-dataset\.(csv|json)$ /epoch-institute-power-curves.$1 [R=301,L]
  RewriteRule ^(encyclopedia|state|today-in-history|countries|centuries|paths|speeches|years|people|teachers)$ /$1/ [R=301,L]
  RewriteRule ^essays/?$ /research-series [R=301,L]
  RewriteRule ^articles/?$ /community [R=301,L]
  # the profile folders have no index page: their kind's list on /profiles
  RewriteRule ^(religion|language)/?$ /profiles?kind=$1 [R=301,L]
  RewriteRule ^empire/?$ /profiles [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]
</IfModule>

# Caching. Scripts and styles are referenced with ?v=N (cache-buster), so they can be kept for a year; the shared
# files that generated pages load without ?v= are kept for 10 minutes and then refreshed in the background (block
# below). HTML is always revalidated.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType text/javascript         "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 month"
  ExpiresByType image/jpeg              "access plus 1 month"
  ExpiresByType image/webp              "access plus 1 month"
  ExpiresByType image/svg+xml           "access plus 1 month"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType application/json        "access plus 1 week"
  ExpiresByType application/xml         "access plus 1 day"
  ExpiresByType text/xml                "access plus 1 day"
  ExpiresByType text/plain              "access plus 1 day"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "^(shared\.css|shared-data\.js|shared-nav\.js|enc-page\.js|scribe\.js|faith-map\.js|test-yourself\.js)$">
    Header set Cache-Control "public, max-age=600, stale-while-revalidate=86400"
    Header unset Expires
  </FilesMatch>
</IfModule>
