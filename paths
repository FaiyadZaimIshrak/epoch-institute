<body>

<main class="paths-page" id="main">
  <div id="paths-index">
    <header class="paths-head">
      <span class="hero-ornament"></span>
      <h1 class="research-title">Reading Paths</h1>
      <p class="research-subtitle">Curated routes through the profiles and the encyclopedia. Pick a theme and follow it across empires, people and events.</p>
    </header>
    <div class="paths-grid" id="paths-grid"></div>
  </div>
  <article class="path-view" id="path-view" hidden></article>
</main>

<script src="/shared-data.js?v=6"></script>
<script src="/shared-nav.js?v=18"></script>
<script src="/reading-paths.js?v=1"></script>
<script>
initNav('paths');
(function () {
  var data = (typeof READING_PATHS !== 'undefined') ? READING_PATHS : [];
  var bySlug = {}; data.forEach(function (p) { bySlug[p.slug] = p; });
  function thumbs(p) {
    return p.steps.filter(function (s) { return s.img; }).slice(0, 3).map(function (s) { return '<img src="' + escHtml(s.img) + '" alt="" loading="lazy">'; }).join('');
  }
  document.getElementById('paths-grid').innerHTML = data.map(function (p) {
    return '<a class="path-card" href="#' + p.slug + '"><span class="path-thumbs">' + thumbs(p) + '</span>' +
      '<span class="path-card-body"><span class="featured-region">' + p.steps.length + ' stops</span>' +
      '<span class="path-card-title">' + escHtml(p.title) + '</span><span class="path-card-tag">' + escHtml(p.tagline) + '</span></span></a>';
  }).join('');
  function render(p) {
    var i = data.indexOf(p), next = data[(i + 1) % data.length];
    document.getElementById('path-view').innerHTML =
      '<a class="path-back" href="#index">← All reading paths</a>' +
      '<div class="path-head"><p class="featured-region">Reading path · ' + p.steps.length + ' stops</p><h1 class="path-title">' + escHtml(p.title) + '</h1>' +
      '<p class="path-intro">' + escHtml(p.intro) + '</p></div>' +
      '<ol class="path-steps">' + p.steps.map(function (s, n) {
        return '<li><a class="path-step" href="' + escHtml(s.href) + '">' +
          (s.img ? '<img src="' + escHtml(s.img) + '" alt="" loading="lazy">' : '<span class="path-step-ph">' + (n + 1) + '</span>') +
          '<span class="path-step-body"><span class="path-step-kind">' + (n + 1) + ' · ' + escHtml(s.meta) + '</span>' +
          '<span class="path-step-name">' + escHtml(s.name) + '</span><span class="path-step-why">' + escHtml(s.why) + '</span></span></a></li>';
      }).join('') + '</ol>' +
      (next && next !== p ? '<a class="path-next" href="#' + next.slug + '">Next path: ' + escHtml(next.title) + ' →</a>' : '');
    document.title = p.title + ' — Reading Paths — The Epoch Institute';
  }
  function route() {
    var p = bySlug[decodeURIComponent(location.hash.slice(1))], idx = document.getElementById('paths-index'), view = document.getElementById('path-view');
    if (p) { render(p); idx.hidden = true; view.hidden = false; window.scrollTo(0, 0); }
    else { idx.hidden = false; view.hidden = true; document.title = 'Reading Paths — The Epoch Institute'; }
  }
  window.addEventListener('hashchange', route); route();
})();
</script>

</body>
