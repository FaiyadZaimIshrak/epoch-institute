<body>
<main id="main" class="wf-page">

<section id="contributors" class="wf-wrap">
  <span class="hero-ornament"></span>
  <h1 class="research-title">Write for the Institute</h1>
  <p class="research-subtitle">Historians, students and curious readers help the Institute grow. There are three ways to take part.</p>

  <ol class="wf-ways">
    <li><a class="wf-way" href="/community#submit"><span class="wf-n">1</span><b>Publish an article</b><span>Send a finished essay on history, society or civilisation. It is read by the Institute before it appears in the Community pages.</span><em>Submit an article &rarr;</em></a></li>
    <li><a class="wf-way" href="#apply"><span class="wf-n">2</span><b>Join as a contributor</b><span>Research and write new profiles, encyclopedia entries and essays together with the research team.</span><em>Apply below &rarr;</em></a></li>
    <li><a class="wf-way" href="/contact?topic=correction"><span class="wf-n">3</span><b>Send a correction</b><span>Every page has a &#8220;Suggest a correction&#8221; link at its foot. Corrections keep the work accurate.</span><em>Suggest a correction &rarr;</em></a></li>
  </ol>

  <div class="wf-apply" id="apply">
    <div class="wf-apply-text">
      <h2 class="wf-title">Apply to contribute</h2>
      <p class="wf-lead">Tell us who you are and what you would like to work on. Academic, independent or student: all backgrounds are welcome.</p>
      <ol class="wf-steps">
        <li><b>Apply</b> <span>with your interests and background, in five minutes.</span></li>
        <li><b>Talk with us</b> <span>about a first piece that suits you.</span></li>
        <li><b>Publish</b> <span>your work on the site, under your name.</span></li>
      </ol>
    </div>
    <div class="wf-form-box">
      <form class="modal-form" id="apply-form" novalidate>
        <div class="wf-two">
          <div class="form-row">
            <label class="form-label" for="ap-name">Full name <span class="form-required">*</span></label>
            <input class="form-input" id="ap-name" type="text" placeholder="Your full name" autocomplete="name">
          </div>
          <div class="form-row">
            <label class="form-label" for="ap-role">Role or title <span class="form-required">*</span></label>
            <input class="form-input" id="ap-role" type="text" placeholder="e.g. PhD candidate, teacher">
          </div>
        </div>
        <div class="form-row">
          <label class="form-label" for="ap-region">Country or region <span class="form-required">*</span></label>
          <input class="form-input" id="ap-region" type="text" placeholder="e.g. United Kingdom, Bangladesh">
        </div>
        <div class="form-row">
          <label class="form-label" for="ap-area">Research interests <span class="form-required">*</span></label>
          <textarea class="form-input form-textarea" id="ap-area" placeholder="e.g. South Asian history · maritime empires · medieval Europe"></textarea>
        </div>
        <div class="form-row">
          <label class="form-label" for="ap-message">Why would you like to contribute?</label>
          <textarea class="form-input form-textarea" id="ap-message" placeholder="A little about yourself and what you would like to write…"></textarea>
        </div>
        <button type="submit" class="form-submit" id="ap-submit">Send my application &rarr;</button>
        <p class="ct-status" id="ap-status" role="status" aria-live="polite"></p>
      </form>
      <div class="wf-done" id="ap-success" tabindex="-1" hidden>
        <p class="wf-done-title">Thank you: your application has been received.</p>
        <p>We will be in touch about a first piece. Meanwhile, browse the <a href="/profiles">profiles</a> to see what the Institute publishes.</p>
      </div>
    </div>
  </div>

  <h2 class="wf-title wf-list-title">Contributors</h2>
  <p class="contributors-loading" id="contributors-loading">Loading contributors…</p>
  <div class="contributors-grid" id="contributors-grid" style="display:none;"></div>
</section>

</main>

<script src="/shared-data.js"></script>
<script src="/shared-nav.js"></script>
<script>
initNav('contributors');

// ── Contributors (from the contributors' sheet; cached for a day) ──────────────
(function () {
  var loading = document.getElementById('contributors-loading'), grid = document.getElementById('contributors-grid');
  var CACHE_KEY = 'epoch_contributors', CACHE_TTL = 24 * 60 * 60 * 1000;
  var FALLBACK = [{ name: 'The Epoch Institute Research Team', role: 'Core research', region: 'International', area: 'Profiles · Encyclopedia · States register' }];
  function initials(name) { return (name || '?').split(' ').slice(0, 2).map(function (w) { return w[0]; }).join(''); }
  function render(list) {
    loading.style.display = 'none';
    if (!list || !list.length) list = FALLBACK;
    grid.style.display = 'grid';
    grid.innerHTML = list.map(function (c) {
      var avatar = c.photoUrl ? '<img src="' + escHtml(c.photoUrl) + '" alt="' + escHtml(c.name || '') + '" onerror="this.style.display=\'none\'">' : escHtml(initials(c.name));
      return '<div class="contributor-card visible"><div class="contributor-avatar">' + avatar + '</div>' +
        '<p class="contributor-name">' + escHtml(c.name || 'Anonymous') + '</p>' +
        '<p class="contributor-role">' + escHtml(c.role || c.profession || 'Contributor') + '</p>' +
        ((c.flag || c.region) ? '<p class="contributor-role contributor-region">' + escHtml((c.flag ? c.flag + ' ' : '') + (c.region || '')) + '</p>' : '') +
        (c.area ? '<p class="contributor-bio">' + escHtml(c.area) + '</p>' : '') + '</div>';
    }).join('') +
      '<a class="contributor-card visible contributor-join" href="#apply"><div class="contributor-avatar">+</div><p class="contributor-name">Your name here</p><p class="contributor-bio">Apply to contribute</p></a>';
  }
  if (typeof CONTRIB_URL === 'undefined' || !CONTRIB_URL) return render([]);
  try { var c = JSON.parse(localStorage.getItem(CACHE_KEY) || 'null'); if (c && Date.now() - c.ts < CACHE_TTL) return render(c.data); } catch (e) {}
  fetch(CONTRIB_URL + '?action=contributors').then(function (r) { return r.json(); }).then(function (list) {
    var data = Array.isArray(list) ? list : [];
    try { localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), data: data })); } catch (e) {}
    render(data);
  }).catch(function () { render([]); });
})();

// ── Apply to contribute ────────────────────────────────────────────────────────
(function () {
  var REQ = ['ap-name', 'ap-role', 'ap-region', 'ap-area'];
  REQ.forEach(function (id) { document.getElementById(id).addEventListener('input', function () { var el = document.getElementById(id); el.classList.remove('form-input-error'); el.removeAttribute('aria-invalid'); }); });
  document.getElementById('apply-form').addEventListener('submit', function (e) {
    e.preventDefault();
    var v = {}; REQ.concat('ap-message').forEach(function (id) { v[id] = document.getElementById(id).value.trim(); });
    var first = null;
    REQ.forEach(function (id) { var bad = !v[id], el = document.getElementById(id); el.classList.toggle('form-input-error', bad); bad ? el.setAttribute('aria-invalid', 'true') : el.removeAttribute('aria-invalid'); if (bad && !first) first = el; });
    var status = document.getElementById('ap-status');
    if (first) { status.textContent = 'Please fill in the marked fields.'; first.focus(); return; }
    var btn = document.getElementById('ap-submit'); btn.disabled = true; btn.textContent = 'Sending…'; status.textContent = '';
    fetch(CONTRIB_APPLY_URL, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'text/plain' },
      body: JSON.stringify({ name: v['ap-name'], role: v['ap-role'], region: v['ap-region'], area: v['ap-area'], message: v['ap-message'] }) })
      .then(function () { e.target.hidden = true; var d = document.getElementById('ap-success'); d.hidden = false; d.focus(); })
      .catch(function () { btn.disabled = false; btn.innerHTML = 'Send my application &rarr;'; status.textContent = 'Your application could not be sent. Please try again in a moment.'; });
  });
})();
</script>

</body>
