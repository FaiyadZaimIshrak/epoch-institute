<script>
initNav('contact');
(function () {
  var TOPICS = {
    correction: { label: 'a correction', step: 'Tell us what is wrong', hint: 'Which page, what it says, and what it should say. A source helps us check it quickly.', ph: 'The page says … but it should say … (source: …)', subject: 'Correction' },
    suggest: { label: 'a suggestion', step: 'What should we add?', hint: 'A state, empire, person, event or theme you would like the Institute to cover, and why it matters.', ph: 'I would like to read about …', subject: 'Suggestion' },
    write: { label: 'writing for us', step: 'Your idea', hint: 'Finished article? <a href="/community#submit">Submit it on the Community page</a>. Want to join as a contributor? <a href="/contributors">Apply here</a>. Or tell us your idea below.', ph: 'I would like to write about …', subject: 'Writing for the Institute' },
    data: { label: 'our data and images', step: 'How would you like to use them?', hint: 'Our data is free under CC BY 4.0 (<a href="/dataset">Open Data</a>); pictures carry their own licences, shown under each one.', ph: 'I am working on … and would like to …', subject: 'Data and images' },
    press: { label: 'press and partnerships', step: 'Tell us about your project', hint: 'Who you are, what you have in mind, and any dates.', ph: 'I am writing from … about …', subject: 'Press and partnerships' },
    other: { label: 'your message', step: 'Your message', hint: 'Questions, feedback, or just to say hello.', ph: 'Write your message…', subject: 'Message' }
  };
  var form = document.getElementById('ct-form'), msg = document.getElementById('ct-message'), pageRow = document.getElementById('ct-page-row'), page = document.getElementById('ct-page');
  var topic = 'other';
  function setTopic(t, focus) {
    if (!TOPICS[t]) return; topic = t; var d = TOPICS[t];
    document.getElementById('ct-step2').textContent = d.step;
    document.getElementById('ct-hint').innerHTML = d.hint;
    msg.placeholder = d.ph;
    pageRow.hidden = t !== 'correction';
    document.getElementById('ct-subject').value = d.subject + ' — The Epoch Institute';
    var r = form.querySelector('input[name="topic"][value="' + t + '"]'); if (r) r.checked = true;
    if (focus) (t === 'correction' && !page.value ? page : document.getElementById('ct-name')).focus({ preventScroll: true });
  }
  form.querySelectorAll('input[name="topic"]').forEach(function (r) { r.addEventListener('change', function () { setTopic(r.value, false); }); });
  // ?topic=correction&page=/state/x (the "Suggest a correction" link in every page's footer)
  var q = new URLSearchParams(location.search);
  if (q.get('page')) page.value = q.get('page').replace(/[^\w\-\/.#?=&%]/g, '');
  if (TOPICS[q.get('topic')]) setTopic(q.get('topic'), false); else document.getElementById('ct-subject').value = 'Message — The Epoch Institute';

  function err(id, bad) { document.getElementById(id + '-err').hidden = !bad; var el = document.getElementById(id); el.classList.toggle('form-input-error', bad); bad ? el.setAttribute('aria-invalid', 'true') : el.removeAttribute('aria-invalid'); return bad; }
  ['ct-name', 'ct-email', 'ct-message'].forEach(function (id) { document.getElementById(id).addEventListener('input', function () { err(id, false); }); });
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var name = document.getElementById('ct-name').value.trim(), email = document.getElementById('ct-email').value.trim(), text = msg.value.trim();
    var bad = [err('ct-name', !name), err('ct-email', !isValidEmail(email)), err('ct-message', text.length < 15)];
    var firstBad = ['ct-name', 'ct-email', 'ct-message'][bad.indexOf(true)]; if (firstBad) { document.getElementById(firstBad).focus(); return; }
    var btn = document.getElementById('ct-send'), status = document.getElementById('ct-status');
    btn.disabled = true; btn.textContent = 'Sending…'; status.textContent = '';
    var body = { name: name, email: email, topic: TOPICS[topic].subject, message: text, _subject: document.getElementById('ct-subject').value, _gotcha: form.querySelector('.ct-hp').value };
    if (topic === 'correction' && page.value.trim()) body.page = page.value.trim();
    fetch(FORMSPREE_URL, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(body) })
      .then(function (res) {
        if (!res.ok) throw new Error('HTTP ' + res.status);
        form.hidden = true;
        document.getElementById('ct-done-title').textContent = 'Thank you, ' + name.split(' ')[0] + '.';
        document.getElementById('ct-done-text').textContent = (topic === 'other' ? 'Your message' : 'Your message about ' + TOPICS[topic].label) + ' is with the research team. We will reply to ' + email + '.';
        var done = document.getElementById('ct-done'); done.hidden = false; done.focus();
      })
      .catch(function () {
        btn.disabled = false; btn.innerHTML = 'Send message &rarr;';
        status.innerHTML = 'Your message could not be sent. Please try again, or write to <b>research@the-epoch-institute.org</b>.';
      });
  });
  // newsletter in the thank-you panel
  document.getElementById('ct-nl').addEventListener('submit', function (e) {
    e.preventDefault();
    var em = document.getElementById('ct-nl-email').value.trim(), st = document.getElementById('ct-nl-status');
    if (!isValidEmail(em)) { st.textContent = 'Please enter a valid email address.'; return; }
    fetch(FORMSPREE_URL, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ email: em, _subject: 'Newsletter signup', source: 'contact page' }) })
      .then(function (res) { if (!res.ok) throw new Error(); e.target.querySelector('.ct-nl-row').hidden = true; st.textContent = 'Subscribed. Thank you!'; })
      .catch(function () { st.textContent = 'That did not work; please try again later.'; });
  });
  // copy an address (mail links do nothing for readers without a mail program)
  document.querySelectorAll('.ct-copy').forEach(function (b) {
    b.addEventListener('click', function () {
      var t = b.getAttribute('data-copy');
      function ok() { b.textContent = 'Copied ✓'; setTimeout(function () { b.textContent = 'Copy'; }, 1600); }
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(t).then(ok, function () { selectText(b.previousElementSibling); });
      else selectText(b.previousElementSibling);
    });
  });
  function selectText(el) { var r = document.createRange(); r.selectNodeContents(el); var s = getSelection(); s.removeAllRanges(); s.addRange(r); }
})();
</script>
