<body>

<main class="fp-page" id="main">
  <nav class="ref-crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Find Your Way In</li></ol></nav>
  <header class="ref-head">
    <span class="hero-ornament"></span>
    <h1 class="research-title">Find your way in</h1>
    <p class="ref-lede">Five thousand years is a lot of history. Answer four quick questions and we will suggest the reader you are, the reading paths that fit, and the tools worth opening first. Nothing leaves your browser.</p>
  </header>

  <form id="fp-form" novalidate>
    <fieldset class="fp-q">
      <legend>1 · What pulls you into a history?</legend>
      <div class="fp-opts" data-q="pull">
        <label class="fp-opt"><input type="radio" name="pull" value="strategist"><span><b>Power and war</b><i>Campaigns, conquest, the rise and fall of the mighty</i></span></label>
        <label class="fp-opt"><input type="radio" name="pull" value="navigator"><span><b>Journeys and trade</b><i>Routes, ships, caravans and the places they joined</i></span></label>
        <label class="fp-opt"><input type="radio" name="pull" value="thinker"><span><b>Ideas and beliefs</b><i>Religions, laws, sciences and how they spread</i></span></label>
        <label class="fp-opt"><input type="radio" name="pull" value="chronicler"><span><b>People and their lives</b><i>Rulers, rebels, writers and the stories they made</i></span></label>
        <label class="fp-opt"><input type="radio" name="pull" value="builder"><span><b>Cities and daily life</b><i>Markets, builders, institutions and how societies ran</i></span></label>
        <label class="fp-opt"><input type="radio" name="pull" value="timekeeper"><span><b>The whole sweep</b><i>How it all fits together, age after age</i></span></label>
      </div>
    </fieldset>

    <fieldset class="fp-q">
      <legend>2 · Which age calls loudest?</legend>
      <div class="fp-opts" data-q="era">
        <label class="fp-opt"><input type="radio" name="era" value="ancient"><span><b>The deep past</b><i>First cities to the classical world</i></span></label>
        <label class="fp-opt"><input type="radio" name="era" value="medieval"><span><b>The middle ages</b><i>Roughly 500 to 1400</i></span></label>
        <label class="fp-opt"><input type="radio" name="era" value="earlymodern"><span><b>Early modern</b><i>Gunpowder, sail and print, 1400 to 1800</i></span></label>
        <label class="fp-opt"><input type="radio" name="era" value="modern"><span><b>The modern world</b><i>Revolutions to the present</i></span></label>
        <label class="fp-opt"><input type="radio" name="era" value="all"><span><b>All of it</b><i>No favourites</i></span></label>
      </div>
    </fieldset>

    <fieldset class="fp-q">
      <legend>3 · How do you like to read?</legend>
      <div class="fp-opts" data-q="pace">
        <label class="fp-opt"><input type="radio" name="pace" value="short"><span><b>Short visits</b><i>A fact, a puzzle, a page at a time</i></span></label>
        <label class="fp-opt"><input type="radio" name="pace" value="long"><span><b>Long reads</b><i>Settle in and follow a story to the end</i></span></label>
      </div>
    </fieldset>

    <fieldset class="fp-q">
      <legend>4 · A part of the world you care most about? <span class="fp-opt-note">(optional)</span></legend>
      <div class="fp-opts fp-opts-sm" data-q="region">
        <label class="fp-opt"><input type="radio" name="region" value="africa"><span><b>Africa</b></span></label>
        <label class="fp-opt"><input type="radio" name="region" value="americas"><span><b>The Americas</b></span></label>
        <label class="fp-opt"><input type="radio" name="region" value="eastasia"><span><b>East Asia</b></span></label>
        <label class="fp-opt"><input type="radio" name="region" value="southasia"><span><b>South Asia</b></span></label>
        <label class="fp-opt"><input type="radio" name="region" value="europe"><span><b>Europe</b></span></label>
        <label class="fp-opt"><input type="radio" name="region" value="mideast"><span><b>The Middle East</b></span></label>
        <label class="fp-opt"><input type="radio" name="region" value=""><span><b>Everywhere</b></span></label>
      </div>
    </fieldset>

    <p class="fp-err" id="fp-err" hidden>Choose an answer for the first three questions.</p>
    <button type="submit" class="hero-cta fp-go">Show me my way in →</button>
  </form>

  <section class="fp-result" id="fp-result" hidden aria-live="polite">
    <p class="fp-kicker">Your reader type</p>
    <h2 class="fp-type" id="fp-type"></h2>
    <p class="fp-blurb" id="fp-blurb"></p>
    <h3 class="fp-sub">Reading paths chosen for you</h3>
    <div class="paths-grid fp-paths" id="fp-paths"></div>
    <h3 class="fp-sub">Tools worth opening first</h3>
    <div class="fp-tools" id="fp-tools"></div>
    <div class="fp-actions">
      <button type="button" class="hero-cta" id="fp-save">Save these to My shelf</button>
      <button type="button" class="hero-secondary-cta" id="fp-retake">Retake the questions</button>
    </div>
    <p class="fp-note">Your answers and type are kept only in this browser.</p>
  </section>
</main>

<script src="/shared-nav.js?v=25"></script>
<script>
initNav('start');
(function () {
  var TYPES = {
    strategist: { n: 'The Strategist', b: 'You read history for power: how it is won, wielded and lost. Campaign maps, succession crises and the slow arithmetic of empires are your country.',
      paths: ['how-empires-fall', 'the-crusades', 'steppe-empires'], tools: [['/explorer', 'Empire Explorer', 'The rise and fall of 394 powers on one chart'], ['/atlas', 'Atlas', 'Watch borders breathe across five millennia']] },
    navigator: { n: 'The Navigator', b: 'You follow the routes: the silk, the sails, the caravans and the harbours. For you, history is a map with the trade winds drawn in.',
      paths: ['silk-road', 'age-of-sail', 'city-states-and-leagues'], tools: [['/atlas', 'Atlas', 'The world in any year, on a turning globe'], ['/countries/', 'Country Histories', 'Every land, through all the states that held it']] },
    thinker: { n: 'The Thinker', b: 'You want the ideas underneath: the faiths, the laws, the sciences, and how a thought crosses a border no army could.',
      paths: ['religion-and-power', 'science-and-learning', 'law-and-government'], tools: [['/encyclopedia/glossary', 'Glossary', '721 historical terms, explained'], ['/quiz', 'History Quiz', 'A new puzzle every day']] },
    chronicler: { n: 'The Chronicler', b: 'You read for the people: the rulers and rebels, the lives behind the dates. History, for you, is biography at scale.',
      paths: ['women-who-ruled', 'the-age-of-revolutions', 'india-through-the-ages'], tools: [['/encyclopedia/', 'Encyclopedia', '31,000+ people, places and events'], ['/today-in-history/', 'Today in History', 'What happened on each day of the year']] },
    builder: { n: 'The Builder', b: 'You care how societies actually ran: the markets and ports, the councils and guilds, the cities that outlasted the kings who taxed them.',
      paths: ['city-states-and-leagues', 'law-and-government', 'silk-road'], tools: [['/countries/', 'Country Histories', 'Lands and the states built on them'], ['/state/', 'States', 'All 5,468 states of the register']] },
    timekeeper: { n: 'The Timekeeper', b: 'You want the long view: patterns across centuries, the same tides rising under different flags. Breadth first, then depth.',
      paths: ['how-empires-fall', 'china-dynasty-by-dynasty', 'the-fall-of-rome'], tools: [['/centuries/', 'Centuries', 'World history one century at a time'], ['/atlas', 'Atlas', 'Press play and watch 5,500 years pass']] }
  };
  var PATH_TITLES = { 'silk-road': ['The Silk Road', 'Follow silk, ideas and armies across Eurasia.'], 'steppe-empires': ['Steppe Empires', 'The horse peoples who kept conquering the world.'],
    'religion-and-power': ['Religion and Power', 'Where faith and rule made and unmade each other.'], 'empires-of-africa': ['Empires of Africa', 'Ghana to the Zulu: the continent’s great states.'],
    'age-of-sail': ['The Age of Sail', 'The empires the ocean built.'], 'how-empires-fall': ['How Empires Fall', 'The patterns behind every collapse.'],
    'law-and-government': ['Law and Government', 'How states learned to rule.'], 'science-and-learning': ['Science and Learning', 'Where knowledge was made and kept.'],
    'the-crusades': ['The Crusades', 'Two centuries of holy war in the Levant.'], 'the-fall-of-rome': ['The Fall of Rome', 'How the west came apart, and what survived.'],
    'the-americas-before-columbus': ['The Americas before Columbus', 'Great cities and empires before 1492.'], 'india-through-the-ages': ['India through the Ages', 'Ashoka to the Marathas.'],
    'china-dynasty-by-dynasty': ['China, Dynasty by Dynasty', 'Two thousand years of reinvention.'], 'the-age-of-revolutions': ['The Age of Revolutions', 'When subjects became citizens.'],
    'women-who-ruled': ['Women Who Ruled', 'Nine rulers the rules could not stop.'], 'city-states-and-leagues': ['City-States and Leagues', 'Single cities that outplayed empires.'] };
  var REGION_PATH = { africa: 'empires-of-africa', americas: 'the-americas-before-columbus', eastasia: 'china-dynasty-by-dynasty', southasia: 'india-through-the-ages', europe: 'the-fall-of-rome', mideast: 'religion-and-power' };
  var ERA_BONUS = { ancient: ['timekeeper', 'builder'], medieval: ['navigator', 'chronicler'], earlymodern: ['navigator', 'strategist'], modern: ['chronicler', 'thinker'], all: ['timekeeper', 'timekeeper'] };
  var PACE_BONUS = { short: ['chronicler'], long: ['thinker', 'timekeeper'] };

  var form = document.getElementById('fp-form'), result = document.getElementById('fp-result');
  function val(name) { var el = form.querySelector('input[name="' + name + '"]:checked'); return el ? el.value : null; }
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var pull = val('pull'), era = val('era'), pace = val('pace'), region = val('region');
    if (!pull || !era || !pace) { document.getElementById('fp-err').hidden = false; return; }
    document.getElementById('fp-err').hidden = true;
    var score = {}; Object.keys(TYPES).forEach(function (k) { score[k] = 0; });
    score[pull] += 3;
    (ERA_BONUS[era] || []).forEach(function (k) { score[k] += 1; });
    (PACE_BONUS[pace] || []).forEach(function (k) { score[k] += 1; });
    var best = pull;   // the first question breaks every tie
    Object.keys(score).forEach(function (k) { if (score[k] > score[best]) best = k; });
    var T = TYPES[best];
    var paths = T.paths.slice();
    if (region && REGION_PATH[region] && paths.indexOf(REGION_PATH[region]) < 0) paths[2] = REGION_PATH[region];
    document.getElementById('fp-type').textContent = T.n;
    document.getElementById('fp-blurb').textContent = T.b;
    document.getElementById('fp-paths').innerHTML = paths.map(function (s) {
      var p = PATH_TITLES[s] || [s, ''];
      return '<a class="fp-path" href="/paths/' + s + '"><b>' + escHtml(p[0]) + '</b><span>' + escHtml(p[1]) + '</span><i>Start the path →</i></a>';
    }).join('');
    document.getElementById('fp-tools').innerHTML = T.tools.map(function (t) {
      return '<a class="fp-tool" href="' + t[0] + '"><b>' + escHtml(t[1]) + '</b><span>' + escHtml(t[2]) + '</span></a>';
    }).join('');
    try { localStorage.setItem('epoch-reader-type', JSON.stringify({ t: best, n: T.n, paths: paths, ts: Date.now() })); } catch (err) {}
    result.hidden = false;
    form.hidden = true;
    result.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    var save = document.getElementById('fp-save');
    save.textContent = 'Save these to My shelf'; save.disabled = false;
    save.onclick = function () {
      try {
        var shelf = JSON.parse(localStorage.getItem('epoch-shelf') || '[]'); if (!Array.isArray(shelf)) shelf = [];
        paths.slice().reverse().forEach(function (s) {
          var p = PATH_TITLES[s] || [s, ''];
          shelf = shelf.filter(function (r) { return r && r.u !== '/paths/' + s; });
          shelf.unshift({ u: '/paths/' + s, n: p[0], t: 'reading path' });
        });
        localStorage.setItem('epoch-shelf', JSON.stringify(shelf.slice(0, 100)));
        save.textContent = '✓ Saved — open the bookmark in the menu'; save.disabled = true;
      } catch (err) {}
    };
  });
  document.getElementById('fp-retake').addEventListener('click', function () {
    result.hidden = true; form.hidden = false;
    window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  });
  // returning with a saved type: offer the result straight away
  try {
    var prev = JSON.parse(localStorage.getItem('epoch-reader-type') || 'null');
    if (prev && prev.t && TYPES[prev.t]) {
      var lede = document.querySelector('.ref-lede');
      lede.innerHTML += ' <a href="#" id="fp-again">Last time you were <b>' + escHtml(prev.n || TYPES[prev.t].n) + '</b> — see those suggestions again.</a>';
      document.getElementById('fp-again').addEventListener('click', function (e) {
        e.preventDefault();
        var inp = form.querySelector('input[name="pull"][value="' + prev.t + '"]'); if (inp) inp.checked = true;
        var anyEra = form.querySelector('input[name="era"][value="all"]'); if (anyEra) anyEra.checked = true;
        var anyPace = form.querySelector('input[name="pace"][value="long"]'); if (anyPace) anyPace.checked = true;
        form.dispatchEvent(new Event('submit', { cancelable: true }));
      });
    }
  } catch (err) {}
})();
</script>

</body>
