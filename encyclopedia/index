  $('enc-stats').textContent = rows.length.toLocaleString('en-GB') + ' entries';

  // state, kept in the address (?q=&type=&tag=&sort=&page=) so a search can be shared and survives the back button
  var P = new URLSearchParams(location.search);
  var state = { q: P.get('q') || '', type: P.get('type') || '', tag: P.get('tag') || '', sort: P.get('sort') || 'az', page: Math.max(1, parseInt(P.get('page'), 10) || 1) };
  $('enc-q').value = state.q;
  function saveState() {
    var p = new URLSearchParams();
    if (state.q) p.set('q', state.q); if (state.type) p.set('type', state.type); if (state.tag) p.set('tag', state.tag);
    if (state.sort !== 'az') p.set('sort', state.sort); if (state.page > 1) p.set('page', state.page);
    history.replaceState(null, '', location.pathname + (p.toString() ? '?' + p : ''));
  }
  function chips() {
    $('enc-types').innerHTML = [['', 'All', rows.length]].concat(TYPES.map(function (t) { return [t[0], t[1], counts[t[0]] || 0]; }))
      .map(function (t) { return '<button class="enc-chip" type="button" data-t="' + t[0] + '" aria-pressed="' + (state.type === t[0]) + '">' + esc(t[1]) + '<span class="n">' + t[2].toLocaleString('en-GB') + '</span></button>'; }).join('');
    var el = $('enc-tags'); el.hidden = state.type !== 'conflict'; if (el.hidden) return;
    var conf = rows.filter(function (e) { return e.tags.length; });
    el.innerHTML = [['', 'All', conf.length]].concat(TAGS.map(function (g) { return [g[0], g[1], conf.filter(function (e) { return e.tags.some(function (t) { return g[2].indexOf(t) !== -1; }); }).length]; }))
      .map(function (g) { return '<button class="enc-chip" type="button" data-g="' + g[0] + '" aria-pressed="' + (state.tag === g[0]) + '">' + esc(g[1]) + '<span class="n">' + g[2].toLocaleString('en-GB') + '</span></button>'; }).join('') +
      '<span class="enc-sort">Sort: <button class="enc-chip" type="button" data-s="az" aria-pressed="' + (state.sort === 'az') + '">A–Z</button><button class="enc-chip" type="button" data-s="date" aria-pressed="' + (state.sort === 'date') + '">By date</button></span>';
  }
  function typeLine(e) {
    if (e.tags.length) return e.tags.map(function (t) { return TAGNAME[t] || t; }).join(' · ') + (e.dates ? ' · ' + e.dates : '');
    return (SING[e.t] || e.t) + (e.dates ? ' · ' + e.dates : '');
  }
  function render() {
    var q = fold(state.q.trim()), active = !!(q || state.type);
    $('enc-results').hidden = !active; var browse = $('enc-browse'); if (browse) browse.hidden = active;
    if (!active) { $('enc-count').textContent = ''; return; }
    var grp = state.tag ? (TAGS.filter(function (g) { return g[0] === state.tag; })[0] || [])[2] : null;
    var list = rows.filter(function (e) { return (!state.type || e.t === state.type) && (!grp || e.tags.some(function (t) { return grp.indexOf(t) !== -1; })) && (!q || e.s.indexOf(q) !== -1); });
    if (state.type === 'conflict' && state.sort === 'date') list = list.slice().sort(function (a, b) { var ya = yearOf(a), yb = yearOf(b); return (ya === null) - (yb === null) || ya - yb; });
    var pages = Math.max(1, Math.ceil(list.length / PER)); if (state.page > pages) state.page = pages;
    $('enc-count').textContent = list.length.toLocaleString('en-GB') + (list.length === 1 ? ' entry' : ' entries') + (pages > 1 ? ' · page ' + state.page + ' of ' + pages : '');
    $('enc-list').innerHTML = list.length ? list.slice((state.page - 1) * PER, state.page * PER).map(function (e) {
      return '<li class="enc-item' + (e.img ? ' has-img' : '') + '"><a href="/encyclopedia/' + e.slug + '">' + (e.img ? '<img class="enc-thumb" src="/images/encyclopedia/' + e.slug + '.jpg" alt="" loading="lazy" width="56" height="56">' : '') +
        '<span class="enc-name">' + esc(e.name) + '</span><span class="enc-type">' + esc(typeLine(e)) + '</span></a></li>';
    }).join('') : '<li class="enc-empty">No entries match. Try a shorter word, or choose “All”.</li>';
    var pg = '';
    if (pages > 1) {
      var show = {}; [1, pages, state.page - 2, state.page - 1, state.page, state.page + 1, state.page + 2].forEach(function (k) { if (k >= 1 && k <= pages) show[k] = 1; });
      var ks = Object.keys(show).map(Number).sort(function (a, b) { return a - b; }), prev = 0;
      if (state.page > 1) pg += '<button type="button" data-p="' + (state.page - 1) + '">← Previous</button>';
      ks.forEach(function (k) { if (prev && k - prev > 1) pg += '<span class="gap">…</span>'; pg += k === state.page ? '<span aria-current="page">' + k + '</span>' : '<button type="button" data-p="' + k + '">' + k + '</button>'; prev = k; });
      if (state.page < pages) pg += '<button type="button" data-p="' + (state.page + 1) + '">Next →</button>';
    }
    $('enc-pager').innerHTML = pg;
  }
  $('enc-types').addEventListener('click', function (ev) { var b = ev.target.closest('.enc-chip'); if (!b) return; state.type = b.getAttribute('data-t'); state.tag = ''; state.page = 1; chips(); render(); saveState(); });
  $('enc-tags').addEventListener('click', function (ev) {
    var b = ev.target.closest('.enc-chip'); if (!b) return;
    if (b.hasAttribute('data-s')) state.sort = b.getAttribute('data-s'); else state.tag = b.getAttribute('data-g');
    state.page = 1; chips(); render(); saveState();
  });
  $('enc-pager').addEventListener('click', function (ev) {
    var b = ev.target.closest('[data-p]'); if (!b) return;
    state.page = +b.getAttribute('data-p'); render(); saveState();
    $('enc-results').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  var timer; $('enc-q').addEventListener('input', function (ev) { clearTimeout(timer); var v = ev.target.value; timer = setTimeout(function () { state.q = v; state.page = 1; render(); saveState(); }, 150); });
  $('enc-random').addEventListener('click', function (ev) { if (!rows.length) return; ev.preventDefault(); location.href = '/encyclopedia/' + rows[Math.floor(Math.random() * rows.length)].slug; });
  chips(); render();
})();
</script>
