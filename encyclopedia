<script>
initNav('encyclopedia');
(function () {
  var TYPES = [["person","People"],["conflict","Conflicts & Resolutions"],["event","Events"],["place","Places"],["polity","States & dynasties"],["group","Peoples & groups"],["institution","Institutions & offices"],["term","Terms"],["idea","Religions & ideas"],["work","Works & monuments"],["factor","Factors"]];
  var SING = { person:"Person", conflict:"Conflict / resolution", event:"Event", place:"Place", polity:"State", group:"People / group", institution:"Institution", term:"Term", idea:"Religion / idea", work:"Work / monument", factor:"Historical factor" };
  var data = (typeof ENCYCLOPEDIA !== 'undefined') ? ENCYCLOPEDIA : [];
  var bySlug = {}; data.forEach(function (e) { bySlug[e.slug] = e; });
  var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]; }); };
  var fold = function (s) { return String(s).normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase(); };
  data.forEach(function (e) { e._k = fold(e.name).replace(/^(al-|el-|the )/, '').replace(/^[^a-z0-9]+/, ''); e._s = fold([e.name].concat(e.aka || []).join(' | ')); });
  data.sort(function (a, b) { return a._k < b._k ? -1 : a._k > b._k ? 1 : 0; });
  // Conflicts & Resolutions: entries with tags (battle, siege, war, campaign, revolt, revolution, crisis, treaty, peace)
  var TAGS = [['battle', 'Battles', ['battle']], ['siege', 'Sieges', ['siege']], ['war', 'Wars & campaigns', ['war', 'campaign']],
    ['revolt', 'Revolts & revolutions', ['revolt', 'revolution']], ['crisis', 'Crises & tensions', ['crisis']], ['treaty', 'Treaties', ['treaty']],
    ['peace', 'Peace efforts & congresses', ['peace']]];
  var TAGNAME = { battle: 'Battle', siege: 'Siege', war: 'War', campaign: 'Campaign', revolt: 'Revolt', revolution: 'Revolution', crisis: 'Crisis', treaty: 'Treaty', peace: 'Peace' };
  function isConflict(e) { return !!(e.tags && e.tags.length); }
  function tagLabel(e) { return e.tags.map(function (t) { return TAGNAME[t] || t; }).join(' · '); }
  function typeOf(e) { return isConflict(e) ? 'conflict' : e.type; }
  function yearOf(e) {   // first year in the dates string, BCE negative; null if none
    var s = String(e.dates || ''), m = s.match(/(\d{1,4})/); if (!m) return null;
    var y = parseInt(m[1], 10); if (/BCE|BC\b/.test(s) && !/CE\b/.test(s.slice(0, s.indexOf(m[1]) + m[1].length + 6).replace(/BCE/g, ''))) y = -y;
    return y;
  }
  var counts = {}; data.forEach(function (e) { var k = typeOf(e); counts[k] = (counts[k] || 0) + 1; });
  var children = {}; data.forEach(function (e) { if (e.war && bySlug[e.war]) (children[e.war] = children[e.war] || []).push(e); });
  document.getElementById('enc-stats').textContent = data.length.toLocaleString() + ' entries';

  // ── links inside descriptions (same patterns as the empire pages) ──
  // A name several entries share ("@g" rows) links to the one that fits the year in the sentence or this entry's own
  // dates (ENC_FN.pick, in encyclopedia-links.js); a dated event next to a contradicting year is not linked.
  var RX = null;
  function compile() {
    if (RX || typeof ENC_LINKS === 'undefined' || typeof ENC_FN === 'undefined') return;
    RX = [];
    ENC_LINKS.e.forEach(function (en, i) {
      if (ENC_LINKS.fs && i >= ENC_LINKS.fs) return;   // profile-only short forms
      var g = en[0] === '@g' ? { m: en[2], p: en[3] } : null;
      en[1].forEach(function (p) { try { RX.push({ slug: en[0], g: g, rx: ENC_FN.rx(p[0], p[1]) }); } catch (err) {} });
    });
  }
  function linkify(text, selfSlug) {
    compile(); if (!RX) return esc(text);
    var host = bySlug[selfSlug], ctx = host ? ENC_FN.years(host.dates) : null, cands = [];
    RX.forEach(function (r) {
      if (r.slug === selfSlug) return;
      r.rx.lastIndex = 0; var m;
      while ((m = r.rx.exec(text))) {
        if (!m[0].length) { r.rx.lastIndex++; continue; }
        var s = m.index, e = s + m[0].length, slug = r.slug;
        // undecided group or wrong year: the text stays claimed, so no shorter name inside it links
        if (r.g) slug = ENC_FN.pick(r.g.m.filter(function (x) { return x !== selfSlug; }), text, s, e, ctx, null, r.g.p);
        else if (!ENC_FN.ok(slug, text, s, e)) slug = null;
        cands.push({ s: s, e: e, slug: slug });
      }
    });
    cands.sort(function (a, b) { return a.s - b.s || (b.e - b.s) - (a.e - a.s) || (b.slug ? 1 : 0) - (a.slug ? 1 : 0); });
    var out = '', pos = 0, used = {};
    cands.forEach(function (c) {
      if (c.s < pos) return;
      if (!c.slug) { out += esc(text.slice(pos, c.e)); pos = c.e; return; }
      if (used[c.slug] || !bySlug[c.slug]) return;
      used[c.slug] = 1;
      var txt = text.slice(c.s, c.e), tail = '', poss = txt.match(/(['’]s)$/);
      if (poss) { tail = poss[1]; txt = txt.slice(0, -tail.length); }
      out += esc(text.slice(pos, c.s)) + '<a class="enc-link" href="#' + c.slug + '">' + esc(txt) + '</a>' + esc(tail);
      pos = c.e;
    });
    return out + esc(text.slice(pos));
  }

  // ── index view ──
  var state = { q: '', type: '', tag: '', sort: 'az' };
  var typesEl = document.getElementById('enc-types');
  function chips() {
    typesEl.innerHTML = [['', 'All', data.length]].concat(TYPES.map(function (t) { return [t[0], t[1], counts[t[0]] || 0]; }))
      .map(function (t) { return '<button class="enc-chip" type="button" data-t="' + t[0] + '" aria-pressed="' + (state.type === t[0]) + '">' + esc(t[1]) + '<span class="n">' + t[2].toLocaleString() + '</span></button>'; }).join('');
  }
  typesEl.addEventListener('click', function (ev) { var b = ev.target.closest('.enc-chip'); if (!b) return; state.type = b.getAttribute('data-t'); state.tag = ''; chips(); tagChips(); renderIndex(); });
  var tagsEl = document.getElementById('enc-tags');
  function tagChips() {
    tagsEl.hidden = state.type !== 'conflict'; if (tagsEl.hidden) return;
    var conf = data.filter(isConflict);
    tagsEl.innerHTML = [['', 'All', conf.length]].concat(TAGS.map(function (g) { return [g[0], g[1], conf.filter(function (e) { return e.tags.some(function (t) { return g[2].indexOf(t) !== -1; }); }).length]; }))
      .map(function (g) { return '<button class="enc-chip" type="button" data-g="' + g[0] + '" aria-pressed="' + (state.tag === g[0]) + '">' + esc(g[1]) + '<span class="n">' + g[2].toLocaleString() + '</span></button>'; }).join('') +
      '<span class="enc-sort">Sort: <button class="enc-chip" type="button" data-s="az" aria-pressed="' + (state.sort === 'az') + '">A–Z</button><button class="enc-chip" type="button" data-s="date" aria-pressed="' + (state.sort === 'date') + '">By date</button></span>';
  }
  tagsEl.addEventListener('click', function (ev) {
    var b = ev.target.closest('.enc-chip'); if (!b) return;
    if (b.hasAttribute('data-s')) state.sort = b.getAttribute('data-s'); else state.tag = b.getAttribute('data-g');
    tagChips(); renderIndex();
  });
  document.addEventListener('click', function (ev) {   // "Conflicts & Resolutions" link in an article kicker
    if (!ev.target.closest('[data-conflicts]')) return;
    state.type = 'conflict'; state.tag = ''; chips(); tagChips(); renderIndex();
  });
  var timer; document.getElementById('enc-q').addEventListener('input', function (ev) { clearTimeout(timer); var v = ev.target.value; timer = setTimeout(function () { state.q = fold(v.trim()); renderIndex(); }, 120); });
  function renderIndex() {
    var grp = state.tag ? TAGS.filter(function (g) { return g[0] === state.tag; })[0][2] : null;
    var rows = data.filter(function (e) { return (!state.type || typeOf(e) === state.type) && (!grp || (isConflict(e) && e.tags.some(function (t) { return grp.indexOf(t) !== -1; }))) && (!state.q || e._s.indexOf(state.q) !== -1); });
    if (state.type === 'conflict' && state.sort === 'date') {
      rows = rows.slice().sort(function (a, b) { var ya = yearOf(a), yb = yearOf(b); return (ya === null) - (yb === null) || ya - yb || (a._k < b._k ? -1 : 1); });
      var ctr = {}, corder = [];
      rows.forEach(function (e) { var y = yearOf(e), c = y === null ? 'Undated' : (y < 0 ? Math.floor(-y / 100) + 1 + 'th century BCE' : Math.floor(y / 100) + 1 + 'th century'); c = c.replace(/^1th/, '1st').replace(/^2th/, '2nd').replace(/^3th/, '3rd').replace(/^(\d*1)th(?= )/, function (m, d) { return d === '11' ? '11th' : d + 'st'; }).replace(/^(\d*2)th(?= )/, function (m, d) { return d === '12' ? '12th' : d + 'nd'; }).replace(/^(\d*3)th(?= )/, function (m, d) { return d === '13' ? '13th' : d + 'rd'; }); if (!ctr[c]) { ctr[c] = []; corder.push(c); } ctr[c].push(e); });
      document.getElementById('enc-count').textContent = rows.length.toLocaleString() + ' shown';
      document.getElementById('enc-az').innerHTML = '';
      document.getElementById('enc-list').innerHTML = rows.length ? corder.map(function (c) {
        return '<section class="enc-letter"><h2>' + esc(c) + '</h2><ul class="enc-list">' + ctr[c].map(itemHtml).join('') + '</ul></section>';
      }).join('') : '<p class="enc-empty">No entries match.</p>';
      return;
    }
    document.getElementById('enc-count').textContent = rows.length.toLocaleString() + ' shown';
    var groups = {}, order = [];
    rows.forEach(function (e) { var L = /[a-z]/.test(e._k[0]) ? e._k[0].toUpperCase() : '#'; if (!groups[L]) { groups[L] = []; order.push(L); } groups[L].push(e); });
    document.getElementById('enc-az').innerHTML = '#ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').map(function (L) {
      return '<a href="javascript:void(0)" data-jump="enc-l-' + (L === '#' ? 'num' : L) + '"' + (groups[L] ? '' : ' class="off"') + '>' + L + '</a>';
    }).join('');
    document.getElementById('enc-list').innerHTML = rows.length ? order.map(function (L) {
      return '<section class="enc-letter"><h2 id="enc-l-' + (L === '#' ? 'num' : L) + '">' + L + '</h2><ul class="enc-list">' + groups[L].map(function (e) {
        return itemHtml(e); }).join('') + '</ul></section>';
    }).join('') : '<p class="enc-empty">No entries match. Clear the search or choose “All”.</p>';
  }
  function itemHtml(e) {
    return '<li class="enc-item' + (e.img ? ' has-img' : '') + '"><a href="#' + e.slug + '">' + (e.img ? '<img class="enc-thumb" src="' + esc(e.img) + '" alt="" loading="lazy" width="56" height="56">' : '') +
      '<span class="enc-name">' + esc(e.name) + '</span><span class="enc-type">' + esc(isConflict(e) ? tagLabel(e) + (e.dates ? ' · ' + e.dates : '') : (SING[e.type] || e.type)) + '</span>' + (e.desc ? '<span class="enc-snip">' + esc(e.desc) + '</span>' : '') + '</a></li>';
  }
  document.getElementById('enc-az').addEventListener('click', function (ev) {
    var a = ev.target.closest('a[data-jump]'); if (!a) return; ev.preventDefault();
    var t = document.getElementById(a.getAttribute('data-jump')); if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // ── random entry (entries with a description) ──
  var withDesc = data.filter(function (e) { return e.desc; });
  function randomSlug() { return withDesc[Math.floor(Math.random() * withDesc.length)].slug; }
  document.getElementById('enc-random').addEventListener('click', function () { location.hash = randomSlug(); });

  // ── see also: entries mentioned in the same empire sections, most shared sections first ──
  var byEmpire = {};
  data.forEach(function (e) { (e.empires || []).forEach(function (m) { (byEmpire[m.name] = byEmpire[m.name] || []).push(e); }); });
  function seeAlso(e) {
    var score = {};
    (e.empires || []).forEach(function (m) {
      (byEmpire[m.name] || []).forEach(function (o) {
        if (o === e) return;
        var om = o.empires.filter(function (x) { return x.name === m.name; })[0];
        var shared = om.sections.filter(function (s) { return m.sections.indexOf(s) !== -1; }).length;
        score[o.slug] = (score[o.slug] || 0) + shared * 3 + 1 + (o.img ? 0.5 : 0);
      });
    });
    return Object.keys(score).sort(function (a, b) { return score[b] - score[a]; }).slice(0, 8).map(function (s) { return bySlug[s]; });
  }

  // ── article view ──
  var SEC = { foundation:'Foundation', socioeconomy:'Socioeconomy', military:'Military', governance:'Governance', impact:'Impact', decline:'Decline', summary:'Summary' };
  function renderArticle(e) {
    var el = document.getElementById('enc-article');
    var meta = [];
    if (e.dates) meta.push('<span class="dates">' + esc(e.dates) + '</span>');
    if (e.aka && e.aka.length) meta.push('Also known as ' + e.aka.map(esc).join(', '));
    if (e.war && bySlug[e.war]) meta.push('Part of the <a class="enc-link" href="#' + e.war + '">' + esc(bySlug[e.war].name) + '</a>');
    var fig = '';
    if (e.img) {
      var cap = [e.credit && e.credit.artist ? esc(e.credit.artist) : '', e.credit && e.credit.licence ? esc(e.credit.licence) : ''].filter(Boolean).join(' · ');
      fig = '<figure class="enc-fig"><img src="' + esc(e.img) + '" alt="' + esc(e.name) + '" loading="lazy" width="320">' +
        '<figcaption>' + (cap ? 'Image: ' + cap + ' · ' : '') + (e.credit && e.credit.source ? '<a href="' + esc(e.credit.source) + '" target="_blank" rel="noopener">Wikimedia Commons</a>' : '') + '</figcaption></figure>';
    }
    var mentions = e.empires.map(function (m) {
      return '<a href="/empire/' + m.slug + '">' + esc(m.name) + '<span class="secs">' + esc(m.sections.map(function (s) { return SEC[s] || s; }).join(', ')) + '</span></a>';
    }).join('');
    el.innerHTML =
      '<a class="enc-back" href="#index">← Encyclopedia index</a>' +
      '<div><p class="enc-kicker">' + (isConflict(e) ? '<a href="#index" data-conflicts>Conflicts &amp; Resolutions</a> · ' + esc(tagLabel(e)) : esc(SING[e.type] || e.type) + (e.subtype && e.type !== 'polity' && e.type !== 'factor' ? ' · ' + esc(e.subtype) : '')) + '</p>' +
      '<h1 class="enc-title">' + esc(e.name) + '</h1>' + (meta.length ? '<p class="enc-meta">' + meta.join(' · ') + '</p>' : '') + '</div>' +
      '<div class="enc-body"><p class="enc-desc">' + (e.desc ? linkify(e.desc, e.slug) : 'Description coming soon.') + '</p>' + fig + '</div>' +
      (e.empires.length ? '<div><p class="enc-section-title">Mentioned in ' + e.empires.length + ' profile' + (e.empires.length === 1 ? '' : 's') + '</p><div class="enc-mentions">' + mentions + '</div></div>' : '') +
      (function () {   // a war's battles, sieges and settlements, in date order
        var kids = (children[e.slug] || []).slice().sort(function (a, b) { var ya = yearOf(a), yb = yearOf(b); return (ya === null) - (yb === null) || ya - yb; });
        if (!kids.length) return '';
        return '<div><p class="enc-section-title">Battles and settlements</p><ul class="enc-seealso">' + kids.map(function (o) {
          return '<li><a href="#' + o.slug + '">' + (o.img ? '<img src="' + esc(o.img) + '" alt="" loading="lazy" width="44" height="44">' : '<span class="ph"></span>') +
            '<span><span class="nm">' + esc(o.name) + '</span><span class="tp">' + esc(tagLabel(o) + (o.dates ? ' · ' + o.dates : '')) + '</span></span></a></li>';
        }).join('') + '</ul></div>';
      })() +
      '<div id="enc-states" hidden></div>' +
      (function () {
        var rel = seeAlso(e); if (!rel.length) return '';
        return '<div><p class="enc-section-title">See also</p><ul class="enc-seealso">' + rel.map(function (o) {
          return '<li><a href="#' + o.slug + '">' + (o.img ? '<img src="' + esc(o.img) + '" alt="" loading="lazy" width="44" height="44">' : '<span class="ph"></span>') +
            '<span><span class="nm">' + esc(o.name) + '</span><span class="tp">' + esc(isConflict(o) ? tagLabel(o) : (SING[o.type] || o.type)) + '</span></span></a></li>';
        }).join('') + '</ul></div>';
      })() +
      '<p class="enc-article-foot"><a class="enc-random-link" href="#' + randomSlug() + '">Random entry ↻</a></p>';
    document.title = e.name + ' — Encyclopedia — The Epoch Institute';
    statesFor(e);
  }
  // states whose histories mention this entry, and the state page of an entry that is itself a state
  var encStates = null;
  function statesFor(e) {
    (encStates || (encStates = fetch('/data/enc-states.json?v=5').then(function (r) { return r.json(); }).catch(function () { return { m: {}, p: {} }; }))).then(function (j) {
      var box = document.getElementById('enc-states'); if (!box || location.hash.slice(1) !== e.slug) return;
      var html = '', own = j.p && j.p[e.slug], m = j.m && j.m[e.slug];
      if (own) html += '<p class="enc-article-foot"><a class="enc-random-link" href="/state#' + esc(own) + '">State page: history, lineage and connections →</a></p>';
      if (m) html += '<div><p class="enc-section-title">Mentioned in ' + m[0] + ' state histor' + (m[0] === 1 ? 'y' : 'ies') + '</p><div class="enc-mentions">' +
        m[1].map(function (s) { return '<a href="/state#' + esc(s[0]) + '">' + esc(s[1]) + '</a>'; }).join('') +
        (m[0] > m[1].length ? '<span class="secs">and ' + (m[0] - m[1].length) + ' more</span>' : '') + '</div></div>';
      box.innerHTML = html; box.hidden = !html;
    });
  }

  var lastIndexScroll = 0;
  function route() {
    var slug = decodeURIComponent(location.hash.slice(1));
    var e = slug && bySlug[slug];
    var idx = document.getElementById('enc-index'), art = document.getElementById('enc-article');
    if (e) {
      if (!idx.hidden) lastIndexScroll = window.scrollY;
      renderArticle(e); idx.hidden = true; art.hidden = false; window.scrollTo(0, 0);
    } else {
      idx.hidden = false; art.hidden = true; document.title = 'Encyclopedia — The Epoch Institute';
      window.scrollTo(0, lastIndexScroll);
    }
  }
  window.addEventListener('hashchange', route);
  chips(); renderIndex(); route();
})();
</script>
</body>
</html>
