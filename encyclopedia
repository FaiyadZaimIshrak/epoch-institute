<style>
.enc-page { position: relative; z-index: 1; padding: 96px 0 72px; min-height: 100vh; }
.enc-wrap { max-width: 920px; margin: 0 auto; padding-left: max(20px, env(safe-area-inset-left, 0px)); padding-right: max(20px, env(safe-area-inset-right, 0px)); }
.enc-head { text-align: center; display: grid; gap: 10px; justify-items: center; margin-bottom: 28px; }
.enc-draft { font-family: var(--font-ui); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); border: 0.5px solid var(--border); padding: 6px 12px; border-radius: 2px; max-width: 640px; line-height: 1.6; font-weight: 600;}
.enc-stats { font-family: var(--font-ui); font-size: 13px; letter-spacing: 0.02em; color: var(--muted); }
.enc-controls { position: sticky; top: 64px; z-index: 5; background: var(--bg); padding: 12px 0; border-bottom: 0.5px solid var(--border); display: grid; gap: 10px; }
.enc-search { width: 100%; font-family: var(--font-text); font-size: 18px; padding: 10px 14px; background: var(--surface); color: var(--text); border: 0.5px solid var(--border); border-radius: 2px; }
.enc-search:focus { outline: 1px solid var(--gold); }
.enc-row { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.enc-chip { font-family: var(--font-ui); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; padding: 6px 10px; background: none; color: var(--muted); border: 0.5px solid var(--border); border-radius: 2px; cursor: pointer; font-weight: 600;}
.enc-chip:hover { color: var(--gold); border-color: var(--gold); }
.enc-chip[aria-pressed="true"] { color: var(--bg); background: var(--gold); border-color: var(--gold); }
.enc-chip .n { opacity: .7; margin-left: 4px; }
.enc-az { display: flex; flex-wrap: wrap; gap: 2px; font-family: var(--font-ui); font-size: 13px; }
.enc-az a { color: var(--gold); text-decoration: none; padding: 2px 6px; }
.enc-az a.off { color: var(--border); pointer-events: none; }
.enc-count { font-family: var(--font-ui); font-size: 12px; letter-spacing: 0.06em; color: var(--muted); text-transform: uppercase; font-weight: 600;}
.enc-letter h2 { font-family: var(--font-display); font-weight: 600; font-size: 24px; color: var(--gold); margin: 28px 0 6px; scroll-margin-top: 230px; }
.enc-letter { content-visibility: auto; contain-intrinsic-size: auto 800px; }
.enc-list { list-style: none; }
.enc-item a { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 2px 12px; padding: 10px 0; border-bottom: 0.5px solid var(--border); color: var(--text); text-decoration: none; }
.enc-item a:hover .enc-name { color: var(--gold); }
.enc-name { font-size: 18px; font-weight: 600; min-width: 0; }
.enc-type { font-family: var(--font-ui); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); padding-top: 6px; white-space: nowrap; font-weight: 600;}
.enc-snip { grid-column: 1 / -1; font-size: 15px; color: var(--muted); line-height: 1.5; min-width: 0; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.enc-empty { padding: 40px 0; color: var(--muted); font-size: 17px; }
/* Article */
.enc-article { display: grid; gap: 18px; }
.enc-back { font-family: var(--font-ui); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); text-decoration: none; border: 0.5px solid var(--border); padding: 7px 14px; border-radius: 2px; justify-self: start; font-weight: 600;}
.enc-back:hover { color: var(--gold); border-color: var(--gold); }
.enc-kicker { font-family: var(--font-ui); font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gold); font-weight: 600;}
.enc-title { font-family: var(--font-display); font-weight: 600; font-size: clamp(28px, 5vw, 42px); line-height: 1.15; color: var(--text); text-wrap: balance; }
.enc-meta { font-size: 16px; color: var(--muted); }
.enc-meta .dates { color: var(--text); }
.enc-body { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 28px; align-items: start; }
.enc-desc { font-size: 20px; line-height: 1.7; color: var(--text); max-width: 65ch; }
.enc-fig { width: 280px; max-width: 100%; border: 0.5px solid var(--border); background: var(--surface); padding: 8px; }
.enc-fig img { display: block; width: 100%; height: auto; }
.enc-fig figcaption { font-size: 12px; line-height: 1.45; color: var(--muted); margin-top: 8px; overflow-wrap: anywhere; }
.enc-fig figcaption a { color: var(--muted); }
.enc-section-title { font-family: var(--font-ui); font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; font-weight: 600;}
.enc-mentions { display: flex; flex-wrap: wrap; gap: 8px; }
.enc-mentions a { font-family: var(--font-ui); font-size: 13px; letter-spacing: 0.02em; color: var(--gold); text-decoration: none; border: 0.5px solid var(--border); padding: 6px 10px; border-radius: 2px; }
.enc-mentions a:hover { border-color: var(--gold); }
.enc-mentions .secs { color: var(--muted); font-family: var(--font-text); letter-spacing: 0; text-transform: none; margin-left: 4px; }
.enc-item.has-img a { grid-template-columns: 56px minmax(0,1fr) auto; column-gap: 14px; }
.enc-item.has-img .enc-snip { grid-column: 2 / -1; }
.enc-thumb { grid-row: 1 / span 2; width: 56px; height: 56px; object-fit: cover; border-radius: 2px; background: var(--surface); }
.enc-count-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.enc-random, .enc-random-link { font-family: var(--font-ui); font-size: 13px; font-weight: 600; color: var(--gold); background: none; border: 1px solid var(--border); border-radius: 2px; padding: 5px 12px; cursor: pointer; text-decoration: none; }
.enc-random:hover, .enc-random-link:hover { border-color: var(--gold); }
.enc-seealso { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 8px; }
.enc-seealso a { display: flex; align-items: center; gap: 10px; padding: 8px; border: 1px solid var(--border); border-radius: 2px; text-decoration: none; color: var(--text); }
.enc-seealso a:hover { border-color: var(--gold); }
.enc-seealso img, .enc-seealso .ph { width: 44px; height: 44px; flex: 0 0 44px; object-fit: cover; border-radius: 2px; background: var(--surface); }
.enc-seealso .nm { display: block; font-size: 17px; line-height: 1.25; }
.enc-seealso .tp { display: block; font-family: var(--font-ui); font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
.enc-article-foot { margin: 0; }
@media (max-width: 720px) {
  .enc-body { grid-template-columns: 1fr; }
  .enc-fig { width: 100%; max-width: 360px; order: -1; }
  .enc-desc { font-size: 18px; }
  .enc-controls { top: 56px; }
}
</style>
</head>
<body>

<main class="enc-page">
  <div class="enc-wrap">
    <div id="enc-index">
      <header class="enc-head">
        <span class="hero-ornament"></span>
        <h1 class="research-title">Encyclopedia</h1>
        <p class="research-subtitle">The people, events, places, states, institutions and ideas named in our profiles of states, empires and civilisations.</p>
        <p class="enc-stats" id="enc-stats">Loading…</p>
      </header>
      <div class="enc-controls">
        <input class="enc-search" id="enc-q" type="search" placeholder="Search the encyclopedia…" aria-label="Search the encyclopedia" autocomplete="off">
        <div class="enc-row" id="enc-types" role="group" aria-label="Filter by type"></div>
        <nav class="enc-az" id="enc-az" aria-label="Jump to letter"></nav>
        <div class="enc-count-row"><span class="enc-count" id="enc-count"></span><button type="button" class="enc-random" id="enc-random">Random entry ↻</button></div>
      </div>
      <div id="enc-list"></div>
    </div>
    <article class="enc-article" id="enc-article" hidden></article>
  </div>
</main>

<script src="/shared-data.js?v=4"></script>
<script src="/shared-nav.js?v=8"></script>
<script src="/encyclopedia-data.js?v=4"></script>
<script src="/encyclopedia-links.js?v=2"></script>
<script>
initNav('encyclopedia');
(function () {
  var TYPES = [["person","People"],["event","Events"],["place","Places"],["polity","States & dynasties"],["group","Peoples & groups"],["institution","Institutions & offices"],["term","Terms"],["idea","Religions & ideas"],["work","Works & monuments"],["factor","Factors"]];
  var SING = { person:"Person", event:"Event", place:"Place", polity:"State", group:"People / group", institution:"Institution", term:"Term", idea:"Religion / idea", work:"Work / monument", factor:"Historical factor" };
  var data = (typeof ENCYCLOPEDIA !== 'undefined') ? ENCYCLOPEDIA : [];
  var bySlug = {}; data.forEach(function (e) { bySlug[e.slug] = e; });
  var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]; }); };
  var fold = function (s) { return String(s).normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase(); };
  data.forEach(function (e) { e._k = fold(e.name).replace(/^(al-|el-|the )/, '').replace(/^[^a-z0-9]+/, ''); e._s = fold([e.name].concat(e.aka || []).join(' | ')); });
  data.sort(function (a, b) { return a._k < b._k ? -1 : a._k > b._k ? 1 : 0; });
  var counts = {}; data.forEach(function (e) { counts[e.type] = (counts[e.type] || 0) + 1; });
  document.getElementById('enc-stats').textContent = data.length.toLocaleString() + ' entries';

  // ── links inside descriptions (same patterns as the empire pages) ──
  var RX = null;
  function compile() {
    if (RX || typeof ENC_LINKS === 'undefined') return;
    RX = [];
    ENC_LINKS.e.forEach(function (en) {
      en[1].forEach(function (p) { try { RX.push({ slug: en[0], rx: new RegExp(p[0], 'gu' + (p[1] ? 'i' : '')) }); } catch (err) {} });
    });
  }
  function linkify(text, selfSlug) {
    compile(); if (!RX) return esc(text);
    var cands = [];
    RX.forEach(function (r) {
      if (r.slug === selfSlug) return;
      r.rx.lastIndex = 0; var m;
      while ((m = r.rx.exec(text))) { if (!m[0].length) { r.rx.lastIndex++; continue; } cands.push({ s: m.index, e: m.index + m[0].length, slug: r.slug }); }
    });
    cands.sort(function (a, b) { return a.s - b.s || (b.e - b.s) - (a.e - a.s); });
    var out = '', pos = 0, used = {};
    cands.forEach(function (c) {
      if (c.s < pos || used[c.slug] || !bySlug[c.slug]) return;
      used[c.slug] = 1;
      var txt = text.slice(c.s, c.e), tail = '', poss = txt.match(/(['’]s)$/);
      if (poss) { tail = poss[1]; txt = txt.slice(0, -tail.length); }
      out += esc(text.slice(pos, c.s)) + '<a class="enc-link" href="#' + c.slug + '">' + esc(txt) + '</a>' + esc(tail);
      pos = c.e;
    });
    return out + esc(text.slice(pos));
  }

  // ── index view ──
  var state = { q: '', type: '' };
  var typesEl = document.getElementById('enc-types');
  function chips() {
    typesEl.innerHTML = [['', 'All', data.length]].concat(TYPES.map(function (t) { return [t[0], t[1], counts[t[0]] || 0]; }))
      .map(function (t) { return '<button class="enc-chip" type="button" data-t="' + t[0] + '" aria-pressed="' + (state.type === t[0]) + '">' + esc(t[1]) + '<span class="n">' + t[2].toLocaleString() + '</span></button>'; }).join('');
  }
  typesEl.addEventListener('click', function (ev) { var b = ev.target.closest('.enc-chip'); if (!b) return; state.type = b.getAttribute('data-t'); chips(); renderIndex(); });
  var timer; document.getElementById('enc-q').addEventListener('input', function (ev) { clearTimeout(timer); var v = ev.target.value; timer = setTimeout(function () { state.q = fold(v.trim()); renderIndex(); }, 120); });
  function renderIndex() {
    var rows = data.filter(function (e) { return (!state.type || e.type === state.type) && (!state.q || e._s.indexOf(state.q) !== -1); });
    document.getElementById('enc-count').textContent = rows.length.toLocaleString() + ' shown';
    var groups = {}, order = [];
    rows.forEach(function (e) { var L = /[a-z]/.test(e._k[0]) ? e._k[0].toUpperCase() : '#'; if (!groups[L]) { groups[L] = []; order.push(L); } groups[L].push(e); });
    document.getElementById('enc-az').innerHTML = '#ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').map(function (L) {
      return '<a href="javascript:void(0)" data-jump="enc-l-' + (L === '#' ? 'num' : L) + '"' + (groups[L] ? '' : ' class="off"') + '>' + L + '</a>';
    }).join('');
    document.getElementById('enc-list').innerHTML = rows.length ? order.map(function (L) {
      return '<section class="enc-letter"><h2 id="enc-l-' + (L === '#' ? 'num' : L) + '">' + L + '</h2><ul class="enc-list">' + groups[L].map(function (e) {
        return '<li class="enc-item' + (e.img ? ' has-img' : '') + '"><a href="#' + e.slug + '">' + (e.img ? '<img class="enc-thumb" src="' + esc(e.img) + '" alt="" loading="lazy" width="56" height="56">' : '') +
          '<span class="enc-name">' + esc(e.name) + '</span><span class="enc-type">' + esc(SING[e.type] || e.type) + '</span>' + (e.desc ? '<span class="enc-snip">' + esc(e.desc) + '</span>' : '') + '</a></li>';
      }).join('') + '</ul></section>';
    }).join('') : '<p class="enc-empty">No entries match. Clear the search or choose “All”.</p>';
  }
  document.getElementById('enc-az').addEventListener('click', function (ev) {
    var a = ev.target.closest('a[data-jump]'); if (!a) return; ev.preventDefault();
    var t = document.getElementById(a.getAttribute('data-jump')); if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // ── random entry (entries with a description) ──
  var withDesc = data.filter(function (e) { return e.desc; });
  function randomSlug() { return withDesc[Math.floor(Math.random() * withDesc.length)].slug; }
  document.getElementById('enc-random').addEventListener('click', function () { location.hash = randomSlug(); });

  // ── see also: entries mentioned in the same empire sections, most shared sections first ──
  var byEmpire = {};
  data.forEach(function (e) { (e.empires || []).forEach(function (m) { (byEmpire[m.name] = byEmpire[m.name] || []).push(e); }); });
  function seeAlso(e) {
    var score = {};
    (e.empires || []).forEach(function (m) {
      (byEmpire[m.name] || []).forEach(function (o) {
        if (o === e) return;
        var om = o.empires.filter(function (x) { return x.name === m.name; })[0];
        var shared = om.sections.filter(function (s) { return m.sections.indexOf(s) !== -1; }).length;
        score[o.slug] = (score[o.slug] || 0) + shared * 3 + 1 + (o.img ? 0.5 : 0);
      });
    });
    return Object.keys(score).sort(function (a, b) { return score[b] - score[a]; }).slice(0, 8).map(function (s) { return bySlug[s]; });
  }

  // ── article view ──
  var SEC = { foundation:'Foundation', socioeconomy:'Socioeconomy', military:'Military', governance:'Governance', impact:'Impact', decline:'Decline', summary:'Summary' };
  function renderArticle(e) {
    var el = document.getElementById('enc-article');
    var meta = [];
    if (e.dates) meta.push('<span class="dates">' + esc(e.dates) + '</span>');
    if (e.aka && e.aka.length) meta.push('Also known as ' + e.aka.map(esc).join(', '));
    var fig = '';
    if (e.img) {
      var cap = [e.credit && e.credit.artist ? esc(e.credit.artist) : '', e.credit && e.credit.licence ? esc(e.credit.licence) : ''].filter(Boolean).join(' · ');
      fig = '<figure class="enc-fig"><img src="' + esc(e.img) + '" alt="' + esc(e.name) + '" loading="lazy" width="320">' +
        '<figcaption>' + (cap ? 'Image: ' + cap + ' · ' : '') + (e.credit && e.credit.source ? '<a href="' + esc(e.credit.source) + '" target="_blank" rel="noopener">Wikimedia Commons</a>' : '') + '</figcaption></figure>';
    }
    var mentions = e.empires.map(function (m) {
      return '<a href="/empire/' + m.slug + '">' + esc(m.name) + '<span class="secs">' + esc(m.sections.map(function (s) { return SEC[s] || s; }).join(', ')) + '</span></a>';
    }).join('');
    el.innerHTML =
      '<a class="enc-back" href="#index">← Encyclopedia index</a>' +
      '<div><p class="enc-kicker">' + esc(SING[e.type] || e.type) + (e.subtype && e.type !== 'polity' && e.type !== 'factor' ? ' · ' + esc(e.subtype) : '') + '</p>' +
      '<h1 class="enc-title">' + esc(e.name) + '</h1>' + (meta.length ? '<p class="enc-meta">' + meta.join(' · ') + '</p>' : '') + '</div>' +
      '<div class="enc-body"><p class="enc-desc">' + (e.desc ? linkify(e.desc, e.slug) : 'Description coming soon.') + '</p>' + fig + '</div>' +
      (e.empires.length ? '<div><p class="enc-section-title">Mentioned in ' + e.empires.length + ' profile' + (e.empires.length === 1 ? '' : 's') + '</p><div class="enc-mentions">' + mentions + '</div></div>' : '') +
      (function () {
        var rel = seeAlso(e); if (!rel.length) return '';
        return '<div><p class="enc-section-title">See also</p><ul class="enc-seealso">' + rel.map(function (o) {
          return '<li><a href="#' + o.slug + '">' + (o.img ? '<img src="' + esc(o.img) + '" alt="" loading="lazy" width="44" height="44">' : '<span class="ph"></span>') +
            '<span><span class="nm">' + esc(o.name) + '</span><span class="tp">' + esc(SING[o.type] || o.type) + '</span></span></a></li>';
        }).join('') + '</ul></div>';
      })() +
      '<p class="enc-article-foot"><a class="enc-random-link" href="#' + randomSlug() + '">Random entry ↻</a></p>';
    document.title = e.name + ' — Encyclopedia — The Epoch Institute';
  }

  var lastIndexScroll = 0;
  function route() {
    var slug = decodeURIComponent(location.hash.slice(1));
    var e = slug && bySlug[slug];
    var idx = document.getElementById('enc-index'), art = document.getElementById('enc-article');
    if (e) {
      if (!idx.hidden) lastIndexScroll = window.scrollY;
      renderArticle(e); idx.hidden = true; art.hidden = false; window.scrollTo(0, 0);
    } else {
      idx.hidden = false; art.hidden = true; document.title = 'Encyclopedia — The Epoch Institute';
      window.scrollTo(0, lastIndexScroll);
    }
  }
  window.addEventListener('hashchange', route);
  chips(); renderIndex(); route();
})();
</script>
</body>
