edia/thumbs/michel-raymond.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Michel Raymond</span><span class="enc-type">Person</span><span class="enc-snip">Michel Raymond was a French soldier of fortune who commanded a large French-trained corps in the service of Nizam Ali Khan of Hyderabad.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/michelangelo"><img class="enc-thumb" src="/images/encyclopedia/thumbs/michelangelo.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Michelangelo</span><span class="enc-type">Person</span><span class="enc-snip">Michelangelo Buonarroti (1475–1564) was a Florentine sculptor, painter, architect and poet, one of the greatest artists of the Italian Renaissance.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/michelin"><img class="enc-thumb" src="/images/encyclopedia/thumbs/michelin.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Michelin</span><span class="enc-type">Institution</span><span class="enc-snip">Michelin is a French tyre manufacturer founded in 1889 by the brothers André and Édouard Michelin in Clermont-Ferrand.</span></a></li><li class="enc-item"><a href="/encyclopedia/micheon-of-goguryeo"><span class="enc-name">Micheon of Goguryeo</span><span class="enc-type">Person</span><span class="enc-snip">Micheon of Goguryeo was the fifteenth king of Goguryeo, reigning from 300 to 331.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/michiel-de-ruyter"><img class="enc-thumb" src="/images/encyclopedia/thumbs/michiel-de-ruyter.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Michiel de Ruyter</span><span class="enc-type">Person</span><span class="enc-snip">Michiel de Ruyter was a Dutch admiral, the most celebrated commander of the Dutch navy.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/michigamea"><img class="enc-thumb" src="/images/encyclopedia/thumbs/michigamea.j