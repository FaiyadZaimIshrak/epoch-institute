<ul class="enc-list"><li class="enc-item"><a href="/encyclopedia/uysyn"><span class="enc-name">Uysyn</span><span class="enc-type">People / group</span><span class="enc-snip">The Uysyn are a tribe of the Senior Jüz of the Kazakhs, living in southern and south-eastern Kazakhstan.</span></a></li><li class="enc-item"><a href="/encyclopedia/uzama"><span class="enc-name">Uzama</span><span class="enc-type">People / group</span><span class="enc-snip">The uzama were the hereditary noble chiefs of the Benin kingdom, who held significant power under the earlier Ogiso system.</span></a></li><li class="enc-item"><a href="/encyclopedia/uzana-i-of-pinya"><span class="enc-name">Uzana I of Pinya</span><span class="enc-type">Person</span><span class="enc-snip">Uzana I was king of Pinya in central Burma from 1325 to 1340, a son of the Pagan king Kyawswa and stepson of Thihathu, founder of Pinya.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/uzbek-khan"><img class="enc-thumb" src="/images/encyclopedia/thumbs/uzbek-khan.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Uzbek Khan</span><span class="enc-type">Person</span><span class="enc-snip">Uzbek Khan was khan of the Golden Horde from 1313 to 1341, the longest reign in its history.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/uzbekistan"><img class="enc-thumb" src="/images/encyclopedia/thumbs/uzbekistan.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Uzbekistan</span><span class="enc-type">Place</span><span class="enc-snip">Uzbekistan is a country in Central Asia covering much of historic Transoxiana, including the cities of Samarkand, Bukhara and Tashkent.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/uzbeks"><img class="enc-thumb" src="/images/encyclopedia/thumbs/uzbeks.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Uzbeks</span><span class="enc-type">People / group</span><span class="enc-snip">The Uzbeks are a Turkic people of Central Asia whose name derives from the nomadic confederation that formed in the fifteenth century.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/uzgen"><img class="enc-thumb" src="/images/encyclopedia/thumbs/uzgen.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Uzgen</span><span class="enc-type">Place</span><span class="enc-snip">Uzgen is a town in the Osh Region of Kyrgyzstan, in the eastern Fergana Valley.</span></a></li><li class="enc-item"><a href="/encyclopedia/uzhhorod"><span class="enc-name">Uzhhorod</span><span class="enc-type">Place</span><span class="enc-snip">Uzhhorod is a city on the Uzh river in western Ukraine, the administrative centre of Zakarpattia Oblast on the border with Slovakia.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/uzice"><img class="enc-thumb" src="/images/encyclopedia/thumbs/uzice.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Užice</span><span class="enc-type">Place</span><span class="enc-snip">Užice is a city in western Serbia on the Đetinja river.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/uzun-hasan"><img class="enc-thumb" src="/images/encyclopedia/thumbs/uzun-hasan.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Uzun Hasan</span><span class="enc-type">Person</span><span class="enc-snip">Uzun Hasan was the ruler of the Aq Qoyunlu Turkmen confederation, who died in 1478.</span></a></li><li class="enc-item"><a href="/encyclopedia/uzun-haji"><span class="enc-name">Uzun-Haji</span><span class="enc-type">Person</span><span class="enc-snip">Uzun-Haji was a Naqshbandi sheikh from Dagestan who opposed Russian rule in the North Caucasus and spent years in exile and prison.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/uzuncaburc"><img class="enc-thumb" src="/images/encyclopedia/thumbs/uzuncaburc.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Uzuncaburç</span><span class="enc-type">Place</span><span class="enc-snip">Uzuncaburç is a village in Mersin Province in southern Turkey, in the hills above Silifke, on the site of the sanctuary town of ancient Olba, later called Diocaesarea.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/uzziah"><img class="enc-thumb" src="/images/encyclopedia/thumbs/uzziah.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Uzziah</span><span class="enc-type">Person</span><span class="enc-snip">Uzziah, also called Azariah, was king of Judah for much of the 8th century BCE.</span></a></li></ul>
