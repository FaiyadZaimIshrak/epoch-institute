<ul class="enc-list"><li class="enc-item has-img"><a href="/encyclopedia/antisuyu"><img class="enc-thumb" src="/images/encyclopedia/thumbs/antisuyu.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Antisuyu</span><span class="enc-type">Place</span><span class="enc-snip">Antisuyu was the north-eastern quarter of the Inca Empire, covering the eastern slopes of the Andes and the edge of the Amazonian forest beyond Cusco.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/antium"><img class="enc-thumb" src="/images/encyclopedia/thumbs/antium.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Antium</span><span class="enc-type">Place</span><span class="enc-snip">Antium was an ancient town on the coast of Latium, at modern Anzio south of Rome.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/antofagasta"><img class="enc-thumb" src="/images/encyclopedia/thumbs/antofagasta.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Antofagasta</span><span class="enc-type">Place</span><span class="enc-snip">Antofagasta is a port city in northern Chile and capital of the Antofagasta Region, on the edge of the Atacama Desert.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/antoine-de-lamothe-cadillac"><img class="enc-thumb" src="/images/encyclopedia/thumbs/antoine-de-lamothe-cadillac.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Antoine de Lamothe Cadillac</span><span class="enc-type">Person</span><span class="enc-snip">Antoine de Lamothe Cadillac was a French adventurer and colonial officer in North America.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/antoine-iii-de-gramont"><img class="enc-thumb" src="/images/encyclopedia/thumbs/antoine-iii-de-gramont.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Antoine III de Gramont</span><span class="enc-type">Person</span><span class="enc-snip">Antoine