lazy" width="56" height="56"><span class="enc-name">Italian Riviera</span><span class="enc-type">Place</span><span class="enc-snip">The Italian Riviera is the coastal strip of Liguria in north-western Italy, between the French border and La Spezia, with Genoa at its centre.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/italian-somaliland"><img class="enc-thumb" src="/images/encyclopedia/thumbs/italian-somaliland.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Italian Somaliland</span><span class="enc-type">Place</span><span class="enc-snip">Italian Somaliland was an Italian colony on the Indian Ocean coast of the Horn of Africa, in present-day Somalia.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/italian-unification"><img class="enc-thumb" src="/images/encyclopedia/thumbs/italian-unification.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Italian unification</span><span class="enc-type">Event</span><span class="enc-snip">Italian unification, or the Risorgimento, was the political process that united the states of the Italian peninsula into a single kingdom, proclaimed in 1861.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/italian-war-of-1499-1504"><img class="enc-thumb" src="/images/encyclopedia/thumbs/italian-war-of-1499-1504.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Italian War of 1499–1504</span><span class="enc-type">War · 1499–1504</span><span class="enc-snip">The Italian War of 1499–1504 was fought by Louis XII of France, who conquered the Duchy of Milan in 1499 and then shared the Kingdom of Naples with Ferdinand of Aragon.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/italian-war-of-1521-1526"><img class="enc-thumb" src="/images/encyclopedia/thumbs/italian-war-of-1521-1526.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Italian War of 1521–1526</span><span class="enc-type">War · 1521–1526</span><span class="enc-snip">The Italian War of 1521–1526 was fought between Francis I of France and Emperor Charles V, allied with Henry VIII of England and the papacy, mainly over the Duchy of…</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/italian-war-of-1551-1559"><img class="enc-thumb" src="/images/encyclopedia/thumbs/italian-war-of-1551-1559.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Italian War of 1551–1559</span><span class="enc-type">War · 1551–1559</span><span class="enc-snip">The Italian War of 1551–1559 was the last of the Italian Wars, fought between Henry II of France and the Habsburgs, Charles V and then Philip II of Spain, with England…</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/italian-wars"><img class="enc-thumb" src="/images/encyclopedia/thumbs/italian-wars.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Italian Wars</span><span class="enc-type">War · 1494–1559</span><span class="enc-snip">The Italian Wars were a series of conflicts between 1494 and 1559 fought mainly between France and Spain, along with other powers, for control of Italy.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/italic-league"><img class="enc-thumb" src="/images/encyclopedia/thumbs/italic-league.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Italic League</span><span class="enc-type">Treaty · Peace · 1454–1455</span><span class="enc-snip">The Italic League was an alliance concluded in 1454–1455 by Venice, Milan and Florence, and joined by the Papacy and the Kingdom of Naples, following the Peace of Lodi.</span></a></li><li class="enc-item has-img"><a href="/encyclopedia/italica"><img class="enc-thumb" src="/images/encyclopedia/thumbs/italica.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Italica</span><span class="enc-type">Place</span><span class="enc-snip">Italica was a Roman city near