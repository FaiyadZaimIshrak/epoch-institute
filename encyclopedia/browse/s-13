item has-img"><a href="/encyclopedia/sheng-shicai"><img class="enc-thumb" src="/images/encyclopedia/sheng-shicai.jpg" alt="" loading="lazy" width="56" height="56"><span class="enc-name">Sheng Shicai</span><span class="enc-type">Person</span><span class="enc-snip">Sheng Shicai was a Chinese warlord who ruled Xinjiang from 1933 to 1944.</span></a></li><li class="enc-item"><a href="/encyclopedia/shengle"><span class="enc-name">Shengle</span><span class="enc-type">Place</span><span class="enc-snip">Shengle was the early centre of the Tuoba Xianbei, near modern Horinger in Inner Mongolia, China.</span></a></li></ul>
