    <section class="rise-fall" id="timeline" aria-labelledby="timeline-title">
      <h2 class="profile-section-title" id="timeline-title">Timeline</h2>
      <ol class="rf-events"><li><span class="rf-year">c. 1400 BCE</span><span class="rf-text">Scribes at Knossos record Mycenaean Greek in the <a class="enc-link" href="/encyclopedia/linear-b">Linear B</a> script</span></li><li><span class="rf-year">c. 750 BCE</span><span class="rf-text">The <a class="enc-link" href="/encyclopedia/greeks">Greeks</a> adapt the Phoenician alphabet, adding letters for vowels</span></li><li><span class="rf-year">c. 700 BCE</span><span class="rf-text">The <a class="enc-link" href="/encyclopedia/iliad">Iliad</a> and the <a class="enc-link" href="/encyclopedia/odyssey">Odyssey</a> take shape, the oldest works of Greek literature</span></li><li><span class="rf-year">403 BCE</span><span class="rf-text"><a class="enc-link" href="/encyclopedia/athens">Athens</a> officially adopts the Ionic alphabet of twenty-four letters</span></li><li><span class="rf-year">334 BCE</span><span class="rf-text"><a class="enc-link" href="/encyclopedia/alexander-the-great">Alexander the Great</a> begins the conquests that carry Greek to <a class="enc-link" href="/encyclopedia/egypt">Egypt</a>, <a class="enc-link" href="/encyclopedia/persia">Persia</a> and <a class="enc-link" href="/encyclopedia/india">India</a></span></li><li><span class="rf-year">3rd century BCE</span><span class="rf-text">The <a class="enc-link" href="/encyclopedia/hebrew">Hebrew</a> scriptures are translated into Greek in <a class="enc-link" href="/encyclopedia/alexandria">Alexandria</a>: the <a class="enc-link" href="/encyclopedia/septuagint">Septuagint</a></span></li><li><span class="rf-year">1397</span><span class="rf-text"><a class="enc-link" href="/encyclopedia/manuel-chrysoloras">Manuel Chrysoloras</a> begins teaching Greek in <a class="enc-link" href="/encyclopedia/florence">Florence</a>, reviving its study in western <a class="enc-link" href="/encyclopedia/europe">Europe</a></span></li><li><span class="rf-year">1976</span><span class="rf-text"><a class="enc-link" href="/encyclopedia/greece">Greece</a> makes Demotic, the popular form of the language, its official language</span></li></ol>
