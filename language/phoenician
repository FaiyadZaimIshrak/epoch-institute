        <h1 class="profile-detail-name">Phoenician</h1>
        <div class="info-stats" style="margin-top:10px;">
          <div class="info-stat"><span class="info-stat-label">Period</span><span class="info-stat-val">c. 1050 BCE – c. 600 CE</span></div>
